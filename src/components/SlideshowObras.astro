---
// src/components/SlideshowObras.astro
// Slideshow de Fotos das Obras (Rio Imagem Baixada & Onco Baixada)
// Padrão Visual Idêntico ao de Cidades e Trajetória: Apenas fotos limpas de ponta a ponta, gradientes e indicadores no topo direito

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const fotosObras = [
  {
    id: 1,
    src: `${baseUrl}/obras/onco-baixada-complexo.webp`,
    alt: "Instituto Estadual de Oncologia da Baixada Fluminense (Onco Baixada)",
    posicao: "object-center sm:object-[center_35%]",
  },
  {
    id: 2,
    src: `${baseUrl}/obras/rio-imagem-fachada.webp`,
    alt: "Fachada oficial do Rio Imagem Baixada às margens da Rodovia Presidente Dutra",
    posicao: "object-center sm:object-[center_35%]",
  },
  {
    id: 3,
    src: `${baseUrl}/obras/rio-imagem-zona-oeste.webp`,
    alt: "Rio Imagem Zona Oeste em Campo Grande — Fachada Moderna e Atendimento de Alta Resolução",
    posicao: "object-center sm:object-[center_40%]",
  },
  {
    id: 4,
    src: `${baseUrl}/obras/rio-imagem-lagos.webp`,
    alt: "Rio Imagem Lagos em Casimiro de Abreu — Centro Regional de Diagnóstico por Imagem",
    posicao: "object-center sm:object-[center_40%]",
  },
  {
    id: 5,
    src: `${baseUrl}/obras/rio-imagem-interno.webp`,
    alt: "Instalações modernas e tecnologia de ponta no interior do Rio Imagem Baixada",
    posicao: "object-center sm:object-[center_40%]",
  },
  {
    id: 6,
    src: `${baseUrl}/obras/hto-baixada.webp`,
    alt: "Centro de Diagnóstico por Imagem e Tomografia de Alta Precisão no HTO Baixada em Nilópolis",
    posicao: "object-center",
  },
  {
    id: 7,
    src: `${baseUrl}/obras/samu-sao-pedro-frota.webp`,
    alt: "Frota de novas ambulâncias do SAMU 100% na Região dos Lagos em São Pedro da Aldeia",
    posicao: "object-center sm:object-[center_45%]",
  },
  {
    id: 8,
    src: `${baseUrl}/obras/hospital-zilda-arns.webp`,
    alt: "Hospital Regional Dra. Zilda Arns em Volta Redonda — Polo de Alta Complexidade no Médio Paraíba",
    posicao: "object-center sm:object-[center_35%]",
  },
];
---

<div id="obras-slideshow" class="relative w-full h-80 sm:h-96 md:h-[460px] lg:h-[520px] overflow-hidden select-none bg-white">
  
  {fotosObras.map((foto, index) => (
    <div
      class={`obras-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${
        index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'
      }`}
      data-index={index}
    >
      <!-- Foto de Ponta a Ponta, do Teto Superior à Base, sem bordas ou molduras -->
      <img
        src={foto.src}
        alt={foto.alt}
        loading={index === 0 ? 'eager' : 'lazy'}
        decoding="async"
        class={`w-full h-full object-cover filter contrast-105 ${foto.posicao}`}
      />
    </div>
  ))}

  <!-- Gradiente sutil no topo para acabamento suave -->
  <div class="absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-black/25 to-transparent pointer-events-none z-10"></div>

  <!-- Gradiente na base fundindo com o fundo branco da seção #entregas (100% branco na base para eliminar qualquer linha) -->
  <div class="absolute inset-x-0 -bottom-2 h-36 sm:h-44 md:h-52 bg-gradient-to-t from-white from-30% via-white/85 to-transparent pointer-events-none z-10"></div>

  <!-- Indicadores de Paginação Discretos no Topo Direito (Completamente afastados do centro e do título) -->
  <div class="absolute top-5 right-5 sm:top-6 sm:right-8 z-20 flex items-center gap-1.5 bg-black/50 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/15 pointer-events-auto shadow-lg">
    {fotosObras.map((_, index) => (
      <button
        type="button"
        class={`obras-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer ${
          index === 0 ? 'w-5 bg-[#F15A29]' : 'w-1.5 bg-white/40 hover:bg-white/70'
        }`}
        data-index={index}
        aria-label={`Foto da obra ${index + 1}`}
      />
    ))}
  </div>

</div>

<!-- Script dedicado do Slideshow de Obras -->
<script>
  function setupObrasSlideshow() {
    const container = document.getElementById('obras-slideshow');
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('.obras-slide');
    const dots = container.querySelectorAll<HTMLElement>('.obras-dot');
    const total = slides.length;
    if (total <= 1) return;

    let current = 0;
    let timer: any = null;

    function show(index: number) {
      current = (index + total) % total;
      slides.forEach((s, idx) => {
        if (idx === current) {
          s.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
          s.classList.add('opacity-100', 'z-10');
        } else {
          s.classList.remove('opacity-100', 'z-10');
          s.classList.add('opacity-0', 'z-0', 'pointer-events-none');
        }
      });

      dots.forEach((d, idx) => {
        if (idx === current) {
          d.className = 'obras-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer w-5 bg-[#F15A29]';
        } else {
          d.className = 'obras-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer w-1.5 bg-white/40 hover:bg-white/70';
        }
      });
    }

    function next() {
      show(current + 1);
    }

    function start() {
      if (timer) clearInterval(timer);
      timer = setInterval(next, 3500);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        show(idx);
        start();
      });
    });

    start();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupObrasSlideshow);
  } else {
    setupObrasSlideshow();
  }
  document.addEventListener('astro:page-load', setupObrasSlideshow);
</script>
