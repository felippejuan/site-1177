---
// src/components/CarrosselMobilizacao.astro
// Foto Editorial de Mobilização Popular com Dr. Luizinho (Estática)
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const foto = {
  src: `${baseUrl}/mob/mob4.webp`,
  fallbackSrc: `${baseUrl}/mob/mob4.jpg`,
  alt: "Dr. Luizinho de braço erguido e criança no colo ovacionado por multidão com bandeiras",
  posicao: "object-center sm:object-[center_35%]",
};
---

<div class="relative w-full h-96 sm:h-[420px] md:h-[480px] lg:h-[540px] overflow-hidden select-none bg-[#071738]">
  <picture class="w-full h-full block">
    <source srcset={foto.src} type="image/webp" />
    <img
      src={foto.fallbackSrc}
      alt={foto.alt}
      loading="lazy"
      decoding="async"
      class={`w-full h-full object-cover filter contrast-[1.04] brightness-[1.02] ${foto.posicao}`}
    />
  </picture>

  <!-- Gradiente sutil no topo para acabamento suave -->
  <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-black/40 to-transparent pointer-events-none z-10"></div>

  <!-- Gradiente na base que funde diretamente com o fundo azul #071738 da seção de mobilização -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#071738]/20 to-[#071738] pointer-events-none z-10"></div>
</div>
