---
// src/components/BuscaMunicipal.astro
// Seção O Que Ele Fez Pela Sua Cidade — Mapa Imersivo com Pop-Up Editorial Boutique
import MapaFluminense from './MapaFluminense.astro';
import { obterTodosMunicipios } from '../data/municipios';

const municipios = obterTodosMunicipios();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="minha-cidade" class="py-20 sm:py-28 bg-[#F8FAFC] relative border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Cabeçalho Editorial -->
    <div class="max-w-3xl mx-auto text-center mb-10">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-orange-100 text-[#F15A29] font-sans text-xs font-bold uppercase tracking-wider mb-4">
        Presença em Todo o Estado
      </span>
      <h2 class="font-display text-3xl sm:text-5xl font-black italic tracking-tight text-[#123F8F] leading-tight mb-4">
        O QUE ELE FEZ PELA <span class="text-[#F15A29]">SUA CIDADE?</span>
      </h2>
      <p class="font-sans text-base sm:text-lg text-slate-600 leading-relaxed">
        Explore o mapa interativo do Rio de Janeiro. Clique em qualquer um dos 92 municípios para abrir o raio-x completo das obras, ambulâncias do SAMU e emendas pagas.
      </p>
    </div>

    <!-- Barra de Busca Flutuante no Topo do Mapa (Estilo Apple / Google Maps) -->
    <div class="max-w-xl mx-auto mb-8">
      <div class="relative bg-white rounded-2xl shadow-lg shadow-slate-200/60 border border-slate-200/90 p-2 sm:p-2.5 flex items-center gap-2">
        <div class="pl-2.5 text-slate-400 flex items-center pointer-events-none">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="busca-municipio-input"
          list="lista-municipios"
          placeholder="Pesquisar cidade (ex: Nova Iguaçu, Volta Redonda...)"
          class="w-full py-2 pr-3 bg-transparent text-slate-900 text-sm sm:text-base font-semibold focus:outline-none placeholder:text-slate-400 placeholder:font-normal"
          autocomplete="off"
        />
        <datalist id="lista-municipios">
          {municipios.map((m) => (
            <option value={m.nome}>{m.regiao}</option>
          ))}
        </datalist>
      </div>

      <!-- Atalhos Rápidos Discretos -->
      <div class="flex items-center justify-center gap-1.5 mt-3 flex-wrap text-xs">
        <span class="text-slate-400 text-[11px] font-medium mr-1">Atalhos rápidos:</span>
        <button type="button" class="btn-cidade px-2.5 py-1 rounded-full bg-white hover:bg-orange-50 hover:text-[#F15A29] hover:border-orange-200 border border-slate-200 text-slate-700 font-semibold cursor-pointer shadow-2xs transition-all" data-cidade="Nova Iguaçu">Nova Iguaçu</button>
        <button type="button" class="btn-cidade px-2.5 py-1 rounded-full bg-white hover:bg-orange-50 hover:text-[#F15A29] hover:border-orange-200 border border-slate-200 text-slate-700 font-semibold cursor-pointer shadow-2xs transition-all" data-cidade="Volta Redonda">Volta Redonda</button>
        <button type="button" class="btn-cidade px-2.5 py-1 rounded-full bg-white hover:bg-orange-50 hover:text-[#F15A29] hover:border-orange-200 border border-slate-200 text-slate-700 font-semibold cursor-pointer shadow-2xs transition-all" data-cidade="Nilópolis">Nilópolis</button>
        <button type="button" class="btn-cidade px-2.5 py-1 rounded-full bg-white hover:bg-orange-50 hover:text-[#F15A29] hover:border-orange-200 border border-slate-200 text-slate-700 font-semibold cursor-pointer shadow-2xs transition-all" data-cidade="Rio de Janeiro">Rio Capital</button>
        <button type="button" class="btn-cidade px-2.5 py-1 rounded-full bg-white hover:bg-orange-50 hover:text-[#F15A29] hover:border-orange-200 border border-slate-200 text-slate-700 font-semibold cursor-pointer shadow-2xs transition-all" data-cidade="Petrópolis">Petrópolis</button>
        <button type="button" class="btn-cidade px-2.5 py-1 rounded-full bg-white hover:bg-orange-50 hover:text-[#F15A29] hover:border-orange-200 border border-slate-200 text-slate-700 font-semibold cursor-pointer shadow-2xs transition-all" data-cidade="Campos dos Goytacazes">Campos</button>
      </div>
    </div>

    <!-- O Mapa Vetorial Fluminense como Centro de Destaque Espaçoso -->
    <div class="max-w-5xl mx-auto bg-white rounded-3xl p-4 sm:p-8 border border-slate-200/90 shadow-2xl shadow-slate-200/60">
      <MapaFluminense />
    </div>

  </div>
</section>

<!-- ======================================================== -->
<!-- POP-UP MODAL EDITORIAL ELEGANTE & SOFISTICADO -->
<!-- ======================================================== -->
<div
  id="modal-cidade"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-cidade-nome"
>
  <!-- Backdrop com Vidro Fosco (Frosted Glass) -->
  <div id="modal-backdrop" class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm transition-opacity duration-300 cursor-pointer"></div>

  <!-- Cartão do Pop-up -->
  <div
    id="modal-card"
    class="relative w-full max-w-xl bg-white rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-100 transform scale-95 transition-all duration-300 max-h-[90vh] overflow-y-auto"
  >
    <!-- Topo: Região e Botão Fechar -->
    <div class="flex items-center justify-between gap-3 mb-4">
      <span id="modal-cidade-regiao" class="px-3.5 py-1 rounded-full bg-blue-50 text-[#123F8F] text-xs font-bold uppercase tracking-wider">
        Baixada Fluminense
      </span>
      <button
        id="modal-btn-close"
        type="button"
        class="w-10 h-10 rounded-full bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-500 hover:text-slate-800 flex items-center justify-center transition-all cursor-pointer shadow-xs"
        aria-label="Fechar detalhes"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Título: Nome da Cidade e Selo SAMU -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4 pb-4 border-b border-slate-100">
      <h3 id="modal-cidade-nome" class="font-display text-3xl sm:text-4xl font-black italic text-[#123F8F] leading-tight">
        Nova Iguaçu
      </h3>
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold self-start sm:self-auto">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>SAMU 100% Garantido</span>
      </div>
    </div>

    <!-- Resumo do Trabalho no Município -->
    <p id="modal-cidade-resumo" class="font-sans text-sm sm:text-base text-slate-700 leading-relaxed mb-6 font-normal">
      Nova Iguaçu é o coração da atuação do Dr. Luizinho. Como secretário municipal e estadual, transformou a cidade na maior potência hospitalar pública da história da Baixada Fluminense.
    </p>

    <!-- Caixas Financeiras de Emendas e Recursos -->
    <div id="modal-emendas-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
      <div class="p-4 rounded-2xl bg-blue-50/70 border border-blue-100">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-1">
          Recursos Já Pagos (Mandato)
        </span>
        <p id="modal-cidade-pagas" class="font-display text-2xl font-black italic text-[#123F8F] leading-tight">
          R$ 20.000.000,00
        </p>
        <span class="text-[10px] text-slate-500">Executados na saúde</span>
      </div>

      <div id="modal-box-garantidas" class="p-4 rounded-2xl bg-orange-50/70 border border-orange-100">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-1">
          Recursos Garantidos / Obras
        </span>
        <p id="modal-cidade-garantidas" class="font-display text-2xl font-black italic text-[#F15A29] leading-tight">
          R$ 5.400.000,00
        </p>
        <span class="text-[10px] text-slate-500">Empenhados e em andamento</span>
      </div>
    </div>

    <!-- Lista de Entregas e Equipamentos -->
    <div class="mb-6">
      <h4 class="font-sans text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
        Entregas e Ações no Município:
      </h4>
      <ul id="modal-cidade-entregas" class="space-y-2.5">
        <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 font-medium">
          <span class="text-emerald-500 font-bold mt-0.5">✓</span>
          <span>Onco Baixada (Instituto Estadual de Oncologia com 100 leitos e 24 boxes de quimioterapia)</span>
        </li>
      </ul>
    </div>

    <!-- Rodapé: Fonte e Botão de Compartilhar no WhatsApp -->
    <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="text-xs text-slate-400 text-center sm:text-left">Fonte: Prestação Oficial e SES-RJ</span>
      <a
        id="modal-cidade-whatsapp"
        href="https://wa.me/?text=Veja%20o%20que%20o%20Dr.%20Luizinho%201177%20fez%20por%20Nova%20Igua%C3%A7u!"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl bg-[#F15A29] hover:bg-[#D94819] text-white font-sans text-sm font-bold shadow-lg shadow-orange-900/20 transition-all hover:scale-105 active:scale-95"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
        </svg>
        <span>Compartilhar cidade no WhatsApp</span>
      </a>
    </div>

  </div>
</div>

<!-- Script do Pop-up e Sincronização com o Mapa -->
<script define:vars={{ municipios, baseUrl }}>
  const input = document.getElementById('busca-municipio-input');
  
  // Elementos do Modal
  const modal = document.getElementById('modal-cidade');
  const modalCard = document.getElementById('modal-card');
  const modalBackdrop = document.getElementById('modal-backdrop');
  const btnClose = document.getElementById('modal-btn-close');

  const nomeEl = document.getElementById('modal-cidade-nome');
  const regiaoEl = document.getElementById('modal-cidade-regiao');
  const resumoEl = document.getElementById('modal-cidade-resumo');
  const pagasEl = document.getElementById('modal-cidade-pagas');
  const garantidasEl = document.getElementById('modal-cidade-garantidas');
  const boxGarantidas = document.getElementById('modal-box-garantidas');
  const entregasEl = document.getElementById('modal-cidade-entregas');
  const shareWa = document.getElementById('modal-cidade-whatsapp');

  function abrirPopUp(cidadeNomeOuSlug) {
    const limpo = cidadeNomeOuSlug.trim().toLowerCase();
    const cidade = municipios.find(m => m.nome.toLowerCase() === limpo || m.slug === limpo);
    if (!cidade) return;

    // Popula dados no Pop-up
    if (nomeEl) nomeEl.textContent = cidade.nome;
    if (regiaoEl) regiaoEl.textContent = cidade.regiao;
    if (resumoEl) resumoEl.textContent = cidade.resumoLocal;

    if (pagasEl) {
      pagasEl.textContent = cidade.emendasPagas || 'Recursos Ordinários SUS';
    }

    if (boxGarantidas && garantidasEl) {
      if (cidade.emendasGarantidas) {
        boxGarantidas.style.display = 'block';
        garantidasEl.textContent = cidade.emendasGarantidas;
      } else {
        boxGarantidas.style.display = 'none';
      }
    }

    if (entregasEl) {
      entregasEl.innerHTML = '';
      cidade.entregasDiretas.forEach(e => {
        const li = document.createElement('li');
        li.className = 'flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 font-medium';
        li.innerHTML = `<span class="text-emerald-500 font-bold mt-0.5">✓</span><span>${e}</span>`;
        entregasEl.appendChild(li);
      });
    }

    if (shareWa) {
      const msg = encodeURIComponent(`Veja o que o Dr. Luizinho 1177 fez por ${cidade.nome}! Acesse: https://felippejuan.github.io/site-1177/#minha-cidade`);
      shareWa.href = `https://wa.me/?text=${msg}`;
    }

    // Sincroniza campo de busca
    if (input && input.value !== cidade.nome) {
      input.value = cidade.nome;
    }

    // Abre o Pop-up com transição suave
    if (modal && modalCard) {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      modalCard.classList.remove('scale-95');
      modalCard.classList.add('scale-100');
      document.body.classList.add('overflow-hidden');
    }
  }

  function fecharPopUp() {
    if (modal && modalCard) {
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalCard.classList.remove('scale-100');
      modalCard.classList.add('scale-95');
      document.body.classList.remove('overflow-hidden');
    }
  }

  // Fechar eventos
  btnClose?.addEventListener('click', fecharPopUp);
  modalBackdrop?.addEventListener('click', fecharPopUp);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') fecharPopUp();
  });

  // Evento disparado ao clicar no mapa
  window.addEventListener('mapa-cidade-selecionada', (e) => {
    const slug = e.detail?.slug;
    const deveAbrir = e.detail?.abrirPopUp ?? true;
    if (slug && deveAbrir) {
      abrirPopUp(slug);
    }
  });

  // Busca inteligente (match exato em input, match parcial em Enter/Change)
  function processarBusca(termo, abrirModal = true) {
    const t = termo.trim().toLowerCase();
    if (!t) return;
    // 1. Busca exata por nome ou slug
    let achado = municipios.find(m => m.nome.toLowerCase() === t || m.slug === t);
    // 2. Se não achou exato, busca por prefixo ou substring
    if (!achado) {
      achado = municipios.find(m => m.nome.toLowerCase().startsWith(t));
    }
    if (!achado) {
      achado = municipios.find(m => m.nome.toLowerCase().includes(t));
    }

    if (achado) {
      if (input) input.value = achado.nome;
      if (abrirModal) abrirPopUp(achado.slug);
      window.dispatchEvent(new CustomEvent('selecionar-cidade-no-mapa', { detail: { slug: achado.slug, abrirPopUp: false } }));
    }
  }

  if (input) {
    // Quando o usuário seleciona uma sugestão da datalist ou digita o nome completo
    input.addEventListener('input', (e) => {
      const valor = e.target.value.trim().toLowerCase();
      // Apenas dispara automaticamente se for match exato com o nome do município (ex: clicou na datalist)
      const achadoExato = municipios.find(m => m.nome.toLowerCase() === valor);
      if (achadoExato) {
        processarBusca(valor, true);
      }
    });

    input.addEventListener('change', (e) => {
      processarBusca(e.target.value, true);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        processarBusca(input.value, true);
      }
    });
  }

  // Evento vindo dos botões rápidos
  document.querySelectorAll('.btn-cidade').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cidade = btn.getAttribute('data-cidade');
      if (cidade) {
        processarBusca(cidade, true);
      }
    });
  });
</script>
