---
// src/components/BuscaMunicipal.astro
// Seção O Que Ele Fez Pela Sua Cidade — Mapa Imersivo com Pop-Up Editorial Boutique
import MapaFluminense from './MapaFluminense.astro';
import { obterTodosMunicipios } from '../data/municipios';

const municipios = obterTodosMunicipios();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
// Atalhos rápidos para cidades estratégicas (6 cidades)
const ATALHOS_CIDADES = [
  { nome: 'Nova Iguaçu', slug: 'nova-iguacu', label: 'Nova Iguaçu' },
  { nome: 'Rio de Janeiro', slug: 'rio-de-janeiro', label: 'Rio Capital' },
  { nome: 'Duque de Caxias', slug: 'duque-de-caxias', label: 'Duque de Caxias' },
  { nome: 'Belford Roxo', slug: 'belford-roxo', label: 'Belford Roxo' },
  { nome: 'Volta Redonda', slug: 'volta-redonda', label: 'Volta Redonda' },
  { nome: 'Campos dos Goytacazes', slug: 'campos-dos-goytacazes', label: 'Campos' },
];

const fotosCidade = [
  {
    id: 1,
    src: `${baseUrl}/suacidade/1.webp`,
    alt: "Dr. Luizinho abraçando morador nas ruas do Estado do Rio de Janeiro",
  },
  {
    id: 2,
    src: `${baseUrl}/suacidade/2.webp`,
    alt: "Dr. Luizinho em meio ao carinho e acolhimento da população",
  },
  {
    id: 3,
    src: `${baseUrl}/suacidade/3.webp`,
    alt: "Dr. Luizinho em interação afetuosa com criança na comunidade",
  },
  {
    id: 4,
    src: `${baseUrl}/suacidade/4.webp`,
    alt: "Dr. Luizinho conversando com família e criança nas cidades do Rio",
  },
  {
    id: 5,
    src: `${baseUrl}/suacidade/5.webp`,
    alt: "Dr. Luizinho em abraço emocionado com morador",
  },
  {
    id: 6,
    src: `${baseUrl}/suacidade/6.webp`,
    alt: "Dr. Luizinho recebendo o carinho caloroso de senhora da comunidade",
  },
  {
    id: 7,
    src: `${baseUrl}/suacidade/7.webp`,
    alt: "Dr. Luizinho em momento de celebração e selfie com moradores",
  },
  {
    id: 8,
    src: `${baseUrl}/suacidade/8.webp`,
    alt: "Dr. Luizinho cumprimentando trabalhadora no comércio local fluminense",
  },
  {
    id: 9,
    src: `${baseUrl}/suacidade/9.webp`,
    alt: "Dr. Luizinho caminhando ao lado do povo fluminense nas cidades do interior e Baixada",
  },
];
---

<section id="minha-cidade" class="relative bg-[#071738] text-white overflow-hidden pb-12 sm:pb-16 md:pb-20 border-b border-slate-900">
  
  <!-- Topo: Slideshow de Fotos nas Cidades Fluminenses (Ocupando Toda a Largura de Ponta a Ponta e Teto Superior) -->
  <div id="suacidade-slideshow" class="relative w-full h-80 sm:h-96 md:h-[460px] lg:h-[520px] overflow-hidden select-none bg-[#071738]">
    
    {fotosCidade.map((foto, index) => (
      <div
        class={`suacidade-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${
          index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'
        }`}
        data-index={index}
      >
        <!-- Foto de Ponta a Ponta, do Teto Superior à Base, sem bordas ou molduras -->
        <img
          src={foto.src}
          alt={foto.alt}
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
          class="w-full h-full object-cover object-[center_25%] sm:object-[center_30%] filter contrast-105"
        />
      </div>
    ))}

    <!-- Gradiente sutil no topo para acabamento suave -->
    <div class="absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-black/25 to-transparent pointer-events-none z-10"></div>

    <!-- Gradiente na base que começa mais embaixo para revelar muito mais a foto -->
    <div class="absolute inset-x-0 bottom-0 h-24 sm:h-32 md:h-40 bg-gradient-to-t from-[#071738] via-[#071738]/85 to-transparent pointer-events-none z-10"></div>

    <!-- Indicadores de Paginação Discretos no Topo Direito (Completamente afastados do centro e do título) -->
    <div class="absolute top-5 right-5 sm:top-6 sm:right-8 z-20 flex items-center gap-1.5 bg-black/50 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/15 pointer-events-auto shadow-lg">
      {fotosCidade.map((_, index) => (
        <button
          type="button"
          class={`suacidade-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer ${
            index === 0 ? 'w-5 bg-[#F15A29]' : 'w-1.5 bg-white/40 hover:bg-white/70'
          }`}
          data-index={index}
          aria-label={`Foto ${index + 1}`}
        />
      ))}
    </div>

  </div>

  <!-- Conteúdo Central: Título Sobreposto + Barra de Busca + Atalhos -->
  <div class="max-w-4xl mx-auto px-4 text-center mb-5 sm:mb-6 -mt-8 sm:-mt-10 md:-mt-12 relative z-20">
    
    <!-- Cabeçalho Editorial Sobreposto -->
    <h2 class="font-display text-3xl sm:text-5xl md:text-6xl font-black italic tracking-tight leading-tight mb-2.5 drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)]">
      <span class="text-white">VEJA O QUE ELE FEZ</span> <br />
      <span class="text-[#F15A29]">PELAS NOSSAS CIDADES</span>
    </h2>
    <p class="font-sans text-sm sm:text-base text-blue-100 font-medium mb-5 max-w-2xl mx-auto leading-relaxed">
      Digite ou selecione o nome da sua cidade para conhecer as entregas e os recursos investidos pelo Doutor Luizinho.
    </p>

    <!-- Barra de Busca Centralizada com Dropdown Inteligente Customizado -->
    <div id="container-busca-municipio" class="max-w-md mx-auto relative z-30">
      <div class="bg-white rounded-2xl shadow-xl shadow-black/30 border border-white/20 p-1.5 sm:p-2 flex items-center gap-2 focus-within:ring-2 focus-within:ring-[#F15A29]/60 transition-all">
        <div class="pl-2 text-slate-400 flex items-center pointer-events-none shrink-0">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="busca-municipio-input"
          placeholder="Digite sua cidade (ex: Nova Iguaçu, Volta Redonda...)"
          class="w-full py-2 pr-2 bg-transparent text-slate-900 text-base sm:text-sm font-semibold focus:outline-none placeholder:text-slate-400 placeholder:font-normal"
          autocomplete="off"
          enterkeyhint="search"
        />
        <button
          id="btn-limpar-busca"
          type="button"
          class="hidden p-1.5 rounded-full hover:bg-slate-100 text-slate-400 hover:text-slate-700 transition-colors cursor-pointer shrink-0"
          aria-label="Limpar busca"
          title="Limpar busca"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Dropdown Customizado de Municípios (Abre no primeiro clique, sem sumir) -->
      <div
        id="dropdown-municipios"
        class="hidden absolute top-full left-0 right-0 mt-2 bg-white rounded-2xl shadow-2xl shadow-black/40 border border-slate-200/90 overflow-hidden z-50 text-slate-900 text-left transition-all"
      >
        <div class="px-3.5 py-2 bg-slate-50 border-b border-slate-100 flex items-center justify-between text-[11px] font-bold text-slate-500 uppercase tracking-wider select-none">
          <span>Selecione seu município</span>
          <span class="text-[#F15A29]">{municipios.length} cidades do RJ</span>
        </div>
        <ul id="dropdown-lista" class="max-h-64 sm:max-h-72 overflow-y-auto divide-y divide-slate-50">
        </ul>
      </div>
    </div>

    <!-- Atalhos para Cidades Estratégicas em Vidro Translúcido -->
    <div class="mt-4 flex items-center justify-center gap-1.5 sm:gap-2 flex-wrap">
      {ATALHOS_CIDADES.map((c) => (
        <button
          type="button"
          class="btn-atalho-cidade inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/15 hover:border-[#F15A29] shadow-sm text-xs sm:text-sm font-semibold text-white hover:text-[#F15A29] transition-all cursor-pointer group active:scale-95 backdrop-blur-md"
          data-cidade={c.nome}
          data-slug={c.slug}
          title={`Ver entregas em ${c.nome}`}
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#F15A29] group-hover:scale-125 transition-transform"></span>
          <span>{c.label}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- O Mapa Vetorial Fluminense Expandido de Canto a Canto (Com leve respiro nas bordas) -->
  <div class="w-full max-w-[1600px] 2xl:max-w-[1800px] mx-auto px-1 sm:px-2.5 md:px-4 lg:px-6 relative flex items-center justify-center mt-1 sm:mt-3 z-20">
    <MapaFluminense />
  </div>
</section>

<!-- ======================================================== -->
<!-- POP-UP MODAL EDITORIAL ELEGANTE & SOFISTICADO -->
<!-- ======================================================== -->
<div
  id="modal-cidade"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-cidade-nome"
>
  <!-- Backdrop com Vidro Fosco (Frosted Glass) -->
  <div id="modal-backdrop" class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm transition-opacity duration-300 cursor-pointer"></div>

  <!-- Cartão do Pop-up -->
  <div
    id="modal-card"
    class="relative w-full max-w-xl bg-white rounded-3xl p-5 sm:p-8 shadow-2xl border border-slate-100 transform scale-95 transition-all duration-300 max-h-[90vh] overflow-y-auto"
  >
    <!-- Topo: Botão Fechar -->
    <div class="flex items-center justify-end mb-1">
      <button
        id="modal-btn-close"
        type="button"
        class="w-10 h-10 rounded-full bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-500 hover:text-slate-800 flex items-center justify-center transition-all cursor-pointer shadow-xs"
        aria-label="Fechar detalhes"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Título: Nome da Cidade e Selo SAMU -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4 pb-4 border-b border-slate-100">
      <h3 id="modal-cidade-nome" class="font-display text-3xl sm:text-4xl font-black italic text-[#123F8F] leading-tight">
        Nova Iguaçu
      </h3>
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold self-start sm:self-auto">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>SAMU 100% Garantido</span>
      </div>
    </div>

    <!-- Resumo do Trabalho no Município -->
    <p id="modal-cidade-resumo" class="font-sans text-[15px] sm:text-base text-slate-800 leading-relaxed mb-6 font-medium">
      Nova Iguaçu é uma referência histórica na trajetória do Dr. Luizinho. Como secretário municipal e estadual, transformou a rede de saúde em polo de atendimento e excelência para todo o Estado.
    </p>

    <!-- Caixas Financeiras de Recursos -->
    <div id="modal-emendas-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
      <div id="modal-box-1" class="p-4 rounded-2xl bg-blue-50/70 border border-blue-100">
        <span id="modal-box-1-label" class="text-xs font-bold text-slate-600 uppercase tracking-wider block mb-1">
          Recursos Destinados ao Município
        </span>
        <p id="modal-cidade-pagas" class="font-display text-2xl sm:text-3xl font-black italic text-[#123F8F] leading-tight">
          R$ 73.750.000,00
        </p>
        <span id="modal-box-1-sub" class="text-xs text-slate-600 font-medium">Investidos na saúde municipal</span>
      </div>

      <div id="modal-box-garantidas" class="p-4 rounded-2xl bg-orange-50/70 border border-orange-100">
        <span id="modal-box-2-label" class="text-xs font-bold text-slate-600 uppercase tracking-wider block mb-1">
          Recursos Garantidos / Obras
        </span>
        <p id="modal-cidade-garantidas" class="font-display text-2xl sm:text-3xl font-black italic text-[#F15A29] leading-tight">
          R$ 38.000.000,00
        </p>
        <span id="modal-box-2-sub" class="text-xs text-slate-600 font-medium">Investimentos em andamento</span>
      </div>
    </div>

    <!-- Lista de Entregas e Equipamentos -->
    <div class="mb-6">
      <div class="mb-3">
        <h4 id="modal-cidade-entregas-titulo" class="font-sans text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-700 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#123F8F]"></span>
          <span>Entregas que atendem o município:</span>
        </h4>
      </div>
      <ul id="modal-cidade-entregas" class="space-y-2.5">
        <li class="p-3 sm:p-3.5 rounded-2xl bg-slate-50/90 border border-slate-200/70 flex items-start gap-3 sm:gap-3.5">
          <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5 border border-emerald-500/20 shadow-2xs">
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <h5 class="font-sans font-bold text-slate-900 text-sm sm:text-base leading-snug">Onco Baixada</h5>
            <p class="font-sans text-xs sm:text-[13px] text-slate-600 font-normal leading-relaxed mt-0.5">Instituto Estadual de Oncologia com 100 leitos e 24 boxes de quimioterapia</p>
          </div>
        </li>
      </ul>
    </div>

    <!-- Rodapé: Botão de Compartilhar no WhatsApp -->
    <div class="pt-4 border-t border-slate-100 flex items-center justify-center">
      <a
        id="modal-cidade-whatsapp"
        href="https://api.whatsapp.com/send?text=Veja%20o%20que%20o%20Dr.%20Luizinho%201177%20fez%20pela%20sa%C3%BAde%20do%20Rio!%20Acesse%3A%20https%3A%2F%2Fdoutorluizinho.com.br%2F%23minha-cidade"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-2xl bg-[#25D366] hover:bg-[#20bd5a] text-white font-sans text-sm sm:text-base font-bold shadow-lg shadow-emerald-950/20 transition-all hover:scale-105 active:scale-95"
      >
        <svg class="w-6 h-6 fill-current shrink-0" viewBox="5.5 5.5 13 13">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
        </svg>
        <span>Compartilhar pelo WhatsApp</span>
      </a>
    </div>

  </div>
</div>

<!-- Script do Pop-up e Sincronização com o Mapa -->
<script define:vars={{ municipios, baseUrl }}>
  const input = document.getElementById('busca-municipio-input');
  const containerBusca = document.getElementById('container-busca-municipio');
  const dropdown = document.getElementById('dropdown-municipios');
  const dropdownLista = document.getElementById('dropdown-lista');
  const btnLimpar = document.getElementById('btn-limpar-busca');
  
  // Elementos do Modal
  const modal = document.getElementById('modal-cidade');
  const modalCard = document.getElementById('modal-card');
  const modalBackdrop = document.getElementById('modal-backdrop');
  const btnClose = document.getElementById('modal-btn-close');

  const nomeEl = document.getElementById('modal-cidade-nome');
  const resumoEl = document.getElementById('modal-cidade-resumo');
  const pagasEl = document.getElementById('modal-cidade-pagas');
  const garantidasEl = document.getElementById('modal-cidade-garantidas');
  const boxGarantidas = document.getElementById('modal-box-garantidas');
  const entregasTituloEl = document.getElementById('modal-cidade-entregas-titulo');
  const entregasEl = document.getElementById('modal-cidade-entregas');
  const shareWa = document.getElementById('modal-cidade-whatsapp');
  const box1Label = document.getElementById('modal-box-1-label');
  const box1Sub = document.getElementById('modal-box-1-sub');
  const box2Label = document.getElementById('modal-box-2-label');
  const box2Sub = document.getElementById('modal-box-2-sub');

  function abrirPopUp(cidadeNomeOuSlug) {
    const limpo = cidadeNomeOuSlug.trim().toLowerCase();
    const cidade = municipios.find(m => m.nome.toLowerCase() === limpo || m.slug === limpo);
    if (!cidade) return;

    // Popula dados no Pop-up
    if (nomeEl) nomeEl.textContent = cidade.nome;
    if (resumoEl) resumoEl.textContent = cidade.resumoLocal;
    if (entregasTituloEl) {
      entregasTituloEl.innerHTML = '';
      const dot = document.createElement('span');
      dot.className = 'w-2 h-2 rounded-full bg-[#123F8F]';
      const label = document.createElement('span');
      label.textContent = `Entregas que atendem ${cidade.nome}:`;
      entregasTituloEl.appendChild(dot);
      entregasTituloEl.appendChild(label);
    }

    if (cidade.emendasPagas) {
      if (box1Label) box1Label.textContent = `Recursos Destinados a ${cidade.nome}`;
      if (pagasEl) pagasEl.textContent = cidade.emendasPagas;
      if (box1Sub) box1Sub.textContent = 'Valores aplicados na saúde do município';

      if (cidade.emendasGarantidas) {
        if (boxGarantidas) boxGarantidas.style.display = 'block';
        if (box2Label) box2Label.textContent = 'Recursos Garantidos / Obras';
        if (garantidasEl) garantidasEl.textContent = cidade.emendasGarantidas;
        if (box2Sub) box2Sub.textContent = 'Investimentos em andamento';
      } else {
        if (boxGarantidas) boxGarantidas.style.display = 'block';
        if (box2Label) box2Label.textContent = 'Regulação & Alta Complexidade';
        if (garantidasEl) garantidasEl.textContent = 'Rede Integrada';
        if (box2Sub) box2Sub.textContent = 'Acesso direto via CIS';
      }
    } else {
      // Municípios sem repasse orçamentário individual direto: destaque de liderança para o SAMU 100% e o CIS
      if (box1Label) box1Label.textContent = 'Socorro Móvel Pré-Hospitalar';
      if (pagasEl) pagasEl.textContent = 'SAMU 100% RJ';
      if (box1Sub) box1Sub.textContent = 'Ambulância nova com custeio garantido';

      if (boxGarantidas) boxGarantidas.style.display = 'block';
      if (box2Label) box2Label.textContent = 'Regulação Ágil de Urgência';
      if (garantidasEl) garantidasEl.textContent = '-38,4% Espera';
      if (box2Sub) box2Sub.textContent = 'Leitos monitorados em tempo real no CIS';
    }

    if (entregasEl) {
      entregasEl.innerHTML = '';
      cidade.entregasDiretas.forEach(e => {
        let titulo = e;
        let descricao = '';

        if (e.includes(':')) {
          const idx = e.indexOf(':');
          titulo = e.substring(0, idx).trim();
          descricao = e.substring(idx + 1).trim();
        } else if (e.includes('(') && e.includes(')')) {
          const m = e.match(/^([^(]+)\(([^)]+)\)(.*)$/);
          if (m) {
            titulo = m[1].trim();
            descricao = (m[2] + (m[3] ? ' ' + m[3] : '')).replace(/^:\s*/, '').trim();
          }
        }

        const li = document.createElement('li');
        li.className = 'group p-3 sm:p-3.5 rounded-2xl bg-slate-50/90 hover:bg-slate-100/70 border border-slate-200/70 transition-all flex items-start gap-3 sm:gap-3.5';

        const iconContainer = document.createElement('div');
        iconContainer.className = 'w-6 h-6 sm:w-7 sm:h-7 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5 border border-emerald-500/20 shadow-2xs';
        iconContainer.innerHTML = '<svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>';

        const textContainer = document.createElement('div');
        textContainer.className = 'flex-1 min-w-0';

        const h5 = document.createElement('h5');
        h5.className = 'font-sans font-bold text-slate-900 text-sm sm:text-base leading-snug';
        h5.textContent = titulo;
        textContainer.appendChild(h5);

        if (descricao) {
          const p = document.createElement('p');
          p.className = 'font-sans text-xs sm:text-[13px] text-slate-600 font-normal leading-relaxed mt-0.5';
          p.textContent = descricao;
          textContainer.appendChild(p);
        }

        li.appendChild(iconContainer);
        li.appendChild(textContainer);
        entregasEl.appendChild(li);
      });
    }

    if (shareWa) {
      let texto = `🏥 *O que o Dr. Luizinho fez por ${cidade.nome} (1177)*\n\n`;
      if (cidade.emendasPagas) {
        texto += `💰 *Recursos Destinados à Saúde:* ${cidade.emendasPagas}\n`;
      }
      if (cidade.emendasGarantidas) {
        texto += `🏗️ *Recursos Garantidos / Obras:* ${cidade.emendasGarantidas}\n`;
      }
      if (cidade.entregasDiretas && cidade.entregasDiretas.length > 0) {
        texto += `\n📍 *Principais Entregas:*\n`;
        cidade.entregasDiretas.slice(0, 4).forEach(e => {
          let tit = e;
          let desc = '';
          if (e.includes(':')) {
            const idx = e.indexOf(':');
            tit = e.substring(0, idx).trim();
            desc = e.substring(idx + 1).trim();
          } else if (e.includes('(') && e.includes(')')) {
            const m = e.match(/^([^(]+)\(([^)]+)\)(.*)$/);
            if (m) {
              tit = m[1].trim();
              desc = (m[2] + (m[3] ? ' ' + m[3] : '')).replace(/^:\s*/, '').trim();
            }
          }
          if (desc) {
            texto += `• *${tit}:* ${desc}\n`;
          } else {
            texto += `• *${tit}*\n`;
          }
        });
      }
      texto += `\n👉 *Veja o painel interativo de ${cidade.nome}:*\nhttps://doutorluizinho.com.br/#minha-cidade`;

      shareWa.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(texto)}`;
    }

    // Sincroniza campo de busca
    if (input && input.value !== cidade.nome) {
      input.value = cidade.nome;
      if (btnLimpar) btnLimpar.classList.remove('hidden');
    }

    // Abre o Pop-up com transição suave
    if (modal && modalCard) {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      modalCard.classList.remove('scale-95');
      modalCard.classList.add('scale-100');
      document.body.classList.add('overflow-hidden');
    }
  }

  function fecharPopUp() {
    if (modal && modalCard) {
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalCard.classList.remove('scale-100');
      modalCard.classList.add('scale-95');
      document.body.classList.remove('overflow-hidden');
    }
  }

  // Fechar eventos
  btnClose?.addEventListener('click', fecharPopUp);
  modalBackdrop?.addEventListener('click', fecharPopUp);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') fecharPopUp();
  });

  // Evento disparado ao clicar no mapa
  window.addEventListener('mapa-cidade-selecionada', (e) => {
    const slug = e.detail?.slug;
    const deveAbrir = e.detail?.abrirPopUp ?? true;
    if (slug && deveAbrir) {
      abrirPopUp(slug);
    }
  });

  // ========================================================
  // DROPDOWN INTELIGENTE & AUTOCOMPLETE CUSTOMIZADO
  // ========================================================
  let itemAtivoIndex = -1;
  let itensFiltrados = [...municipios];

  function normalizar(str) {
    return (str || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function renderizarDropdown(lista) {
    if (!dropdownLista) return;
    dropdownLista.innerHTML = '';
    itensFiltrados = lista;
    itemAtivoIndex = -1;

    if (lista.length === 0) {
      const li = document.createElement('li');
      li.className = 'px-4 py-3 text-xs sm:text-sm text-slate-500 text-center italic select-none';
      li.textContent = 'Nenhum município encontrado com esse nome.';
      dropdownLista.appendChild(li);
      return;
    }

    lista.forEach((m, idx) => {
      const li = document.createElement('li');
      li.className = 'item-municipio-dropdown px-3.5 py-2.5 hover:bg-orange-50/90 cursor-pointer flex items-center justify-between transition-colors group select-none border-b border-slate-50 last:border-b-0';
      li.setAttribute('data-slug', m.slug);
      li.setAttribute('data-nome', m.nome);
      li.setAttribute('data-index', String(idx));

      const leftWrap = document.createElement('div');
      leftWrap.className = 'flex items-center gap-2 truncate';

      const dot = document.createElement('span');
      dot.className = 'w-1.5 h-1.5 rounded-full bg-slate-300 group-hover:bg-[#F15A29] transition-colors shrink-0';

      const nameSpan = document.createElement('span');
      nameSpan.className = 'font-sans font-semibold text-slate-800 group-hover:text-[#F15A29] text-xs sm:text-sm truncate';
      nameSpan.textContent = m.nome;

      leftWrap.appendChild(dot);
      leftWrap.appendChild(nameSpan);

      const tagSpan = document.createElement('span');
      if (m.destaques && m.destaques[0]) {
        tagSpan.className = 'text-[11px] font-bold text-slate-500 group-hover:text-[#F15A29] bg-slate-100 group-hover:bg-orange-100/80 px-2 py-0.5 rounded-full transition-colors shrink-0 ml-2';
        tagSpan.textContent = m.destaques[0];
      } else {
        tagSpan.className = 'text-[11px] font-medium text-slate-400 group-hover:text-slate-600 shrink-0 ml-2';
        tagSpan.textContent = m.regiao || 'Rio de Janeiro';
      }

      li.appendChild(leftWrap);
      li.appendChild(tagSpan);

      li.addEventListener('mousedown', (e) => {
        e.preventDefault();
        selecionarMunicipio(m);
      });

      dropdownLista.appendChild(li);
    });
  }

  function abrirDropdown() {
    if (!dropdown) return;
    filtrarDropdown(input ? input.value : '');
    dropdown.classList.remove('hidden');
  }

  function fecharDropdown() {
    if (!dropdown) return;
    dropdown.classList.add('hidden');
    itemAtivoIndex = -1;
  }

  function selecionarMunicipio(m) {
    if (!m) return;
    if (input) input.value = m.nome;
    if (btnLimpar) btnLimpar.classList.remove('hidden');
    fecharDropdown();
    abrirPopUp(m.slug);
    window.dispatchEvent(new CustomEvent('selecionar-cidade-no-mapa', { detail: { slug: m.slug, abrirPopUp: false } }));
  }

  function filtrarDropdown(termo) {
    const t = normalizar(termo);
    if (!t) {
      renderizarDropdown(municipios);
    } else {
      const filtrados = municipios.filter(m => {
        const nomeNorm = normalizar(m.nome);
        const slugNorm = normalizar(m.slug);
        const regiaoNorm = normalizar(m.regiao || '');
        return nomeNorm.includes(t) || slugNorm.includes(t) || regiaoNorm.includes(t);
      });
      renderizarDropdown(filtrados);
    }
  }

  function atualizarItemAtivo(novoIndex) {
    const itens = dropdownLista?.querySelectorAll('.item-municipio-dropdown');
    if (!itens || itens.length === 0) return;

    if (itemAtivoIndex >= 0 && itemAtivoIndex < itens.length) {
      itens[itemAtivoIndex].classList.remove('bg-orange-50', 'text-[#F15A29]');
    }

    itemAtivoIndex = Math.max(0, Math.min(novoIndex, itens.length - 1));
    const ativo = itens[itemAtivoIndex];
    if (ativo) {
      ativo.classList.add('bg-orange-50', 'text-[#F15A29]');
      ativo.scrollIntoView({ block: 'nearest' });
    }
  }

  if (input) {
    // Abre a lista no primeiro clique ou foco
    input.addEventListener('focus', () => {
      abrirDropdown();
    });

    input.addEventListener('click', (e) => {
      e.stopPropagation();
      abrirDropdown();
    });

    input.addEventListener('input', (e) => {
      const valor = e.target.value;
      if (btnLimpar) {
        if (valor.length > 0) btnLimpar.classList.remove('hidden');
        else btnLimpar.classList.add('hidden');
      }
      abrirDropdown();
    });

    input.addEventListener('keydown', (e) => {
      const isOpen = dropdown && !dropdown.classList.contains('hidden');

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (!isOpen) {
          abrirDropdown();
        } else {
          atualizarItemAtivo(itemAtivoIndex + 1);
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (isOpen) {
          atualizarItemAtivo(itemAtivoIndex - 1);
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (isOpen && itemAtivoIndex >= 0 && itensFiltrados[itemAtivoIndex]) {
          selecionarMunicipio(itensFiltrados[itemAtivoIndex]);
        } else if (itensFiltrados.length > 0) {
          selecionarMunicipio(itensFiltrados[0]);
        } else {
          fecharDropdown();
        }
      } else if (e.key === 'Escape') {
        fecharDropdown();
      }
    });
  }

  // Botão limpar busca (X)
  btnLimpar?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (input) {
      input.value = '';
      input.focus();
    }
    btnLimpar.classList.add('hidden');
    abrirDropdown();
  });

  // Fechar dropdown ao clicar fora
  document.addEventListener('click', (e) => {
    if (containerBusca && !containerBusca.contains(e.target)) {
      fecharDropdown();
    }
  });

  // Atalhos rápidos para os polos com mais investimentos
  document.querySelectorAll('.btn-atalho-cidade').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-slug');
      const cidade = btn.getAttribute('data-cidade');
      if (slug) {
        if (input) input.value = cidade || '';
        abrirPopUp(slug);
        window.dispatchEvent(new CustomEvent('selecionar-cidade-no-mapa', { detail: { slug, abrirPopUp: false } }));
      }
    });
  });
</script>

<!-- Script dedicado do Slideshow de Cidades -->
<script>
  function setupSuaCidadeSlideshow() {
    const container = document.getElementById('suacidade-slideshow');
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('.suacidade-slide');
    const dots = container.querySelectorAll<HTMLElement>('.suacidade-dot');
    const total = slides.length;
    if (total <= 1) return;

    let current = 0;
    let timer: any = null;

    function show(index: number) {
      current = (index + total) % total;
      slides.forEach((s, idx) => {
        if (idx === current) {
          s.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
          s.classList.add('opacity-100', 'z-10');
        } else {
          s.classList.remove('opacity-100', 'z-10');
          s.classList.add('opacity-0', 'z-0', 'pointer-events-none');
        }
      });

      dots.forEach((d, idx) => {
        if (idx === current) {
          d.className = 'suacidade-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer w-5 bg-[#F15A29]';
        } else {
          d.className = 'suacidade-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer w-1.5 bg-white/40 hover:bg-white/70';
        }
      });
    }

    function next() {
      show(current + 1);
    }

    function start() {
      if (timer) clearInterval(timer);
      timer = setInterval(next, 3500);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        show(idx);
        start();
      });
    });

    start();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSuaCidadeSlideshow);
  } else {
    setupSuaCidadeSlideshow();
  }
  document.addEventListener('astro:page-load', setupSuaCidadeSlideshow);
</script>
