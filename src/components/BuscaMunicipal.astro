---
// src/components/BuscaMunicipal.astro
// Cockpit Territorial do Rio de Janeiro — Mapa Vetorial Interativo + Busca Inteligente (Padrão Editorial Nikolas Ferreira)
import MapaFluminense from './MapaFluminense.astro';
import { obterTodosMunicipios } from '../data/municipios';

const municipios = obterTodosMunicipios();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="minha-cidade" class="py-20 sm:py-28 bg-[#F8FAFC] relative border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Cabeçalho Editorial -->
    <div class="max-w-3xl mx-auto text-center mb-12">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-orange-100 text-[#F15A29] font-sans text-xs font-bold uppercase tracking-wider mb-4">
        Presença em Todo o Estado
      </span>
      <h2 class="font-display text-3xl sm:text-5xl font-black italic tracking-tight text-[#123F8F] leading-tight mb-4">
        O QUE ELE FEZ PELA <span class="text-[#F15A29]">SUA CIDADE?</span>
      </h2>
      <p class="font-sans text-base sm:text-lg text-slate-600 leading-relaxed">
        Explore o mapa interativo dos 92 municípios do Rio de Janeiro ou digite a sua cidade para consultar as ambulâncias do SAMU, emendas pagas e obras hospitalares entregues.
      </p>
    </div>

    <!-- Mini-Painel de Métricas Consolidadas (Estilo Dashboard de Alto Impacto) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-10 max-w-6xl mx-auto">
      <div class="p-4 sm:p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex flex-col justify-between">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Cobertura Territorial</span>
        <div class="font-display text-2xl sm:text-3xl font-black italic text-[#123F8F] my-1">92 / 92</div>
        <span class="text-xs font-medium text-slate-600">Municípios Atendidos</span>
      </div>

      <div class="p-4 sm:p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex flex-col justify-between">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Urgência e Emergência</span>
        <div class="font-display text-2xl sm:text-3xl font-black italic text-emerald-600 my-1">100% RJ</div>
        <span class="text-xs font-medium text-slate-600">SAMU Universalizado</span>
      </div>

      <div class="p-4 sm:p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex flex-col justify-between">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Recursos Destravados</span>
        <div class="font-display text-2xl sm:text-3xl font-black italic text-[#F15A29] my-1">R$ 800M+</div>
        <span class="text-xs font-medium text-slate-600">Viabilizados na Saúde</span>
      </div>

      <div class="p-4 sm:p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex flex-col justify-between">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Estrutura Hospitalar</span>
        <div class="font-display text-2xl sm:text-3xl font-black italic text-[#123F8F] my-1">16 Obras</div>
        <span class="text-xs font-medium text-slate-600">Hospitais e Centros</span>
      </div>
    </div>

    <!-- Cockpit Territorial Dividido: Mapa Interativo (7 colunas) + Ficha da Cidade (5 colunas) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-7xl mx-auto">
      
      <!-- Coluna Esquerda: Mapa Vetorial dos 92 Municípios Fluminenses (7 colunas) -->
      <div class="lg:col-span-7">
        <MapaFluminense />
      </div>

      <!-- Coluna Direita: Campo de Busca Rápida + Ficha Dinâmica da Cidade (5 colunas) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Campo de Busca com Autocomplete e Ícone -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/90 shadow-sm">
          <label for="busca-municipio-input" class="block text-xs font-bold text-[#123F8F] uppercase tracking-wider mb-2">
            Pesquisar Cidade
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input
              type="text"
              id="busca-municipio-input"
              list="lista-municipios"
              value="Nova Iguaçu"
              placeholder="Digite o nome da cidade (ex: Nova Iguaçu, Volta Redonda...)"
              class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm font-semibold shadow-inner focus:border-[#123F8F] focus:bg-white focus:outline-none focus:ring-3 focus:ring-blue-100 transition-all placeholder:text-slate-400 placeholder:font-normal"
              autocomplete="off"
            />
            <datalist id="lista-municipios">
              {municipios.map((m) => (
                <option value={m.nome}>{m.regiao}</option>
              ))}
            </datalist>
          </div>

          <!-- Atalhos Rápidos das Maiores Cidades -->
          <div class="flex items-center gap-1.5 mt-3 flex-wrap text-xs">
            <span class="text-slate-400 text-[11px] font-medium mr-1">Atalhos:</span>
            <button type="button" class="btn-cidade px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-orange-50 hover:text-[#F15A29] hover:border-orange-200 border border-transparent text-slate-700 font-semibold cursor-pointer transition-all" data-cidade="Nova Iguaçu">Nova Iguaçu</button>
            <button type="button" class="btn-cidade px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-orange-50 hover:text-[#F15A29] hover:border-orange-200 border border-transparent text-slate-700 font-semibold cursor-pointer transition-all" data-cidade="Volta Redonda">Volta Redonda</button>
            <button type="button" class="btn-cidade px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-orange-50 hover:text-[#F15A29] hover:border-orange-200 border border-transparent text-slate-700 font-semibold cursor-pointer transition-all" data-cidade="Nilópolis">Nilópolis</button>
            <button type="button" class="btn-cidade px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-orange-50 hover:text-[#F15A29] hover:border-orange-200 border border-transparent text-slate-700 font-semibold cursor-pointer transition-all" data-cidade="Rio de Janeiro">Rio Capital</button>
            <button type="button" class="btn-cidade px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-orange-50 hover:text-[#F15A29] hover:border-orange-200 border border-transparent text-slate-700 font-semibold cursor-pointer transition-all" data-cidade="Petrópolis">Petrópolis</button>
            <button type="button" class="btn-cidade px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-orange-50 hover:text-[#F15A29] hover:border-orange-200 border border-transparent text-slate-700 font-semibold cursor-pointer transition-all" data-cidade="Campos dos Goytacazes">Campos</button>
          </div>
        </div>

        <!-- Card de Resultado Dinâmico da Cidade Selecionada -->
        <div id="card-resultado-cidade" class="bg-white rounded-3xl border border-slate-200/90 shadow-xl overflow-hidden transition-all duration-300">
          <div class="p-6 sm:p-7">
            <!-- Topo da Ficha: Nome e Região -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-slate-100">
              <div>
                <span id="cidade-regiao" class="inline-block px-3 py-1 rounded-full bg-blue-50 text-[#123F8F] text-[11px] font-bold uppercase tracking-wider mb-1.5">
                  Baixada Fluminense
                </span>
                <h3 id="cidade-nome" class="font-display text-2xl sm:text-3xl font-black italic text-[#123F8F] leading-tight">
                  Nova Iguaçu
                </h3>
              </div>

              <!-- Selo SAMU 100% -->
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold self-start sm:self-auto">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>SAMU 100% Garantido</span>
              </div>
            </div>

            <!-- Resumo da Cidade -->
            <p id="cidade-resumo" class="font-sans text-xs sm:text-sm text-slate-700 leading-relaxed my-5 font-normal">
              Nova Iguaçu é o coração da atuação do Dr. Luizinho. Como secretário municipal e estadual, transformou a cidade na maior potência hospitalar pública da história da Baixada Fluminense.
            </p>

            <!-- Grade de Emendas & Recursos -->
            <div id="cidade-emendas-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
              <div class="p-4 rounded-2xl bg-blue-50/70 border border-blue-100">
                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-0.5">
                  Recursos Já Pagos (Mandato)
                </span>
                <p id="cidade-emendas-pagas" class="font-display text-xl sm:text-2xl font-black italic text-[#123F8F] leading-tight">
                  R$ 20.000.000,00
                </p>
                <span class="text-[10px] text-slate-500">Executados na saúde do município</span>
              </div>

              <div id="box-emendas-garantidas" class="p-4 rounded-2xl bg-orange-50/70 border border-orange-100">
                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-0.5">
                  Recursos Garantidos / Obras
                </span>
                <p id="cidade-emendas-garantidas" class="font-display text-xl sm:text-2xl font-black italic text-[#F15A29] leading-tight">
                  R$ 5.400.000,00
                </p>
                <span class="text-[10px] text-slate-500">Empenhados e em andamento</span>
              </div>
            </div>

            <!-- Lista de Entregas e Equipamentos -->
            <div>
              <h4 class="font-sans text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
                Entregas e Ações no Município:
              </h4>
              <ul id="cidade-entregas-lista" class="space-y-2.5">
                <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 font-medium">
                  <span class="text-emerald-500 font-bold mt-0.5">✓</span>
                  <span>Onco Baixada (Instituto Estadual de Oncologia com 100 leitos e 24 boxes de quimioterapia)</span>
                </li>
                <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 font-medium">
                  <span class="text-emerald-500 font-bold mt-0.5">✓</span>
                  <span>Rio Imagem Baixada (Maior centro de diagnóstico por imagem da Baixada Fluminense)</span>
                </li>
                <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 font-medium">
                  <span class="text-emerald-500 font-bold mt-0.5">✓</span>
                  <span>Reabertura da Maternidade Mariana Bulhões (69 leitos e 25 de UTI neonatal)</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- Rodapé do Card com Ação no WhatsApp -->
          <div class="bg-slate-50 px-6 sm:px-7 py-3.5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-500">
            <span class="text-[11px]">Fonte: Prestação Oficial e SES-RJ</span>
            <a
              id="cidade-share-wa"
              href="https://wa.me/?text=Veja%20o%20que%20o%20Dr.%20Luizinho%201177%20fez%20por%20Nova%20Igua%C3%A7u!"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-bold text-[#F15A29] hover:underline self-end sm:self-auto"
            >
              <span>Compartilhar cidade no WhatsApp</span>
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
              </svg>
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- Script de Sincronização Bidirecional entre o Mapa e a Ficha da Cidade -->
<script define:vars={{ municipios, baseUrl }}>
  const input = document.getElementById('busca-municipio-input');
  const nomeEl = document.getElementById('cidade-nome');
  const regiaoEl = document.getElementById('cidade-regiao');
  const resumoEl = document.getElementById('cidade-resumo');
  const pagasEl = document.getElementById('cidade-emendas-pagas');
  const garantidasEl = document.getElementById('cidade-emendas-garantidas');
  const boxGarantidas = document.getElementById('box-emendas-garantidas');
  const listaEl = document.getElementById('cidade-entregas-lista');
  const shareLink = document.getElementById('cidade-share-wa');
  const cardContainer = document.getElementById('card-resultado-cidade');

  function atualizarFicha(nomeBusca, atualizarMapa = true) {
    const limpo = nomeBusca.trim().toLowerCase();
    const cidade = municipios.find(m => m.nome.toLowerCase() === limpo || m.slug === limpo);
    if (!cidade) return;

    if (nomeEl) nomeEl.textContent = cidade.nome;
    if (regiaoEl) regiaoEl.textContent = cidade.regiao;
    if (resumoEl) resumoEl.textContent = cidade.resumoLocal;

    if (pagasEl) {
      pagasEl.textContent = cidade.emendasPagas || 'Recursos Ordinários SUS';
    }

    if (boxGarantidas && garantidasEl) {
      if (cidade.emendasGarantidas) {
        boxGarantidas.style.display = 'block';
        garantidasEl.textContent = cidade.emendasGarantidas;
      } else {
        boxGarantidas.style.display = 'none';
      }
    }

    if (listaEl) {
      listaEl.innerHTML = '';
      cidade.entregasDiretas.forEach(e => {
        const li = document.createElement('li');
        li.className = 'flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 font-medium';
        li.innerHTML = `<span class="text-emerald-500 font-bold mt-0.5">✓</span><span>${e}</span>`;
        listaEl.appendChild(li);
      });
    }

    if (shareLink) {
      const msg = encodeURIComponent(`Veja o que o Dr. Luizinho 1177 fez por ${cidade.nome}! Acesse: https://felippejuan.github.io/site-1177/#minha-cidade`);
      shareLink.href = `https://wa.me/?text=${msg}`;
    }

    // Sincroniza com o campo de busca
    if (input && input.value !== cidade.nome) {
      input.value = cidade.nome;
    }

    // Notifica o componente MapaFluminense para mover o pino e acender o município
    if (atualizarMapa) {
      window.dispatchEvent(
        new CustomEvent('selecionar-cidade-no-mapa', {
          detail: { slug: cidade.slug }
        })
      );
    }

    // Efeito suave de destaque na ficha
    if (cardContainer) {
      cardContainer.classList.add('ring-2', 'ring-[#F15A29]/60');
      setTimeout(() => cardContainer.classList.remove('ring-2', 'ring-[#F15A29]/60'), 400);
    }
  }

  // Evento vindo do clique no MapaFluminense
  window.addEventListener('mapa-cidade-selecionada', (e) => {
    const slug = e.detail?.slug;
    if (slug) {
      atualizarFicha(slug, false);
    }
  });

  // Evento vindo da digitação no input
  if (input) {
    input.addEventListener('input', (e) => {
      atualizarFicha(e.target.value, true);
    });
    input.addEventListener('change', (e) => {
      atualizarFicha(e.target.value, true);
    });
  }

  // Cliques nos botões de atalhos rápidos
  document.querySelectorAll('.btn-cidade').forEach(btn => {
    btn.addEventListener('click', () => {
      const cidade = btn.getAttribute('data-cidade');
      if (cidade) {
        atualizarFicha(cidade, true);
      }
    });
  });
</script>
