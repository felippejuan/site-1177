---
// src/components/BuscaMunicipal.astro
// Busca inteligente territorial dos 92 municípios do RJ (Dark Institutional Glass)
import { obterTodosMunicipios } from '../data/municipios';

const municipios = obterTodosMunicipios();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="minha-cidade" class="py-20 sm:py-28 bg-[#090E1A] relative border-b border-white/[0.08] overflow-hidden">
  <!-- Luz ambiente suave -->
  <div class="absolute bottom-0 left-1/4 w-[500px] h-[500px] bg-orange-600/5 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Cabeçalho -->
    <div class="max-w-3xl mx-auto text-center mb-14">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-300 font-sans text-xs font-semibold uppercase tracking-wider mb-4">
        Presença em Todo o Estado
      </span>
      <h2 class="font-display text-3xl sm:text-5xl font-black italic tracking-tight text-white leading-tight mb-4">
        O QUE ELE FEZ PELA <span class="text-[#F15A29]">SUA CIDADE?</span>
      </h2>
      <p class="font-sans text-base sm:text-lg text-slate-300 leading-relaxed">
        Consulte qualquer um dos 92 municípios do Rio de Janeiro para ver ambulâncias do SAMU, emendas pagas e investimentos estruturantes.
      </p>
    </div>

    <!-- Campo de Busca Interativo Dark Glass -->
    <div class="max-w-xl mx-auto mb-10">
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="busca-municipio-input"
          list="lista-municipios"
          placeholder="Digite o nome da sua cidade (ex: Nova Iguaçu, Volta Redonda...)"
          class="w-full pl-12 pr-4 py-4 rounded-2xl border border-white/15 bg-[#0D1424] text-white text-base font-semibold shadow-2xl focus:border-[#F15A29] focus:outline-none focus:ring-4 focus:ring-orange-500/20 transition-all placeholder:text-slate-500 placeholder:font-normal"
          autocomplete="off"
        />
        <datalist id="lista-municipios">
          {municipios.map((m) => (
            <option value={m.nome}>{m.regiao}</option>
          ))}
        </datalist>
      </div>

      <!-- Atalhos rápidos das maiores cidades -->
      <div class="flex items-center justify-center gap-2 mt-4 flex-wrap text-xs">
        <span class="text-slate-400 font-medium">Cidades mais buscadas:</span>
        <button type="button" class="btn-cidade px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 hover:border-[#F15A29] hover:text-white text-slate-300 font-medium cursor-pointer transition-all" data-cidade="Nova Iguaçu">Nova Iguaçu</button>
        <button type="button" class="btn-cidade px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 hover:border-[#F15A29] hover:text-white text-slate-300 font-medium cursor-pointer transition-all" data-cidade="Volta Redonda">Volta Redonda</button>
        <button type="button" class="btn-cidade px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 hover:border-[#F15A29] hover:text-white text-slate-300 font-medium cursor-pointer transition-all" data-cidade="Nilópolis">Nilópolis</button>
        <button type="button" class="btn-cidade px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 hover:border-[#F15A29] hover:text-white text-slate-300 font-medium cursor-pointer transition-all" data-cidade="Rio de Janeiro">Rio Capital</button>
        <button type="button" class="btn-cidade px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 hover:border-[#F15A29] hover:text-white text-slate-300 font-medium cursor-pointer transition-all" data-cidade="Niterói">Niterói</button>
        <button type="button" class="btn-cidade px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 hover:border-[#F15A29] hover:text-white text-slate-300 font-medium cursor-pointer transition-all" data-cidade="Quatis">Quatis</button>
      </div>
    </div>

    <!-- Card de Resultado Dinâmico da Cidade -->
    <div id="card-resultado-cidade" class="max-w-3xl mx-auto bg-[#0D1424]/95 rounded-3xl border border-white/[0.08] shadow-2xl shadow-black/80 overflow-hidden transition-all duration-300">
      <div class="p-6 sm:p-10">
        <!-- Topo da Ficha: Nome e Região -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-white/[0.08]">
          <div>
            <span id="cidade-regiao" class="inline-block px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-300 text-xs font-semibold uppercase tracking-wider mb-2">
              Baixada Fluminense
            </span>
            <h3 id="cidade-nome" class="font-display text-3xl sm:text-4xl font-black italic text-white">
              Nova Iguaçu
            </h3>
          </div>

          <!-- Selo SAMU 100% -->
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-xs font-semibold">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>SAMU 100% Fluminense Garantido</span>
          </div>
        </div>

        <!-- Resumo da Cidade -->
        <p id="cidade-resumo" class="font-sans text-sm sm:text-base text-slate-300 leading-relaxed my-6 font-normal">
          Nova Iguaçu é o coração da atuação do Dr. Luizinho. Como secretário municipal e estadual, transformou a cidade na maior potência hospitalar pública da história da Baixada Fluminense.
        </p>

        <!-- Grade de Emendas & Recursos -->
        <div id="cidade-emendas-container" class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          <div class="p-5 rounded-2xl bg-blue-950/40 border border-blue-500/20">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1">
              Recursos Já Pagos (Mandato)
            </span>
            <p id="cidade-emendas-pagas" class="font-display text-2xl sm:text-3xl font-black italic text-white leading-tight">
              R$ 20.000.000,00
            </p>
            <span class="text-[11px] text-slate-400">Executados na saúde e melhorias</span>
          </div>

          <div id="box-emendas-garantidas" class="p-5 rounded-2xl bg-orange-950/30 border border-orange-500/20">
            <span class="text-[11px] font-bold text-orange-300 uppercase tracking-wider block mb-1">
              Recursos Garantidos / Obras
            </span>
            <p id="cidade-emendas-garantidas" class="font-display text-2xl sm:text-3xl font-black italic text-[#F15A29] leading-tight">
              R$ 5.400.000,00
            </p>
            <span class="text-[11px] text-slate-400">Empenhados e em execução</span>
          </div>
        </div>

        <!-- Lista de Entregas e Equipamentos -->
        <div>
          <h4 class="font-sans text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">
            Entregas e Ações no Município:
          </h4>
          <ul id="cidade-entregas-lista" class="space-y-3">
            <li class="flex items-start gap-3 text-sm text-slate-300 font-normal">
              <span class="text-emerald-400 font-bold mt-0.5">✓</span>
              <span>Onco Baixada (Instituto Estadual de Oncologia com 100 leitos e 24 boxes de quimioterapia)</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-slate-300 font-normal">
              <span class="text-emerald-400 font-bold mt-0.5">✓</span>
              <span>Rio Imagem Baixada (Maior centro de diagnóstico por imagem da Baixada Fluminense)</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-slate-300 font-normal">
              <span class="text-emerald-400 font-bold mt-0.5">✓</span>
              <span>Reabertura da Maternidade Mariana Bulhões (69 leitos e 25 de UTI neonatal)</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Rodapé do Card -->
      <div class="bg-[#070A13] px-6 sm:px-10 py-4 border-t border-white/[0.06] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-400">
        <span>Fonte: Sistema OGU, SES-RJ e Prestação Oficial de Contas 2026</span>
        <a
          id="cidade-share-wa"
          href="https://wa.me/?text=Veja%20o%20que%20o%20Dr.%20Luizinho%201177%20fez%20por%20Nova%20Igua%C3%A7u!"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-bold text-[#F15A29] hover:text-orange-300 transition-colors"
        >
          <span>Compartilhar cidade no WhatsApp</span>
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</section>

<!-- Dados serializados embutidos para busca instantânea sem requisição externa -->
<script define:vars={{ municipios, baseUrl }}>
  const input = document.getElementById('busca-municipio-input');
  const nomeEl = document.getElementById('cidade-nome');
  const regiaoEl = document.getElementById('cidade-regiao');
  const resumoEl = document.getElementById('cidade-resumo');
  const pagasEl = document.getElementById('cidade-emendas-pagas');
  const garantidasEl = document.getElementById('cidade-emendas-garantidas');
  const boxGarantidas = document.getElementById('box-emendas-garantidas');
  const listaEl = document.getElementById('cidade-entregas-lista');
  const shareLink = document.getElementById('cidade-share-wa');
  const cardContainer = document.getElementById('card-resultado-cidade');

  function atualizarFicha(nomeBusca) {
    const limpo = nomeBusca.trim().toLowerCase();
    const cidade = municipios.find(m => m.nome.toLowerCase() === limpo);
    if (!cidade) return;

    nomeEl.textContent = cidade.nome;
    regiaoEl.textContent = cidade.regiao;
    resumoEl.textContent = cidade.resumoLocal;

    if (cidade.emendasPagas) {
      pagasEl.textContent = cidade.emendasPagas;
    } else {
      pagasEl.textContent = 'Recursos Ordinários SUS';
    }

    if (cidade.emendasGarantidas) {
      boxGarantidas.style.display = 'block';
      garantidasEl.textContent = cidade.emendasGarantidas;
    } else {
      boxGarantidas.style.display = 'none';
    }

    listaEl.innerHTML = '';
    cidade.entregasDiretas.forEach(e => {
      const li = document.createElement('li');
      li.className = 'flex items-start gap-3 text-sm text-slate-300 font-normal';
      li.innerHTML = `<span class="text-emerald-400 font-bold mt-0.5">✓</span><span>${e}</span>`;
      listaEl.appendChild(li);
    });

    const msg = encodeURIComponent(`Veja o que o Dr. Luizinho 1177 fez por ${cidade.nome}! Acesse: https://felippejuan.github.io/site-1177/#minha-cidade`);
    shareLink.href = `https://wa.me/?text=${msg}`;

    // Animação de realce perimetral no card
    cardContainer.classList.add('ring-2', 'ring-[#F15A29]');
    setTimeout(() => cardContainer.classList.remove('ring-2', 'ring-[#F15A29]'), 400);
  }

  if (input) {
    input.addEventListener('input', (e) => {
      atualizarFicha(e.target.value);
    });
    input.addEventListener('change', (e) => {
      atualizarFicha(e.target.value);
    });
  }

  // Cliques nos botões de cidades sugeridas
  document.querySelectorAll('.btn-cidade').forEach(btn => {
    btn.addEventListener('click', () => {
      const cidade = btn.getAttribute('data-cidade');
      if (cidade && input) {
        input.value = cidade;
        atualizarFicha(cidade);
        cardContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });
</script>
