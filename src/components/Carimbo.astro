---
// src/components/Carimbo.astro
// Selo de comprovação documental com mês/ano e fonte auditada (Light Editorial)

interface Props {
  mes: number;
  ano: number;
  fonte: string;
  linkFonte?: string;
}

const { mes, ano, fonte, linkFonte } = Astro.props;

const meses = [
  'jan', 'fev', 'mar', 'abr', 'mai', 'jun',
  'jul', 'ago', 'set', 'out', 'nov', 'dez'
];

const textoData = `${meses[mes - 1]}/${ano}`;
---

<div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-[11px] font-medium text-slate-600 tracking-tight">
  <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>
  <span>
    Fonte oficial: <strong class="text-slate-800 font-semibold">{fonte}</strong> ({textoData})
  </span>
  {linkFonte && (
    <a
      href={linkFonte}
      target="_blank"
      rel="noopener noreferrer"
      class="text-[#F15A29] hover:underline ml-1 inline-flex items-center transition-colors"
      title="Conferir comprovação oficial"
    >
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  )}
</div>
