---
// src/components/Carimbo.astro
// Selo de comprovação documental com mês/ano e fonte oficial (Sem links externos)

interface Props {
  mes: number;
  ano: number;
  fonte: string;
  linkFonte?: string;
}

const { mes, ano, fonte } = Astro.props;

const meses = [
  'jan', 'fev', 'mar', 'abr', 'mai', 'jun',
  'jul', 'ago', 'set', 'out', 'nov', 'dez'
];

const textoData = `${meses[mes - 1]}/${ano}`;
---

<div class="flex items-center gap-1.5 text-[11px] text-slate-400 font-medium">
  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
  <span>Fonte oficial: <strong class="text-slate-600 font-semibold">{fonte}</strong> ({textoData})</span>
</div>

