---
// src/components/MapaFluminense.astro
// Mapa Vetorial Interativo Oficial do Estado do Rio de Janeiro (IBGE) — Estilo Editorial Boutique
import { MUNICIPIOS_MAPA, MAPA_RJ_VIEWBOX } from '../data/mapa-rj-paths';

// Slugs dos principais polos de investimento com destaque no mapa (Baixada, Capital e polos regionais)
const POLOS_DESTAQUE = new Set([
  'rio-de-janeiro',
  'nova-iguacu',
  'duque-de-caxias',
  'sao-goncalo',
  'campos-dos-goytacazes',
  'belford-roxo',
  'sao-joao-de-meriti',
  'volta-redonda',
  'niteroi',
  'petropolis',
  'nilopolis',
  'angra-dos-reis',
  'cabo-frio',
  'itaperuna',
  'macae',
  'tres-rios',
  'resende',
  'mesquita',
  'mage',
  'marica',
  'barra-mansa',
  'itaborai',
]);

// Valores e destaques para tooltip rápido
const VALORES_MUNICIPIOS: Record<string, string> = {
  'rio-de-janeiro': 'R$ 35M em emendas',
  'nova-iguacu': 'R$ 25,4M em emendas',
  'duque-de-caxias': 'R$ 14,2M em emendas',
  'campos-dos-goytacazes': 'R$ 12M em emendas',
  'belford-roxo': 'R$ 11,5M em emendas',
  'sao-joao-de-meriti': 'R$ 9,1M em emendas',
  'volta-redonda': 'R$ 8,5M em emendas',
  'niteroi': 'R$ 7,8M em emendas',
  'petropolis': 'R$ 6,4M em emendas',
  'nilopolis': 'R$ 6,2M em emendas',
  'angra-dos-reis': 'R$ 7,1M em emendas',
  'cabo-frio': 'R$ 5,9M em emendas',
  'itaperuna': 'R$ 4,7M em emendas',
  'mangaratiba': 'R$ 4,2M em emendas',
  'pirai': 'R$ 3,8M em emendas',
  'quatis': 'R$ 18,5M em investimentos',
};
---

<div class="mapa-fluminense-root w-full select-none">
  
  <!-- Moldura Vetorial Espaçosa do Mapa SVG com Contraste Marítimo Costeiro -->
  <div class="relative w-full aspect-[800/460] bg-gradient-to-br from-[#E2EEFB] via-[#EDF5FD] to-[#D8E8F8] rounded-2xl border border-blue-200/90 p-2 sm:p-4 overflow-hidden flex items-center justify-center group shadow-md shadow-blue-900/5">
    
    <svg
      id="svg-mapa-rj"
      viewBox={MAPA_RJ_VIEWBOX}
      class="w-full h-full object-contain filter drop-shadow-sm"
      xmlns="http://www.w3.org/2000/svg"
      aria-label="Mapa interativo dos 92 municípios do Estado do Rio de Janeiro"
    >
      <defs>
        <!-- Sombra editorial suave para o relevo do estado do RJ -->
        <filter id="rj-landmass-shadow" x="-5%" y="-5%" width="115%" height="115%">
          <feDropShadow dx="0" dy="3" stdDeviation="5" flood-color="#0F172A" flood-opacity="0.12" />
          <feDropShadow dx="0" dy="1" stdDeviation="1.5" flood-color="#0F172A" flood-opacity="0.06" />
        </filter>

        <!-- Brilho para o município selecionado -->
        <filter id="mapa-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#F15A29" flood-opacity="0.55"/>
        </filter>
      </defs>

      <!-- Marca d'água cartográfica elegante no Oceano Atlântico -->
      <g class="pointer-events-none select-none opacity-50">
        <text x="560" y="425" font-family="system-ui, -apple-system, BlinkMacSystemFont, sans-serif" font-size="11" font-weight="800" letter-spacing="0.25em" fill="#64748B" text-anchor="middle">
          OCEANO ATLÂNTICO
        </text>
        <path d="M490 435 L630 435" stroke="#94A3B8" stroke-width="1" stroke-dasharray="3 3" />
      </g>

      <!-- Camada dos 92 Municípios Fluminenses -->
      <g id="camada-municipios" filter="url(#rj-landmass-shadow)">
        {MUNICIPIOS_MAPA.map((m) => {
          const isPolo = POLOS_DESTAQUE.has(m.slug);
          const isAtivo = m.slug === 'nova-iguacu';
          const valor = VALORES_MUNICIPIOS[m.slug] || '';
          return (
            <path
              id={`path-${m.slug}`}
              data-slug={m.slug}
              data-nome={m.nome}
              data-regiao={m.regiao}
              data-cx={m.centroid[0]}
              data-cy={m.centroid[1]}
              data-valor={valor}
              d={m.d}
              class={`municipio-path ${isAtivo ? 'municipio-ativo' : ''} ${isPolo ? 'municipio-polo' : ''}`}
              tabindex="0"
              role="button"
              aria-label={`${m.nome} (${m.regiao})`}
            />
          );
        })}
      </g>

      <!-- Marcadores luminosos dos polos de atuação (pontinhos laranjas vibrantes com aura e pulso) -->
      <g id="camada-pontos-polos" class="pointer-events-none">
        {MUNICIPIOS_MAPA.filter(m => POLOS_DESTAQUE.has(m.slug)).map((m) => (
          <g class="ponto-polo-beacon">
            <!-- Aura externa pulsante suave -->
            <circle
              cx={m.centroid[0]}
              cy={m.centroid[1]}
              r="6"
              class="fill-[#F15A29]/25 animate-pulse"
            />
            <!-- Ponto sólido de alto contraste -->
            <circle
              cx={m.centroid[0]}
              cy={m.centroid[1]}
              r="3.5"
              class="fill-[#F15A29] stroke-white stroke-[1.3]"
            />
            <!-- Brilho no núcleo -->
            <circle
              cx={m.centroid[0]}
              cy={m.centroid[1]}
              r="1.2"
              class="fill-white"
            />
          </g>
        ))}
      </g>

      <!-- Marcador / Pino Pulsante na Cidade Ativa -->
      <g id="mapa-pin-grupo" class="pointer-events-none transition-all duration-500 ease-out" transform="translate(236.2, 348)">
        <circle r="18" class="fill-[#F15A29]/30 animate-ping" />
        <circle r="8.5" class="fill-[#F15A29] stroke-white stroke-[2.2] shadow-md" />
        <circle r="3" class="fill-white" />
      </g>
    </svg>

    <!-- Legenda no Canto Inferior Esquerdo -->
    <div class="absolute bottom-3 left-4 pointer-events-none hidden sm:flex items-center gap-3 text-[11px] font-semibold text-slate-700 bg-white/95 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-slate-200/90 shadow-xs">
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-white border border-slate-400"></span>
        <span>92 cidades atendidas</span>
      </span>
      <span class="text-slate-300">·</span>
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-[#F15A29] animate-pulse"></span>
        <span>Polos de atuação</span>
      </span>
    </div>

    <!-- Dica de Interação no Canto Direito -->
    <div class="absolute bottom-3 right-4 pointer-events-none text-[11px] font-medium text-slate-700 bg-white/95 backdrop-blur-md px-3 py-1.5 rounded-full border border-slate-200/90 shadow-xs flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-[#F15A29]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5" />
      </svg>
      <span>Clique no mapa ou nos atalhos acima</span>
    </div>

  </div>

</div>

<!-- Tooltip Flutuante que Acompanha o Cursor (Desktop) -->
<div
  id="mapa-tooltip"
  class="fixed pointer-events-none z-50 px-3.5 py-2 rounded-xl bg-slate-900/95 backdrop-blur-md text-white shadow-xl border border-white/15 text-xs transition-opacity duration-150 opacity-0 -translate-x-1/2 -translate-y-full mb-3"
  style="top: 0; left: 0;"
>
  <div id="tooltip-cidade" class="font-display font-black text-sm text-[#F15A29] leading-tight">Nova Iguaçu</div>
  <div class="flex items-center gap-2 mt-0.5 text-[11px] text-slate-300">
    <span id="tooltip-regiao" class="font-medium text-slate-300">Baixada Fluminense</span>
    <span class="text-white/40">·</span>
    <span id="tooltip-extra" class="text-emerald-400 font-semibold">SAMU 100%</span>
  </div>
</div>

<style>
  .municipio-path {
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-width: 1.1px;
    stroke: #64748B; /* Linhas nítidas, contrastadas e elegantes */
    fill: #FFFFFF;   /* Branco puro com forte contraste sobre o azul do mar */
    transition: fill 0.18s cubic-bezier(0.4, 0, 0.2, 1),
                stroke 0.18s cubic-bezier(0.4, 0, 0.2, 1),
                stroke-width 0.18s cubic-bezier(0.4, 0, 0.2, 1),
                filter 0.18s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    outline: none;
  }

  /* Polos com presença destacada */
  .municipio-path.municipio-polo {
    fill: #FFF7ED;   /* Toque suave marfim/laranja convidando o clique */
    stroke: #EA580C; /* Borda laranja definida */
    stroke-width: 1.25px;
  }

  /* Hover suave e refinado */
  .municipio-path:hover {
    fill: #FED7AA !important;
    stroke: #F15A29 !important;
    stroke-width: 2.2px !important;
    filter: drop-shadow(0 2px 8px rgba(241, 90, 41, 0.45));
  }

  /* Município Ativo / Selecionado */
  .municipio-path.municipio-ativo {
    fill: #F15A29 !important;
    stroke: #FFFFFF !important;
    stroke-width: 2.4px !important;
    filter: drop-shadow(0 4px 12px rgba(241, 90, 41, 0.65));
  }
</style>

<script>
  function setupMapaFluminense() {
    const svg = document.getElementById('svg-mapa-rj');
    if (!svg) return;

    const paths = svg.querySelectorAll<SVGPathElement>('.municipio-path');
    const pinGroup = document.getElementById('mapa-pin-grupo');
    const tooltip = document.getElementById('mapa-tooltip');
    const tooltipCidade = document.getElementById('tooltip-cidade');
    const tooltipRegiao = document.getElementById('tooltip-regiao');
    const tooltipExtra = document.getElementById('tooltip-extra');

    function selecionarMunicipio(slug: string, abrirPopUp = true) {
      const targetPath = svg?.querySelector<SVGPathElement>(`#path-${slug}`);
      if (!targetPath) return;

      // Atualiza classe ativa no path
      paths.forEach((p) => {
        const isTarget = p.getAttribute('data-slug') === slug;
        if (isTarget) {
          p.classList.add('municipio-ativo');
          p.parentNode?.appendChild(p); // Eleva na pilha SVG para destacar a borda
        } else {
          p.classList.remove('municipio-ativo');
        }
      });

      // Move o pino para o centróide
      const cx = targetPath.getAttribute('data-cx');
      const cy = targetPath.getAttribute('data-cy');
      if (pinGroup && cx && cy) {
        pinGroup.setAttribute('transform', `translate(${cx}, ${cy})`);
        pinGroup.parentNode?.appendChild(pinGroup);
      }

      // Notifica o sistema para abrir o Pop-up
      const nome = targetPath.getAttribute('data-nome') || '';
      const regiao = targetPath.getAttribute('data-regiao') || '';
      window.dispatchEvent(
        new CustomEvent('mapa-cidade-selecionada', {
          detail: { slug, nome, regiao, abrirPopUp }
        })
      );
    }

    paths.forEach((path) => {
      path.addEventListener('click', () => {
        const slug = path.getAttribute('data-slug');
        if (slug) selecionarMunicipio(slug, true);
      });

      path.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const slug = path.getAttribute('data-slug');
          if (slug) selecionarMunicipio(slug, true);
        }
      });

      path.addEventListener('mouseenter', (e) => {
        if (window.matchMedia('(hover: hover)').matches) {
          const nome = path.getAttribute('data-nome') || '';
          const regiao = path.getAttribute('data-regiao') || '';
          const valor = path.getAttribute('data-valor') || '';

          if (tooltipCidade) tooltipCidade.textContent = nome;
          if (tooltipRegiao) tooltipRegiao.textContent = regiao;
          if (tooltipExtra) {
            tooltipExtra.textContent = valor ? valor : 'SAMU 100%';
            tooltipExtra.className = valor ? 'text-[#F15A29] font-bold' : 'text-emerald-400 font-semibold';
          }

          if (tooltip) {
            tooltip.style.left = `${e.clientX}px`;
            tooltip.style.top = `${e.clientY - 12}px`;
            tooltip.classList.remove('opacity-0');
            tooltip.classList.add('opacity-100');
          }
        }
      });

      path.addEventListener('mousemove', (e) => {
        if (tooltip && window.matchMedia('(hover: hover)').matches) {
          tooltip.style.left = `${e.clientX}px`;
          tooltip.style.top = `${e.clientY - 12}px`;
        }
      });

      path.addEventListener('mouseleave', () => {
        if (tooltip) {
          tooltip.classList.remove('opacity-100');
          tooltip.classList.add('opacity-0');
        }
      });

      path.addEventListener('touchstart', () => {
        if (tooltip) {
          tooltip.classList.remove('opacity-100');
          tooltip.classList.add('opacity-0');
        }
      }, { passive: true });
    });

    window.addEventListener('selecionar-cidade-no-mapa', ((e: CustomEvent) => {
      const slug = e.detail?.slug;
      const abrirPopUp = e.detail?.abrirPopUp ?? true;
      if (slug) {
        selecionarMunicipio(slug, abrirPopUp);
      }
    }) as EventListener);
  }

  setupMapaFluminense();
  document.addEventListener('astro:page-load', setupMapaFluminense);
</script>
