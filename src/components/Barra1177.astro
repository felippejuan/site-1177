---
// src/components/Barra1177.astro
// Barra fixa mobile para conversão e compartilhamento via WhatsApp (Light Theme)
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white/95 backdrop-blur-lg border-t border-slate-200 shadow-2xl p-3.5 safe-area-bottom">
  <div class="flex items-center justify-between gap-3 max-w-md mx-auto">
    <!-- Identificação 1177 -->
    <a href={`${baseUrl}/`} class="flex items-center gap-2.5 pl-1">
      <div class="flex flex-col">
        <span class="text-[9px] font-extrabold uppercase tracking-wider text-slate-500 leading-none">VOTE</span>
        <span class="font-display text-2xl font-black italic text-[#123F8F] leading-none">
          DR. LUIZINHO
        </span>
      </div>
      <div class="h-6 w-[1.5px] bg-slate-200"></div>
      <span class="font-display text-2xl font-black italic text-[#F15A29] leading-none">
        1177
      </span>
    </a>

    <!-- Botão WhatsApp com mensagem pré-formatada -->
    <a
      href="https://wa.me/5521999991177?text=Ol%C3%A1%2C%20Dr.%20Luizinho!%20Apoio%20seu%20trabalho%20pelo%20Rio%201177."
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-[#F15A29] active:bg-[#D94819] text-white font-sans text-xs font-bold shadow-md shadow-orange-500/20 active:scale-95 transition-all"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
      </svg>
      <span>Fale no WhatsApp</span>
    </a>
  </div>
</aside>
