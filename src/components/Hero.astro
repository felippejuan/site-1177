---
// src/components/Hero.astro
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden bg-[#070A13] text-white pt-10 pb-20 lg:pt-16 lg:pb-28 border-b border-white/[0.08]">
  
  <!-- Vídeo de Fundo Cinemático -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <video
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      class="w-full h-full object-cover opacity-35 filter brightness-90 contrast-110 scale-105 transition-opacity duration-1000"
    >
      <source src={`${baseUrl}/video-hero.mp4`} type="video/mp4" />
    </video>

    <!-- Scrim Escuro de Alto Contraste & Legibilidade Estrita -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#070A13] via-[#070A13]/90 to-[#070A13]/70"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#070A13] via-transparent to-[#070A13]/80"></div>
    <div class="absolute -top-40 -left-40 w-[600px] h-[600px] bg-blue-600/15 rounded-full blur-[140px]"></div>
    <div class="absolute -bottom-40 right-0 w-[500px] h-[500px] bg-orange-600/10 rounded-full blur-[140px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      
      <!-- Coluna de Texto & Autoridade (7 colunas) -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
        
        <!-- Badge de Liderança -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/[0.06] backdrop-blur-md border border-white/10 text-xs sm:text-sm font-semibold text-orange-300 mb-6 shadow-inner">
          <span class="w-2 h-2 rounded-full bg-[#F15A29] animate-pulse"></span>
          <span class="tracking-wide">MEDICINA & GESTÃO PÚBLICA · ELEIÇÕES 2026</span>
        </div>

        <!-- Título Monumental Sóbrio e Forte -->
        <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-black italic uppercase tracking-tight text-white leading-[0.93] mb-6">
          CORAGEM PARA <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#F15A29] via-orange-400 to-amber-300">DESATAR O NÓ</span> <br class="hidden sm:inline" />
          DA SAÚDE NO RIO.
        </h1>

        <!-- Descrição Executiva -->
        <p class="font-sans text-base sm:text-lg text-slate-300 max-w-xl font-normal leading-relaxed mb-8">
          Médico forjado nos plantões de emergência da Baixada Fluminense e gestor que enfrentou as maiores crises do Estado. Levou o SAMU aos <strong class="text-white font-semibold">92 municípios</strong>, abriu hospitais paralisados há décadas e viabilizou o primeiro centro de tratamento de câncer da região.
        </p>

        <!-- Número de Urna em Alta Estética Dark Glass -->
        <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 mb-9 w-full sm:w-auto">
          <div class="flex items-center gap-4 px-6 py-3.5 rounded-2xl bg-[#0D1424]/90 border border-white/15 shadow-2xl backdrop-blur-xl group hover:border-[#F15A29]/60 transition-all">
            <div class="text-left">
              <span class="block text-[10px] font-extrabold uppercase text-slate-400 tracking-wider">VOTE DEPUTADO FEDERAL</span>
              <span class="font-display text-3xl sm:text-4xl font-black italic text-white leading-none">
                DR. LUIZINHO
              </span>
            </div>
            <div class="h-10 w-[1px] bg-white/15"></div>
            <span class="font-display text-5xl sm:text-6xl font-black italic text-[#F15A29] leading-none tracking-tight">
              1177
            </span>
          </div>

          <!-- Botão WhatsApp Direto -->
          <a
            href="https://wa.me/5521999991177?text=Ol%C3%A1%2C%20Dr.%20Luizinho!%20Apoio%20seu%20trabalho%20pelo%20Rio."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-7 py-4 rounded-2xl bg-[#F15A29] hover:bg-[#D94819] text-white font-sans text-base font-bold shadow-xl shadow-orange-950/60 hover:shadow-orange-600/30 hover:scale-105 active:scale-95 transition-all border border-orange-400/40"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
            </svg>
            <span>Fale no WhatsApp</span>
          </a>
        </div>

        <!-- Pilares de Validação -->
        <div class="flex items-center gap-4 text-xs font-semibold text-slate-400">
          <span class="flex items-center gap-1.5 text-emerald-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Dados 100% Auditados no SUS
          </span>
          <span class="w-1 h-1 rounded-full bg-slate-600"></span>
          <span>92 Municípios Fluminenses</span>
          <span class="w-1 h-1 rounded-full bg-slate-600"></span>
          <span>R$ 800M+ Destravados</span>
        </div>
      </div>

      <!-- Coluna da Foto Oficial & Moldura Midnight (5 colunas) -->
      <div class="lg:col-span-5 flex justify-center relative">
        <div class="relative w-full max-w-sm sm:max-w-md">
          <!-- Aurora Glow Perimetral -->
          <div class="absolute -inset-2 rounded-3xl bg-gradient-to-tr from-[#F15A29]/30 via-blue-600/20 to-purple-600/10 opacity-70 blur-2xl"></div>

          <!-- Moldura Vidro Escuro -->
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl bg-[#0D1424]">
            <img
              src={`${baseUrl}/dr-luizinho.jpg`}
              alt="Foto Oficial Dr. Luizinho"
              class="w-full h-auto object-cover object-top aspect-[4/5] hover:scale-102 transition-transform duration-700 filter contrast-105"
            />
            
            <!-- Tarja Inferior Transparente com Dados de Carreira -->
            <div class="absolute bottom-0 inset-x-0 p-6 bg-gradient-to-t from-[#070A13] via-[#070A13]/85 to-transparent backdrop-blur-[2px]">
              <span class="inline-block px-2.5 py-0.5 rounded bg-[#F15A29] text-white font-sans text-[10px] font-extrabold uppercase tracking-wider mb-1.5">
                Médico e Gestor Público
              </span>
              <p class="font-display text-2xl sm:text-3xl font-black italic text-white leading-tight">
                DR. LUIZ ANTÔNIO TEIXEIRA JR.
              </p>
              <p class="font-sans text-xs text-slate-300 font-normal mt-0.5">
                Ex-Sec. de Saúde de Nova Iguaçu · 2x Secretário de Estado de Saúde do RJ
              </p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
