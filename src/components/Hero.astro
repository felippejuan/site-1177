---
// src/components/Hero.astro
// Hero Cinemático, Elegante e Focado no Eleitor (Sem flyer/santinho estático)
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="relative min-h-[92vh] flex items-center overflow-hidden bg-[#070A13] text-white pt-10 pb-20 lg:pt-16 lg:pb-28 border-b border-white/[0.08]">
  
  <!-- Vídeo de Fundo Cinemático -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <video
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      class="w-full h-full object-cover opacity-40 filter brightness-95 contrast-110 scale-105"
    >
      <source src={`${baseUrl}/video-hero.mp4`} type="video/mp4" />
    </video>

    <!-- Scrim Gradiente Escuro Suave para Contraste Impecável -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#070A13] via-[#070A13]/90 to-[#070A13]/65"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#070A13] via-transparent to-[#070A13]/70"></div>
    <div class="absolute -top-32 -left-32 w-[550px] h-[550px] bg-blue-600/15 rounded-full blur-[140px]"></div>
    <div class="absolute -bottom-32 right-10 w-[500px] h-[500px] bg-orange-600/10 rounded-full blur-[140px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-12 items-center">
      
      <!-- Coluna Principal de Mensagem (7 colunas) -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
        
        <!-- Badge Superior Elegante -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/[0.06] backdrop-blur-md border border-white/10 text-xs sm:text-sm font-semibold text-orange-300 mb-6">
          <span class="w-2 h-2 rounded-full bg-[#F15A29] animate-pulse"></span>
          <span class="tracking-wide">SAÚDE PÚBLICA & LIDERANÇA NO RIO</span>
        </div>

        <!-- Título Monumental Direto e Forte -->
        <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-black italic uppercase tracking-tight text-white leading-[0.93] mb-6">
          QUEM TEM CORAGEM <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#F15A29] via-orange-400 to-amber-300">
            FAZ A SAÚDE FUNCIONAR
          </span>.
        </h1>

        <!-- Subtítulo Humano e Centrado no Eleitor -->
        <p class="font-sans text-base sm:text-lg text-slate-300 max-w-xl font-normal leading-relaxed mb-8">
          Médico que viveu a realidade dos plantões na Baixada e gestor que destravou as maiores obras do Rio. Levou ambulâncias novas do SAMU a <strong class="text-white font-semibold">100% dos municípios</strong>, reabriu hospitais abandonados e idealizou o primeiro centro de tratamento de câncer da região.
        </p>

        <!-- Botões de Ação com Alta Usabilidade (UX Friendly) -->
        <div class="flex flex-col sm:flex-row items-center gap-3.5 sm:gap-4 mb-9 w-full sm:w-auto">
          <!-- CTA Primário: Buscar Cidade -->
          <a
            href="#minha-cidade"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-2xl bg-[#F15A29] hover:bg-[#D94819] text-white font-sans text-base font-bold shadow-xl shadow-orange-950/60 hover:shadow-orange-600/30 hover:scale-105 active:scale-95 transition-all border border-orange-400/40"
          >
            <span>Ver o que ele fez na sua cidade</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>

          <!-- CTA Secundário: WhatsApp -->
          <a
            href="https://wa.me/5521999991177?text=Ol%C3%A1%2C%20Dr.%20Luizinho!%20Quero%20acompanhar%20seu%20trabalho%20pelo%20Rio."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-2xl bg-white/[0.06] hover:bg-white/10 text-white font-sans text-base font-semibold border border-white/15 backdrop-blur-md hover:border-white/30 transition-all"
          >
            <svg class="w-4 h-4 fill-current text-emerald-400" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
            </svg>
            <span>Fale no WhatsApp</span>
          </a>
        </div>

        <!-- Benefícios Concretos que o Eleitor se Importa -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-x-6 gap-y-2 text-xs font-medium text-slate-300">
          <span class="flex items-center gap-1.5">
            <span class="text-orange-400">🚑</span>
            SAMU em todas as 92 cidades
          </span>
          <span class="hidden sm:inline text-white/20">|</span>
          <span class="flex items-center gap-1.5">
            <span class="text-orange-400">🏥</span>
            Hospitais e maternidades reabertos
          </span>
          <span class="hidden sm:inline text-white/20">|</span>
          <span class="flex items-center gap-1.5">
            <span class="text-orange-400">🩺</span>
            Médico presente na vida real
          </span>
        </div>
      </div>

      <!-- Coluna Direita: Card Interativo de Utilidade para o Eleitor (5 colunas) -->
      <div class="lg:col-span-5 flex justify-center w-full">
        <div class="w-full max-w-md p-7 sm:p-8 rounded-3xl bg-[#0D1424]/90 border border-white/15 shadow-2xl backdrop-blur-xl relative overflow-hidden group">
          <!-- Brilho perimetral sutil -->
          <div class="absolute top-0 right-0 w-32 h-32 bg-orange-500/10 rounded-full blur-2xl pointer-events-none"></div>

          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-500/15 border border-orange-500/30 text-xs font-bold text-orange-400 uppercase tracking-wider">
              <span>📍</span> Consulta Rápida
            </span>
            <span class="text-xs text-slate-400 font-semibold">Todo o RJ</span>
          </div>

          <h3 class="font-display text-2xl sm:text-3xl font-black italic text-white mb-2 leading-tight">
            O QUE ELE FEZ PELA SUA REGIÃO?
          </h3>
          <p class="font-sans text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 font-normal">
            Escolha uma cidade ou região para ver ambulâncias do SAMU entregues, investimentos e melhorias na saúde:
          </p>

          <!-- Atalhos Rápidos Clicáveis -->
          <div class="grid grid-cols-2 gap-2.5 mb-6">
            <a
              href="#minha-cidade"
              class="px-3.5 py-2.5 rounded-xl bg-white/[0.05] hover:bg-[#F15A29] border border-white/10 hover:border-[#F15A29] text-xs font-semibold text-slate-200 hover:text-white transition-all text-center flex items-center justify-center gap-1.5 group/btn"
            >
              <span>Nova Iguaçu</span>
              <span class="text-slate-500 group-hover/btn:text-white text-[10px]">→</span>
            </a>
            <a
              href="#minha-cidade"
              class="px-3.5 py-2.5 rounded-xl bg-white/[0.05] hover:bg-[#F15A29] border border-white/10 hover:border-[#F15A29] text-xs font-semibold text-slate-200 hover:text-white transition-all text-center flex items-center justify-center gap-1.5 group/btn"
            >
              <span>Volta Redonda</span>
              <span class="text-slate-500 group-hover/btn:text-white text-[10px]">→</span>
            </a>
            <a
              href="#minha-cidade"
              class="px-3.5 py-2.5 rounded-xl bg-white/[0.05] hover:bg-[#F15A29] border border-white/10 hover:border-[#F15A29] text-xs font-semibold text-slate-200 hover:text-white transition-all text-center flex items-center justify-center gap-1.5 group/btn"
            >
              <span>São Gonçalo</span>
              <span class="text-slate-500 group-hover/btn:text-white text-[10px]">→</span>
            </a>
            <a
              href="#minha-cidade"
              class="px-3.5 py-2.5 rounded-xl bg-white/[0.05] hover:bg-[#F15A29] border border-white/10 hover:border-[#F15A29] text-xs font-semibold text-slate-200 hover:text-white transition-all text-center flex items-center justify-center gap-1.5 group/btn"
            >
              <span>Rio de Janeiro</span>
              <span class="text-slate-500 group-hover/btn:text-white text-[10px]">→</span>
            </a>
          </div>

          <!-- Rodapé do Card com Identificação Oficial Limpa -->
          <div class="pt-5 border-t border-white/10 flex items-center justify-between">
            <div>
              <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Deputado Federal</span>
              <span class="font-display text-xl font-black italic text-white">DR. LUIZINHO</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold text-slate-400 uppercase">Vote</span>
              <span class="font-display text-4xl font-black italic text-[#F15A29] tracking-tight">1177</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
