---
// src/components/Hero.astro
// Hero Cinemático em Coluna Única — Fundo Branco com Vídeo Nítido em Segundo Plano
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="relative min-h-[85vh] lg:min-h-[88vh] flex items-center justify-center overflow-hidden bg-white text-slate-900 pt-12 pb-20 lg:pt-20 lg:pb-28 border-b border-slate-200/80">
  
  <!-- Vídeo de Fundo Cinemático Bem Mais Visível -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <video
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      class="w-full h-full object-cover opacity-80 md:opacity-85 filter contrast-105"
    >
      <source src={`${baseUrl}/video-deputado.mp4`} type="video/mp4" />
    </video>

    <!-- Scrim Suave Translúcido para Leitura Perfeita com Vídeo Nítido -->
    <div class="absolute inset-0 bg-white/70 sm:bg-white/60"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-white/30"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center">
      
      <!-- Título Monumental Direto e Forte -->
      <h1 class="font-display text-[clamp(33px,9vw,40px)] min-[430px]:text-[42px] sm:text-5xl lg:text-6xl font-black italic uppercase tracking-tight text-[#123F8F] leading-[1.06] mb-6">
        <span class="whitespace-nowrap tracking-tight">TRABALHO E CORAGEM PARA</span> <br />
        <span class="text-[#F15A29]">CUIDAR DAS PESSOAS <br class="sm:hidden" />
        E SALVAR VIDAS</span>.
      </h1>

      <!-- Subtítulo Humano Focado no Eleitor -->
      <div class="font-sans text-base sm:text-lg text-slate-800 max-w-3xl leading-relaxed mb-9 space-y-2.5">
        <p class="font-bold text-[#123F8F] text-lg sm:text-xl tracking-tight">
          Médico por vocação. Gestor por resultados. Líder por compromisso.
        </p>
        <p class="font-medium text-slate-700">
          Da criação do Rio Imagem e do Onco Baixada à chegada do SAMU em 100% dos municípios fluminenses, ele provou que é possível transformar a saúde pública.
        </p>
        <p class="font-medium text-slate-700">
          Hoje, no Congresso Nacional, essa mesma dedicação se transforma em leis e projetos que fortalecem o SUS e protegem a vida de milhões de brasileiros.
        </p>
        <p class="font-semibold text-slate-900">
          Uma trajetória de quem cuida, trabalha e entrega — do Rio para o Brasil.
        </p>
      </div>

      <!-- Botões de Ação com Alta Usabilidade (UX Friendly) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
        <!-- CTA Primário: Buscar Cidade -->
        <a
          href="#minha-cidade"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl bg-[#F15A29] hover:bg-[#D94819] text-white font-sans text-base font-bold shadow-xl shadow-orange-500/25 hover:shadow-orange-500/35 hover:scale-105 active:scale-95 transition-all"
        >
          <span>Veja o que ele fez pela sua cidade ↓</span>
        </a>

        <!-- CTA Secundário: WhatsApp em Azul com contraste em branco -->
        <a
          href="https://api.whatsapp.com/send?phone=5521999251177&text=Ol%C3%A1%2C%20Dr.%20Luizinho!%20Vim%20pelo%20site%20oficial%20e%20quero%20acompanhar%20as%20novidades%20e%20o%20trabalho%20pela%20sa%C3%BAde%20do%20Rio."
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-7 py-4 rounded-2xl bg-[#123F8F] hover:bg-[#0D2F6B] text-white font-sans text-base font-bold border border-blue-700/60 shadow-lg shadow-blue-950/20 hover:scale-105 active:scale-95 transition-all"
          title="Fale com a gente pelo WhatsApp"
        >
          <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current text-white shrink-0" viewBox="5.5 5.5 13 13">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
          </svg>
          <span>Fale com a gente pelo WhatsApp</span>
        </a>
      </div>

    </div>
  </div>
</section>
