---
// src/components/Hero.astro
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="relative overflow-hidden bg-gradient-to-b from-blue-900 via-[#123F8F] to-[#0D3577] text-white pt-10 pb-16 lg:pt-16 lg:pb-24">
  <!-- Padrão Geométrico de Fundo -->
  <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Coluna de Texto & Impacto (7 colunas) -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
        <!-- Badge Superior -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs sm:text-sm font-semibold text-orange-300 mb-6">
          <span class="w-2 h-2 rounded-full bg-[#F15A29] animate-ping"></span>
          <span>Campanha Oficial · Deputado Federal 2026</span>
        </div>

        <!-- Chamada Principal -->
        <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-black italic uppercase tracking-tight text-white leading-[0.95] mb-4">
          O TRABALHO <br class="hidden sm:inline" />
          <span class="text-[#F15A29] drop-shadow-sm">TRANSFORMA</span> O RIO
        </h1>

        <p class="font-sans text-lg sm:text-xl text-blue-100 max-w-xl font-normal leading-relaxed mb-8">
          Médico da Baixada, gestor de saúde pública e o Deputado que levou o SAMU a <strong class="text-white font-bold">100% dos municípios</strong> e idealizou o primeiro hospital de câncer da região.
        </p>

        <!-- Número de Urna em Destaque 1177 -->
        <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 mb-8 w-full sm:w-auto">
          <div class="flex items-center gap-3 px-6 py-3 rounded-2xl bg-white text-slate-900 shadow-2xl border-2 border-orange-400">
            <div class="text-left">
              <span class="block text-[10px] font-extrabold uppercase text-slate-500 tracking-wider">VOTE</span>
              <span class="font-display text-4xl sm:text-5xl font-black italic text-[#123F8F] leading-none">
                DR. LUIZINHO
              </span>
            </div>
            <div class="h-10 w-[2px] bg-slate-200"></div>
            <span class="font-display text-5xl sm:text-6xl font-black italic text-[#F15A29] leading-none">
              1177
            </span>
          </div>

          <!-- Botão WhatsApp -->
          <a
            href="https://wa.me/5521999991177?text=Ol%C3%A1%2C%20Dr.%20Luizinho!%20Apoio%20seu%20trabalho%20pelo%20Rio."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-6 py-4 rounded-2xl bg-[#F15A29] hover:bg-[#D94819] text-white font-sans text-base font-bold shadow-xl shadow-orange-900/40 hover:scale-105 active:scale-95 transition-all"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
            </svg>
            <span>Fale no WhatsApp</span>
          </a>
        </div>

        <!-- Links rápidos -->
        <div class="flex items-center gap-4 text-xs font-semibold text-blue-200">
          <span>✓ Dados 100% auditados pelo SUS</span>
          <span class="w-1 h-1 rounded-full bg-blue-300"></span>
          <span>✓ 92 municípios atendidos</span>
        </div>
      </div>

      <!-- Coluna da Foto Oficial & Card de Autoridade (5 colunas) -->
      <div class="lg:col-span-5 flex justify-center relative">
        <div class="relative w-full max-w-sm sm:max-w-md">
          <!-- Brilho ao redor -->
          <div class="absolute -inset-2 rounded-3xl bg-gradient-to-tr from-[#F15A29] to-blue-400 opacity-30 blur-2xl"></div>

          <!-- Moldura da Foto -->
          <div class="relative rounded-3xl overflow-hidden border-4 border-white/20 shadow-2xl bg-gradient-to-t from-slate-950 via-slate-900 to-blue-900">
            <img
              src={`${baseUrl}/dr-luizinho.jpg`}
              alt="Foto Oficial Dr. Luizinho"
              class="w-full h-auto object-cover object-top aspect-[4/5] hover:scale-105 transition-transform duration-500"
            />
            
            <!-- Tarja inferior com nome e cargo -->
            <div class="absolute bottom-0 inset-x-0 p-6 bg-gradient-to-t from-black/90 via-black/60 to-transparent">
              <span class="inline-block px-2.5 py-0.5 rounded bg-[#F15A29] text-white font-sans text-[10px] font-extrabold uppercase tracking-wider mb-1">
                Médico e Gestor Público
              </span>
              <p class="font-display text-2xl font-black italic text-white leading-tight">
                DR. LUIZ ANTÔNIO TEIXEIRA JR.
              </p>
              <p class="font-sans text-xs text-slate-300 font-medium">
                Duas vezes Secretário de Estado de Saúde do RJ
              </p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
