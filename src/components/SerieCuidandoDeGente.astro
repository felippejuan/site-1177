---
// src/components/SerieCuidandoDeGente.astro
// Hub Interativo de Vídeo (Estilo Playlist / Streaming) — Série Especial "CUIDANDO DE GENTE"
import { EPISODIOS_SERIE } from '../data/cuidando-de-gente';

const episodioInicial = EPISODIOS_SERIE[0]; // Episódio âncora inicial
---

<section id="cuidando-de-gente" class="py-12 sm:py-16 md:py-20 bg-gradient-to-b from-white via-slate-50 to-white relative border-b border-slate-200/80 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Cabeçalho Editorial da Série -->
    <div class="max-w-3xl mx-auto text-center mb-8 sm:mb-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-50 border border-red-200/90 text-red-600 font-sans text-xs font-bold uppercase tracking-wider mb-3">
        <svg class="w-4 h-4 fill-current text-red-600" viewBox="0 0 24 24">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        <span>ASSISTA A SÉRIE ESPECIAL</span>
      </div>

      <h2 class="font-display text-3xl sm:text-5xl font-black italic tracking-tight leading-tight mb-4">
        <span class="text-[#123F8F]">CUIDANDO</span> <span class="text-[#F15A29]">DE GENTE</span>
      </h2>

      <p class="font-sans text-base sm:text-lg text-slate-700 font-medium leading-relaxed max-w-3xl mx-auto">
        Histórias reais de quem teve a vida transformada pelos hospitais, cirurgias, tratamentos, atendimentos e ambulâncias viabilizados em todo o Estado.
      </p>
    </div>

    <!-- ======================================================== -->
    <!-- THEATER CENTRAL / PLAYER INTERATIVO DE STREAMING         -->
    <!-- ======================================================== -->
    <div
      id="serie-theater"
      class="max-w-5xl mx-auto bg-gradient-to-br from-[#071738] via-[#0B2554] to-[#112A61] rounded-3xl p-5 sm:p-8 md:p-10 text-white shadow-2xl shadow-blue-950/40 mb-8 sm:mb-10 border border-blue-800/50 relative overflow-hidden"
    >
      <!-- Glow decorativo de fundo -->
      <div class="absolute -right-20 -bottom-20 w-96 h-96 rounded-full bg-[#F15A29]/15 blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center relative z-10">
        
        <!-- Tela do Player (Suporta Thumbnail com Play ou Iframe Direto) -->
        <div class="lg:col-span-7">
          <div
            id="player-screen-container"
            class="relative aspect-video rounded-2xl overflow-hidden shadow-2xl bg-black border border-white/20 group/screen"
          >
            <!-- Poster com imagem e botão de play -->
            <div id="player-poster" class="absolute inset-0 cursor-pointer">
              <img
                id="player-poster-img"
                src={`https://img.youtube.com/vi/${episodioInicial.youtubeId}/hqdefault.jpg`}
                alt={episodioInicial.titulo}
                class="w-full h-full object-cover group-hover/screen:scale-105 transition-transform duration-500"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/20 group-hover/screen:from-black/60 transition-colors"></div>

              <!-- Botão Play Pulsante Central -->
              <div class="absolute inset-0 flex items-center justify-center">
                <button
                  type="button"
                  id="btn-play-trigger"
                  aria-label="Reproduzir vídeo agora"
                  class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#F15A29] group-hover/screen:bg-[#ff6f3d] text-white flex items-center justify-center shadow-2xl shadow-orange-950/70 transform group-hover/screen:scale-110 active:scale-95 transition-all cursor-pointer"
                >
                  <svg class="w-7 h-7 sm:w-9 sm:h-9 fill-current ml-1" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Iframe Container (oculto até o usuário dar play) -->
            <div id="player-iframe-wrapper" class="hidden absolute inset-0 w-full h-full bg-black">
              <iframe
                id="player-iframe"
                src=""
                class="w-full h-full"
                title="Player da Série Cuidando de Gente"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>

        <!-- Informações e Ações do Episódio Ativo -->
        <div class="lg:col-span-5 flex flex-col justify-between">
          <div>
            <!-- Badge do Equipamento -->
            <div class="flex items-center gap-2 mb-3">
              <span
                id="player-badge"
                class="px-4 py-1 rounded-full bg-orange-500/20 border border-orange-400/40 text-orange-300 text-xs font-bold uppercase tracking-wider whitespace-nowrap inline-flex items-center"
              >
                {episodioInicial.badge}
              </span>
            </div>

            <!-- Nome do Personagem -->
            <h3
              id="player-personagem"
              class="font-display text-2xl sm:text-3xl lg:text-4xl font-black italic text-white leading-tight mb-3"
            >
              {episodioInicial.personagem}
            </h3>

            <!-- Frase de Impacto -->
            <blockquote
              id="player-frase"
              class="font-sans text-sm sm:text-base text-blue-100 font-semibold italic border-l-2 border-[#F15A29] pl-3 mb-4 leading-relaxed"
            >
              "{episodioInicial.fraseImpacto}"
            </blockquote>

            <!-- Sinopse -->
            <p
              id="player-sinopse"
              class="font-sans text-sm sm:text-[15px] text-white/90 leading-relaxed mb-6 font-normal"
            >
              {episodioInicial.sinopse}
            </p>
          </div>

          <!-- Botões de Ação -->
          <div class="flex items-center gap-3 flex-wrap">
            <a
              id="player-yt-link"
              href={episodioInicial.youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-red-600 hover:bg-red-700 text-white font-sans text-xs sm:text-sm font-bold shadow-lg shadow-red-950/40 hover:scale-105 active:scale-95 transition-all"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <span>Assistir no YouTube</span>
            </a>
          </div>

        </div>

      </div>
    </div>

    <!-- ======================================================== -->
    <!-- PLAYLIST / RÉGUA HORIZONTAL DESLIZANTE DE EPISÓDIOS      -->
    <!-- ======================================================== -->
    <div class="max-w-6xl mx-auto">
      
      <!-- Cabeçalho da Playlist com Controles Desktop -->
      <div class="flex items-center justify-between gap-4 mb-3 sm:mb-4">
        <div>
          <h3 class="font-display text-lg sm:text-xl font-black italic text-[#123F8F]">
            CONHEÇA TODAS AS HISTÓRIAS
          </h3>
          <p class="font-sans text-xs text-slate-500 font-medium">
            Toque em qualquer episódio para carregar
          </p>
        </div>

        <!-- Controles de Navegação Desktop -->
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-slate-500 hidden sm:inline mr-2">
            {EPISODIOS_SERIE.length} Episódios
          </span>
          <button
            id="playlist-prev"
            type="button"
            aria-label="Voltar histórias"
            class="p-2 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white transition-all cursor-pointer shadow-xs"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            id="playlist-next"
            type="button"
            aria-label="Avançar histórias"
            class="p-2 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white transition-all cursor-pointer shadow-xs"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Trilho Horizontal Deslizante com Miniaturas Compactas -->
      <div
        id="playlist-track"
        class="flex gap-4 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory scroll-smooth hide-scrollbar -mx-4 sm:mx-0 px-4 sm:px-0"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {EPISODIOS_SERIE.map((ep, index) => {
          const isPrimeiro = index === 0;
          return (
            <button
              type="button"
              class={`playlist-item snap-start shrink-0 w-64 sm:w-72 text-left rounded-2xl border-2 transition-all p-3 bg-white cursor-pointer select-none group/item ${
                isPrimeiro
                  ? 'border-[#F15A29] ring-2 ring-[#F15A29]/20 shadow-md'
                  : 'border-slate-200/90 hover:border-slate-300 shadow-xs'
              }`}
              data-id={ep.id}
              data-youtube-id={ep.youtubeId}
              data-youtube-url={ep.youtubeUrl}
              data-personagem={ep.personagem}
              data-titulo={ep.titulo}
              data-frase={ep.fraseImpacto}
              data-sinopse={ep.sinopse}
              data-badge={ep.badge}
              data-index={index}
            >
              <!-- Thumbnail 16:9 -->
              <div class="relative aspect-video rounded-xl overflow-hidden bg-slate-900 mb-2">
                <img
                  src={`https://img.youtube.com/vi/${ep.youtubeId}/hqdefault.jpg`}
                  alt={ep.titulo}
                  class="w-full h-full object-cover group-hover/item:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-black/25 group-hover/item:bg-black/10 transition-colors"></div>

                <!-- Selo de status do card -->
                <div class="absolute top-1.5 left-1.5">
                  <span class={`playlist-status-tag px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                    isPrimeiro ? 'bg-[#F15A29] text-white shadow-sm' : 'bg-black/70 text-white/90 backdrop-blur-xs'
                  }`}>
                    {isPrimeiro ? 'Em exibição' : `Vídeo #${index + 1}`}
                  </span>
                </div>

                <!-- Ícone Play Mini -->
                <div class="absolute bottom-1.5 right-1.5 w-6 h-6 rounded-full bg-[#F15A29] text-white flex items-center justify-center shadow-md">
                  <svg class="w-3 h-3 fill-current ml-0.5" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
              </div>

              <!-- Dados Compactos do Card -->
              <div class="flex flex-col">
                <span class="inline-flex items-center text-[11px] font-bold text-[#F15A29] uppercase tracking-wide whitespace-nowrap">
                  {ep.badge}
                </span>
                <h4 class="font-display text-sm font-black italic text-[#123F8F] leading-tight truncate group-hover/item:text-[#F15A29] transition-colors mt-0.5">
                  {ep.personagem}
                </h4>
                <p class="font-sans text-xs text-slate-600 mt-1 leading-snug font-normal min-h-[2.5rem]">
                  {ep.chamadaPlaylist}
                </p>
              </div>
            </button>
          );
        })}
      </div>

    </div>

  </div>
</section>

<!-- ======================================================== -->
<!-- SCRIPT INTERATIVO DO HUB DE STREAMING                    -->
<!-- ======================================================== -->
<script>
  function setupSerieHub() {
    const poster = document.getElementById('player-poster');
    const posterImg = document.getElementById('player-poster-img') as HTMLImageElement;
    const iframeWrapper = document.getElementById('player-iframe-wrapper');
    const iframe = document.getElementById('player-iframe') as HTMLIFrameElement;
    const btnPlayTrigger = document.getElementById('btn-play-trigger');

    const badgeEl = document.getElementById('player-badge');
    const personagemEl = document.getElementById('player-personagem');
    const fraseEl = document.getElementById('player-frase');
    const sinopseEl = document.getElementById('player-sinopse');
    const ytLinkEl = document.getElementById('player-yt-link') as HTMLAnchorElement;

    const playlistTrack = document.getElementById('playlist-track');
    const playlistItems = document.querySelectorAll<HTMLButtonElement>('.playlist-item');
    const btnPrev = document.getElementById('playlist-prev');
    const btnNext = document.getElementById('playlist-next');

    let isPlaying = false;
    let currentYtId = playlistItems[0]?.getAttribute('data-youtube-id') || '';

    // Função para iniciar reprodução no iframe embutido
    function startVideo(ytId: string) {
      if (!iframe || !iframeWrapper || !poster) return;
      currentYtId = ytId;
      iframe.src = `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&rel=0`;
      poster.classList.add('hidden');
      iframeWrapper.classList.remove('hidden');
      isPlaying = true;
    }

    // Função para selecionar episódio da playlist
    function selectEpisode(item: HTMLButtonElement, autoPlay = false) {
      const ytId = item.getAttribute('data-youtube-id') || '';
      const ytUrl = item.getAttribute('data-youtube-url') || '';
      const personagem = item.getAttribute('data-personagem') || '';
      const frase = item.getAttribute('data-frase') || '';
      const sinopse = item.getAttribute('data-sinopse') || '';
      const badge = item.getAttribute('data-badge') || '';
      const index = item.getAttribute('data-index') || '0';

      // Atualiza textos e links
      if (badgeEl) badgeEl.textContent = badge;
      if (personagemEl) personagemEl.textContent = personagem;
      if (fraseEl) fraseEl.textContent = `"${frase}"`;
      if (sinopseEl) sinopseEl.textContent = sinopse;
      if (ytLinkEl) ytLinkEl.href = ytUrl;

      // Atualiza o poster da miniatura
      if (posterImg) {
        posterImg.src = `https://img.youtube.com/vi/${ytId}/hqdefault.jpg`;
      }

      // Se já estava tocando ou foi solicitado autoPlay, troca o vídeo do iframe
      if (isPlaying || autoPlay) {
        startVideo(ytId);
      }

      // Atualiza estilização da playlist
      playlistItems.forEach((btn) => {
        const isCurrent = btn === item;
        const tag = btn.querySelector('.playlist-status-tag');
        const bIndex = btn.getAttribute('data-index') || '';

        if (isCurrent) {
          btn.className = 'playlist-item snap-start shrink-0 w-64 sm:w-72 text-left rounded-2xl border-2 transition-all p-3 bg-white cursor-pointer select-none group/item border-[#F15A29] ring-2 ring-[#F15A29]/20 shadow-md';
          if (tag) {
            tag.className = 'playlist-status-tag px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-[#F15A29] text-white shadow-sm';
            tag.textContent = 'Em exibição';
          }
        } else {
          btn.className = 'playlist-item snap-start shrink-0 w-64 sm:w-72 text-left rounded-2xl border-2 transition-all p-3 bg-white cursor-pointer select-none group/item border-slate-200/90 hover:border-slate-300 shadow-xs';
          if (tag) {
            tag.className = 'playlist-status-tag px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-black/70 text-white/90 backdrop-blur-xs';
            tag.textContent = `Vídeo #${Number(bIndex) + 1}`;
          }
        }
      });

      // Rola a playlist sutilmente para manter o item selecionado visível
      item.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

    // Clique no poster ou no botão Play central
    poster?.addEventListener('click', () => {
      startVideo(currentYtId);
    });

    btnPlayTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      startVideo(currentYtId);
    });

    // Cliques nos itens da playlist
    playlistItems.forEach((item) => {
      item.addEventListener('click', () => {
        selectEpisode(item, false);
      });
    });

    // Controles de navegação da playlist
    if (playlistTrack && btnPrev && btnNext) {
      btnPrev.addEventListener('click', () => {
        playlistTrack.scrollBy({ left: -280, behavior: 'smooth' });
      });

      btnNext.addEventListener('click', () => {
        playlistTrack.scrollBy({ left: 280, behavior: 'smooth' });
      });
    }
  }

  setupSerieHub();
  document.addEventListener('astro:page-load', setupSerieHub);
</script>
