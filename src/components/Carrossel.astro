---
// src/components/Carrossel.astro
// Carrossel horizontal deslizante com efeito Peek e cards brancos sombreados
import { ENTREGAS } from '../data/entregas';
import CardEntrega from './CardEntrega.astro';

interface Props {
  apenasDestaques?: boolean;
}

const { apenasDestaques = true } = Astro.props;
const lista = apenasDestaques ? ENTREGAS.filter((e) => e.destaque) : ENTREGAS;
---

<div class="relative w-full">
  
  <!-- Controles & Indicador Superior Desktop -->
  <div class="flex items-center justify-between gap-4 mb-6">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span>Unidades em pleno funcionamento</span>
    </div>

    <!-- Botões de Navegação -->
    <div class="hidden sm:flex items-center gap-2.5">
      <button
        id="carrossel-prev"
        aria-label="Voltar entrega anterior"
        class="p-3 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white hover:border-[#123F8F] shadow-sm hover:shadow-md transition-all active:scale-95 cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        id="carrossel-next"
        aria-label="Avançar próxima entrega"
        class="p-3 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white hover:border-[#123F8F] shadow-sm hover:shadow-md transition-all active:scale-95 cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Trilho do Carrossel com Efeito Peek (próximo card visível cortado na lateral) -->
  <div class="relative">
    <!-- Fade suave na borda direita em telas maiores para indicar continuidade -->
    <div class="pointer-events-none absolute right-0 top-0 bottom-8 w-20 sm:w-28 bg-gradient-to-l from-white to-transparent z-10 hidden md:block"></div>

    <div
      id="carrossel-track"
      class="flex gap-6 overflow-x-auto pb-8 pt-2 snap-x snap-mandatory scroll-smooth hide-scrollbar -mx-4 sm:mx-0 px-4 sm:px-0"
      style="scrollbar-width: none; -ms-overflow-style: none;"
    >
      {lista.map((entrega) => (
        <div class="snap-start shrink-0 w-[84vw] sm:w-[370px] lg:w-[410px]">
          <CardEntrega entrega={entrega} />
        </div>
      ))}
    </div>
  </div>

  <!-- Dica de Deslize no Celular -->
  <div class="sm:hidden flex items-center justify-center gap-2 mt-2 text-xs font-semibold text-slate-400">
    <svg class="w-4 h-4 text-[#F15A29] animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
    <span>Arraste para o lado para ver mais entregas</span>
  </div>
</div>

<script>
  const track = document.getElementById('carrossel-track');
  const btnPrev = document.getElementById('carrossel-prev');
  const btnNext = document.getElementById('carrossel-next');

  if (track && btnPrev && btnNext) {
    btnPrev.addEventListener('click', () => {
      track.scrollBy({ left: -400, behavior: 'smooth' });
    });
    btnNext.addEventListener('click', () => {
      track.scrollBy({ left: 400, behavior: 'smooth' });
    });
  }
</script>
