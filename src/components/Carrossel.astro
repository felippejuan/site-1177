---
// src/components/Carrossel.astro
// Carrossel horizontal deslizante com efeito Peek e modal integrado de vídeo vertical
import { ENTREGAS } from '../data/entregas';
import CardEntrega from './CardEntrega.astro';

interface Props {
  apenasDestaques?: boolean;
}

const { apenasDestaques = true } = Astro.props;
const lista = apenasDestaques ? ENTREGAS.filter((e) => e.destaque) : ENTREGAS;
---

<div class="relative w-full">
  
  <!-- Controles & Indicador Superior Desktop -->
  <div class="flex items-center justify-between gap-4 mb-6">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span>Unidades em pleno funcionamento</span>
    </div>

    <!-- Botões de Navegação -->
    <div class="hidden sm:flex items-center gap-2.5">
      <button
        id="carrossel-prev"
        aria-label="Voltar entrega anterior"
        class="p-3 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white hover:border-[#123F8F] shadow-sm hover:shadow-md transition-all active:scale-95 cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        id="carrossel-next"
        aria-label="Avançar próxima entrega"
        class="p-3 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white hover:border-[#123F8F] shadow-sm hover:shadow-md transition-all active:scale-95 cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Trilho do Carrossel com Efeito Peek (próximo card visível cortado na lateral) -->
  <div class="relative">
    <!-- Fade suave na borda direita em telas maiores para indicar continuidade -->
    <div class="pointer-events-none absolute right-0 top-0 bottom-8 w-20 sm:w-28 bg-gradient-to-l from-white to-transparent z-10 hidden md:block"></div>

    <div
      id="carrossel-track"
      class="flex gap-6 overflow-x-auto pb-8 pt-2 snap-x snap-mandatory scroll-smooth hide-scrollbar -mx-4 sm:mx-0 px-4 sm:px-0"
      style="scrollbar-width: none; -ms-overflow-style: none;"
    >
      {lista.map((entrega) => (
        <div class="snap-start shrink-0 w-[76vw] sm:w-[320px] lg:w-[350px]">
          <CardEntrega entrega={entrega} />
        </div>
      ))}
    </div>
  </div>

  <!-- Dica de Deslize no Celular -->
  <div class="sm:hidden flex items-center justify-center gap-2 mt-2 text-xs font-semibold text-slate-400">
    <svg class="w-4 h-4 text-[#F15A29] animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
    <span>Arraste para o lado para ver mais entregas</span>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL DE VÍDEO VERTICAL (Reels/Stories 9:16)              -->
  <!-- ======================================================== -->
  <div
    id="modal-video-entrega"
    class="fixed inset-0 z-[999] hidden bg-black/85 backdrop-blur-md flex items-center justify-center p-4 transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Vídeo da Entrega"
  >
    <div class="relative w-full max-w-[340px] aspect-[9/16] rounded-[2rem] bg-black border border-white/20 shadow-2xl overflow-hidden flex items-center justify-center">
      
      <!-- Botão Fechar -->
      <button
        id="btn-close-modal-video"
        type="button"
        aria-label="Fechar vídeo"
        class="absolute top-4 right-4 z-40 w-10 h-10 rounded-full bg-black/60 hover:bg-[#F15A29] text-white flex items-center justify-center border border-white/30 backdrop-blur-sm transition-colors cursor-pointer"
      >
        <svg class="w-5 h-5 fill-none stroke-current" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Badge no topo do modal -->
      <div class="absolute top-4 left-4 z-30 pointer-events-none">
        <span id="modal-video-badge" class="px-3 py-1 rounded-full text-[11px] font-bold bg-[#F15A29] text-white shadow-md">
          Vídeo da Entrega
        </span>
      </div>

      <!-- Player de Vídeo -->
      <video
        id="player-modal-video"
        class="w-full h-full object-cover"
        controls
        playsinline
        preload="none"
      >
        <source id="source-modal-video" src="" type="video/mp4" />
        Seu navegador não suporta reprodução de vídeo.
      </video>
    </div>
  </div>
</div>

<script>
  // Navegação do Carrossel
  const track = document.getElementById('carrossel-track');
  const btnPrev = document.getElementById('carrossel-prev');
  const btnNext = document.getElementById('carrossel-next');

  if (track && btnPrev && btnNext) {
    btnPrev.addEventListener('click', () => {
      track.scrollBy({ left: -340, behavior: 'smooth' });
    });
    btnNext.addEventListener('click', () => {
      track.scrollBy({ left: 340, behavior: 'smooth' });
    });
  }

  // Lógica do Modal de Vídeo no Carrossel
  const modal = document.getElementById('modal-video-entrega');
  if (modal && modal.parentElement !== document.body) {
    document.body.appendChild(modal);
  }
  const player = document.getElementById('player-modal-video') as HTMLVideoElement | null;
  const source = document.getElementById('source-modal-video') as HTMLSourceElement | null;
  const badge = document.getElementById('modal-video-badge');
  const btnClose = document.getElementById('btn-close-modal-video');

  function openVideoModal(videoSrc: string, title: string) {
    if (!modal || !player || !source) return;
    source.src = videoSrc;
    player.load();
    if (badge) badge.textContent = title;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    player.play();
  }

  function closeVideoModal() {
    if (!modal || !player) return;
    player.pause();
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('[data-open-video]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-open-video');
      const title = btn.getAttribute('data-video-title') || 'Vídeo da Entrega';
      if (src && src.trim() !== '') {
        openVideoModal(src, title);
      }
    });
  });

  if (btnClose) btnClose.addEventListener('click', closeVideoModal);
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeVideoModal();
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeVideoModal();
  });
</script>
