---
// src/components/Carrossel.astro
// Carrossel horizontal deslizante (touch snap) anti-scroll
import { ENTREGAS } from '../data/entregas';
import CardEntrega from './CardEntrega.astro';

interface Props {
  apenasDestaques?: boolean;
}

const { apenasDestaques = true } = Astro.props;
const lista = apenasDestaques ? ENTREGAS.filter((e) => e.destaque) : ENTREGAS;
---

<div class="relative w-full">
  <!-- Controles de Navegação Desktop -->
  <div class="hidden sm:flex items-center justify-end gap-3 mb-4">
    <button
      id="carrossel-prev"
      aria-label="Voltar entrega anterior"
      class="p-2.5 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white hover:border-[#123F8F] transition-all shadow-sm active:scale-95 cursor-pointer"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      id="carrossel-next"
      aria-label="Avançar próxima entrega"
      class="p-2.5 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white hover:border-[#123F8F] transition-all shadow-sm active:scale-95 cursor-pointer"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>

  <!-- Trilho do Carrossel com Scroll-Snap -->
  <div
    id="carrossel-track"
    class="flex gap-6 overflow-x-auto pb-6 pt-2 px-1 snap-x snap-mandatory scroll-smooth hide-scrollbar -mx-4 sm:mx-0 px-4 sm:px-0"
    style="scrollbar-width: none; -ms-overflow-style: none;"
  >
    {lista.map((entrega) => (
      <div class="snap-start shrink-0 w-[85vw] sm:w-[380px] md:w-[420px] max-w-[420px]">
        <CardEntrega entrega={entrega} />
      </div>
    ))}
  </div>

  <!-- Dica de Deslize no Celular -->
  <div class="sm:hidden flex items-center justify-center gap-2 mt-2 text-xs font-semibold text-slate-400">
    <svg class="w-4 h-4 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
    </svg>
    <span>Deslize para o lado para ver mais</span>
  </div>
</div>

<script>
  const track = document.getElementById('carrossel-track');
  const btnPrev = document.getElementById('carrossel-prev');
  const btnNext = document.getElementById('carrossel-next');

  if (track && btnPrev && btnNext) {
    btnPrev.addEventListener('click', () => {
      track.scrollBy({ left: -380, behavior: 'smooth' });
    });
    btnNext.addEventListener('click', () => {
      track.scrollBy({ left: 380, behavior: 'smooth' });
    });
  }
</script>
