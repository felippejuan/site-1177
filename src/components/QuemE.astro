---
// src/components/QuemE.astro
// Seção Trajetória de Dr. Luizinho — Slideshow Orgânico de Fotos Reais no Topo e Fundo Azul
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

interface FotoItem {
  id: number;
  src: string;
  alt: string;
  titulo: string;
  descricao: string;
  contexto: string;
}

const fotos: FotoItem[] = [
  {
    id: 1,
    src: `${baseUrl}/biografia/1.png`,
    alt: "Crachá histórico do Ministério da Saúde de Dr. Luizinho no Hospital Geral de Nova Iguaçu (Posse)",
    titulo: "Interno no Hospital Geral da Posse",
    descricao: "Registro oficial no HGNI / Ministério da Saúde. A vocação médica nasceu na linha de frente do atendimento público no SUS.",
    contexto: "HGNI · Ministério da Saúde"
  },
  {
    id: 2,
    src: `${baseUrl}/biografia/2.png`,
    alt: "Dr. Luizinho realizando exame clínico direto em paciente na unidade de saúde pública",
    titulo: "Atendimento Clínico Humanizado",
    descricao: "Examinando pessoalmente cada paciente. A medicina exercida com escuta sensível, cuidado e respeito às famílias.",
    contexto: "Nova Iguaçu · Atendimento SUS"
  },
  {
    id: 3,
    src: `${baseUrl}/biografia/3.png`,
    alt: "Dr. Luizinho em consulta médica orientando paciente idosa com receituário e carimbo",
    titulo: "Atenção e Escuta Olho no Olho",
    descricao: "Receituário na mão e carimbo na mesa: ouvindo as famílias para orientar o diagnóstico e garantir o tratamento digno.",
    contexto: "Consulta Médica · Saúde Pública"
  },
  {
    id: 4,
    src: `${baseUrl}/biografia/4.png`,
    alt: "Dr. Luizinho abraçando cidadão na campanha de vacinação contra febre amarela",
    titulo: "Ao Lado da População nas Ruas",
    descricao: "Presença direta nos bairros e acolhimento humano durante a grande mobilização preventiva contra a febre amarela.",
    contexto: "Campanha em Campo · Saúde Pública"
  },
  {
    id: 5,
    src: `${baseUrl}/biografia/5.png`,
    alt: "Registro histórico: Dr. Luizinho aplicando uma das primeiras vacinas contra a Covid-19 no Brasil na Dra. Socorro Gross, Presidente da OPAS",
    titulo: "Vacina para o Brasil na Pandemia",
    descricao: "Como Presidente da Comissão Externa de Enfrentamento à Covid-19 na Câmara, trabalhou todos os dias para trazer a vacina para o Brasil. Registro histórico aplicando uma das primeiras doses no país na Dra. Socorro Gross, presidente da OPAS no Brasil e autoridade mundial em saúde.",
    contexto: "Vacinação Covid-19 · OPAS / Brasil"
  }
];
---

<section id="trajetoria" class="relative bg-[#071738] text-white overflow-hidden pb-12 sm:pb-16 md:pb-20 border-b border-slate-900">
  <div id="quem-e" class="absolute -top-24 pointer-events-none"></div>

  <!-- Topo: Slideshow de Fotos Históricas da Trajetória (Ocupando Toda a Largura de Ponta a Ponta e Teto Superior) -->
  <div id="trajetoria-slideshow" class="relative w-full h-80 sm:h-96 md:h-[460px] lg:h-[520px] overflow-hidden select-none bg-[#071738]">
    
    {fotos.map((foto, index) => (
      <div
        class={`trajetoria-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${
          index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'
        }`}
        data-index={index}
      >
        <!-- Foto de Ponta a Ponta, do Teto Superior à Base, sem bordas ou molduras -->
        <img
          src={foto.src}
          alt={foto.alt}
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
          class="w-full h-full object-cover object-[center_20%] sm:object-[center_25%] filter contrast-105"
        />
      </div>
    ))}

    <!-- Gradiente sutil no topo para acabamento suave -->
    <div class="absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-black/25 to-transparent pointer-events-none z-10"></div>

    <!-- Gradiente na base que começa mais embaixo para revelar muito mais a foto -->
    <div class="absolute inset-x-0 bottom-0 h-24 sm:h-32 md:h-40 bg-gradient-to-t from-[#071738] via-[#071738]/85 to-transparent pointer-events-none z-10"></div>

    <!-- Indicadores de Paginação Discretos no Topo Direito (Completamente afastados do centro e do título) -->
    <div class="absolute top-5 right-5 sm:top-6 sm:right-8 z-20 flex items-center gap-1.5 bg-black/50 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/15 pointer-events-auto shadow-lg">
      {fotos.map((_, index) => (
        <button
          type="button"
          class={`trajetoria-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer ${
            index === 0 ? 'w-5 bg-[#F15A29]' : 'w-1.5 bg-white/40 hover:bg-white/70'
          }`}
          data-index={index}
          aria-label={`Foto ${index + 1}`}
        />
      ))}
    </div>

  </div>

  <!-- Conteúdo Central: Título TRAJETÓRIA + 3 Pilares em Grid de 3 Colunas -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 sm:-mt-10 md:-mt-12 relative z-20">
    
    <!-- Título Monumental: UMA VIDA DEDICADA A CUIDAR DE PESSOAS -->
    <div class="max-w-4xl mx-auto text-center mb-10 sm:mb-14">
      <h2 class="font-display text-4xl sm:text-6xl lg:text-7xl font-black italic tracking-tight leading-tight mb-3 drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)]">
        <span class="text-white">UMA VIDA DEDICADA</span> <br />
        <span class="text-[#F15A29]">A CUIDAR DE PESSOAS</span>
      </h2>
      <p class="font-sans text-base sm:text-lg text-blue-100 font-medium leading-relaxed max-w-3xl mx-auto">
        Da linha de frente nos plantões do SUS à aprovação de leis históricas no Congresso Nacional. Conheça a trajetória do Doutor Luizinho: o médico, o gestor e o líder.
      </p>
    </div>

    <!-- Abas / Segmented Control no Mobile (Opção 2: Pílulas Interativas) -->
    <div class="md:hidden max-w-md mx-auto mb-4 p-1.5 rounded-2xl bg-[#091b40]/90 border border-white/15 backdrop-blur-md flex gap-1 sm:gap-1.5 shadow-xl">
      <button
        type="button"
        class="pilar-tab-btn flex-1 py-2 px-1 sm:px-2 text-center rounded-xl text-[11px] min-[360px]:text-xs font-bold transition-all duration-200 cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 whitespace-nowrap bg-[#F15A29] text-white shadow-md shadow-[#F15A29]/30"
        data-index="0"
        aria-selected="true"
      >
        <span class="text-orange-200 font-mono">1</span>
        <span>O Médico</span>
      </button>
      <button
        type="button"
        class="pilar-tab-btn flex-1 py-2 px-1 sm:px-2 text-center rounded-xl text-[11px] min-[360px]:text-xs font-semibold transition-all duration-200 cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 whitespace-nowrap text-blue-200 hover:text-white hover:bg-white/10"
        data-index="1"
        aria-selected="false"
      >
        <span class="opacity-70 font-mono">2</span>
        <span>O Gestor</span>
      </button>
      <button
        type="button"
        class="pilar-tab-btn flex-1 py-2 px-1 sm:px-2 text-center rounded-xl text-[11px] min-[360px]:text-xs font-semibold transition-all duration-200 cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 whitespace-nowrap text-blue-200 hover:text-white hover:bg-white/10"
        data-index="2"
        aria-selected="false"
      >
        <span class="opacity-70 font-mono">3</span>
        <span>O Líder</span>
      </button>
    </div>

    <!-- 3 Pilares Fundamentais: Card Ativo no Mobile com Transição / Grid 3 Colunas no Desktop -->
    <div id="pilares-container" class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 mb-4 md:mb-16">
      
      <!-- Card 01: Medicina -->
      <div id="pilar-0" class="pilar-card flex md:!flex flex-col justify-between p-7 sm:p-8 rounded-3xl bg-[#112758]/90 backdrop-blur-md border border-white/10 shadow-2xl hover:border-[#F15A29]/50 transition-all duration-300 group">
        <div>
          <div class="mb-3">
            <span class="text-xs font-bold text-orange-300 uppercase tracking-wider">
              O CUIDADO COMO VOCAÇÃO
            </span>
          </div>
          <h3 class="font-display text-2xl sm:text-3xl font-black italic text-white mb-3 leading-tight group-hover:text-[#F15A29] transition-colors">
            O Médico
          </h3>
          <p class="font-sans text-[15px] sm:text-base text-white/95 leading-relaxed mb-6 font-medium">
            Sua trajetória começou com uma bolsa integral na faculdade de Medicina, passou pela especialização em Ortopedia e Traumatologia e se consolidou com um MBA Executivo na COPPEAD-UFRJ. Mas foi enfrentando a dura realidade dos plantões nas emergências públicas que ele encontrou seu maior propósito: trabalhar para cuidar, defender e melhorar a saúde da nossa gente.
          </p>
        </div>
        <div class="pt-4 border-t border-white/10 text-xs sm:text-sm font-semibold text-white flex items-center gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Uma experiência real de SUS: não apenas para diagnosticar, mas para transformar.</span>
        </div>
      </div>

      <!-- Card 02: Gestão -->
      <div id="pilar-1" class="pilar-card hidden md:!flex flex-col justify-between p-7 sm:p-8 rounded-3xl bg-[#112758]/90 backdrop-blur-md border border-white/10 shadow-2xl hover:border-[#F15A29]/50 transition-all duration-300 group">
        <div>
          <div class="mb-3">
            <span class="text-xs font-bold text-orange-300 uppercase tracking-wider">
              CORAGEM, CAPACIDADE E ENTREGA
            </span>
          </div>
          <h3 class="font-display text-2xl sm:text-3xl font-black italic text-white mb-3 leading-tight group-hover:text-[#F15A29] transition-colors">
            O Gestor
          </h3>
          <p class="font-sans text-[15px] sm:text-base text-white/95 leading-relaxed mb-6 font-medium">
            A verdadeira capacidade de um gestor se prova na crise. Ele assumiu a saúde fluminense quando o Rio de Janeiro enfrentava um colapso financeiro e decretava estado de calamidade pública. Onde havia crise, entregou gestão: inaugurou clínicas da família, UPAs, novos hospitais e ergueu o maior centro de diagnóstico por imagem da América Latina. Sob seu comando, o SAMU chegou a todos os municípios do estado.
          </p>
        </div>
        <div class="pt-4 border-t border-white/10 text-xs sm:text-sm font-semibold text-white flex items-center gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Uma gestão que venceu a crise, salvou vidas e se tornou referência nacional.</span>
        </div>
      </div>

      <!-- Card 03: Mandato -->
      <div id="pilar-2" class="pilar-card hidden md:!flex flex-col justify-between p-7 sm:p-8 rounded-3xl bg-[#112758]/90 backdrop-blur-md border border-white/10 shadow-2xl hover:border-[#F15A29]/50 transition-all duration-300 group">
        <div>
          <div class="mb-3">
            <span class="text-xs font-bold text-orange-300 uppercase tracking-wider">
              LIDERANÇA E IMPACTO NACIONAL
            </span>
          </div>
          <h3 class="font-display text-2xl sm:text-3xl font-black italic text-white mb-3 leading-tight group-hover:text-[#F15A29] transition-colors">
            O Líder
          </h3>
          <p class="font-sans text-[15px] sm:text-base text-white/95 leading-relaxed mb-6 font-medium">
            Ele levou a vivência dos plantões e a capacidade de gestão para Brasília. No Congresso Nacional, transformou o conhecimento da linha de frente em leis que protegem milhões de brasileiros. No momento mais crítico da nossa história, presidiu a Comissão de Enfrentamento à Covid-19 e viabilizou a chegada da vacina ao país. Em apenas 2 mandatos, já articulou vitórias fundamentais, como a defesa inegociável do SUS, a autonomia farmacêutica nacional, a valorização dos profissionais de saúde e a renegociação da dívida dos Estados.
          </p>
        </div>
        <div class="pt-4 border-t border-white/10 text-xs sm:text-sm font-semibold text-white flex items-center gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Do Rio para o Brasil: a trajetória de quem colocou a vida das pessoas no centro das decisões.</span>
        </div>
      </div>

    </div>

    <!-- Navegação Mobile dos 3 Pilares (Anterior / Dots / Próximo) -->
    <div class="md:hidden flex items-center justify-between text-xs text-blue-200/90 mb-12 px-2">
      <button
        id="pilar-prev"
        type="button"
        class="flex items-center gap-1.5 text-slate-200 hover:text-white active:scale-95 transition-all cursor-pointer py-1.5 px-3 rounded-xl bg-white/10 border border-white/15 backdrop-blur-sm"
        aria-label="Ver pilar anterior"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
        </svg>
        <span>Anterior</span>
      </button>

      <div class="flex items-center gap-1.5">
        <span class="pilar-dot h-2 rounded-full transition-all duration-300 w-5 bg-[#F15A29]" data-index="0"></span>
        <span class="pilar-dot h-2 rounded-full transition-all duration-300 w-2 bg-white/20" data-index="1"></span>
        <span class="pilar-dot h-2 rounded-full transition-all duration-300 w-2 bg-white/20" data-index="2"></span>
      </div>

      <button
        id="pilar-next"
        type="button"
        class="flex items-center gap-1.5 text-slate-200 hover:text-white active:scale-95 transition-all cursor-pointer py-1.5 px-3 rounded-xl bg-white/10 border border-white/15 backdrop-blur-sm"
        aria-label="Ver próximo pilar"
      >
        <span>Próximo</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>

  </div>
</section>

<script>
  function setupTrajetoriaSlideshow() {
    const container = document.getElementById('trajetoria-slideshow');
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('.trajetoria-slide');
    const dots = container.querySelectorAll<HTMLElement>('.trajetoria-dot');
    const total = slides.length;
    if (total <= 1) return;

    let current = 0;
    let timer: any = null;

    function show(index: number) {
      current = (index + total) % total;
      slides.forEach((s, idx) => {
        if (idx === current) {
          s.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
          s.classList.add('opacity-100', 'z-10');
        } else {
          s.classList.remove('opacity-100', 'z-10');
          s.classList.add('opacity-0', 'z-0', 'pointer-events-none');
        }
      });

      dots.forEach((d, idx) => {
        if (idx === current) {
          d.className = 'trajetoria-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer w-5 bg-[#F15A29]';
        } else {
          d.className = 'trajetoria-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer w-1.5 bg-white/40 hover:bg-white/70';
        }
      });
    }

    function next() {
      show(current + 1);
    }

    function start() {
      if (timer) clearInterval(timer);
      timer = setInterval(next, 3500);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        show(idx);
        start();
      });
    });

    start();
  }

  function setupPilaresTabs() {
    const container = document.getElementById('pilares-container');
    const tabs = document.querySelectorAll<HTMLButtonElement>('.pilar-tab-btn');
    const cards = document.querySelectorAll<HTMLElement>('.pilar-card');
    const dots = document.querySelectorAll<HTMLElement>('.pilar-dot');
    const btnPrev = document.getElementById('pilar-prev');
    const btnNext = document.getElementById('pilar-next');

    if (!container || tabs.length === 0 || cards.length === 0) return;

    let activeIndex = 0;
    const total = cards.length;

    function setPilar(index: number) {
      activeIndex = (index + total) % total;

      // Atualiza botões das abas no mobile
      tabs.forEach((tab, idx) => {
        const isSelected = idx === activeIndex;
        tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        if (isSelected) {
          tab.className = 'pilar-tab-btn flex-1 py-2 px-1 sm:px-2 text-center rounded-xl text-[11px] min-[360px]:text-xs font-bold transition-all duration-200 cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 whitespace-nowrap bg-[#F15A29] text-white shadow-md shadow-[#F15A29]/30';
        } else {
          tab.className = 'pilar-tab-btn flex-1 py-2 px-1 sm:px-2 text-center rounded-xl text-[11px] min-[360px]:text-xs font-semibold transition-all duration-200 cursor-pointer flex items-center justify-center gap-1 sm:gap-1.5 whitespace-nowrap text-blue-200 hover:text-white hover:bg-white/10';
        }
      });

      // Atualiza visibilidade dos cards no mobile (no desktop mantêm md:!flex)
      cards.forEach((card, idx) => {
        if (idx === activeIndex) {
          card.classList.remove('hidden');
          card.classList.add('flex');
        } else {
          card.classList.remove('flex');
          card.classList.add('hidden');
        }
      });

      // Atualiza dots de navegação
      dots.forEach((dot, idx) => {
        if (idx === activeIndex) {
          dot.className = 'pilar-dot h-2 rounded-full transition-all duration-300 w-5 bg-[#F15A29]';
        } else {
          dot.className = 'pilar-dot h-2 rounded-full transition-all duration-300 w-2 bg-white/20';
        }
      });
    }

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => setPilar(idx));
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        setPilar(idx);
      });
    });

    btnPrev?.addEventListener('click', () => setPilar(activeIndex - 1));
    btnNext?.addEventListener('click', () => setPilar(activeIndex + 1));

    // Touch Swipe no mobile
    let touchStartX = 0;
    let touchStartY = 0;

    container.addEventListener('touchstart', (e) => {
      if (e.changedTouches && e.changedTouches[0]) {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      }
    }, { passive: true });

    container.addEventListener('touchend', (e) => {
      if (!e.changedTouches || !e.changedTouches[0]) return;
      const touchEndX = e.changedTouches[0].screenX;
      const touchEndY = e.changedTouches[0].screenY;
      const diffX = touchEndX - touchStartX;
      const diffY = touchEndY - touchStartY;

      // Detecta deslize horizontal intencional (> 40px)
      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
        if (diffX < 0) {
          setPilar(activeIndex + 1); // Deslize para esquerda -> próximo
        } else {
          setPilar(activeIndex - 1); // Deslize para direita -> anterior
        }
      }
    }, { passive: true });
  }

  function init() {
    setupTrajetoriaSlideshow();
    setupPilaresTabs();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>
