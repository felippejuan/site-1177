---
// src/components/LinhaDeBase.astro
// Comparador Antes x Depois — Narrativa de transformação e resolução histórica
import { LINHA_DE_BASE } from '../data/trajetoria';
---

<section id="linha-de-base" class="py-20 sm:py-28 bg-[#070A13] relative border-b border-white/[0.08] overflow-hidden">
  <!-- Luz ambiente de fundo -->
  <div class="absolute top-1/3 right-10 w-[500px] h-[500px] bg-blue-600/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Cabeçalho -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-300 font-sans text-xs font-semibold uppercase tracking-wider mb-4">
        Antes × Depois
      </span>
      <h2 class="font-display text-3xl sm:text-5xl font-black italic tracking-tight text-white leading-tight mb-4">
        O RETRATO DO ABANDONO <span class="text-[#F15A29]">× A TRANSFORMAÇÃO REAL</span>
      </h2>
      <p class="font-sans text-base sm:text-lg text-slate-300">
        O contraste real entre a negligência histórica que a população fluminense enfrentava e as soluções concretas entregues pelo Dr. Luizinho.
      </p>
    </div>

    <!-- Grade dos 4 Pares -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {LINHA_DE_BASE.map((item) => (
        <div class="rounded-3xl border border-white/[0.08] bg-[#0D1424]/90 shadow-2xl overflow-hidden flex flex-col justify-between hover:border-white/15 transition-all duration-300">
          
          <!-- Cabeçalho do Card -->
          <div class="bg-white/[0.03] p-6 border-b border-white/[0.06] flex items-center justify-between">
            <h3 class="font-display text-2xl font-black italic text-white">
              {item.titulo}
            </h3>
            <span class="text-xs font-bold text-orange-400 uppercase tracking-wider px-2.5 py-1 rounded bg-orange-500/10 border border-orange-500/20">
              Transformação SUS
            </span>
          </div>

          <!-- Comparação Empilhada -->
          <div class="p-6 sm:p-7 space-y-5 flex-grow flex flex-col justify-between">
            
            <!-- Como Recebeu (Antes) -->
            <div class="p-5 rounded-2xl bg-rose-950/20 border border-rose-500/20">
              <div class="flex items-center gap-2 text-xs font-bold text-rose-400 uppercase tracking-wider mb-2">
                <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                <span>Como Estava Antes (Inércia e Descaso)</span>
              </div>
              <p class="font-sans text-sm sm:text-base text-slate-200 leading-relaxed font-medium">
                {item.comoRecebeu}
              </p>
            </div>

            <!-- O Que Fez (Depois) -->
            <div class="p-5 rounded-2xl bg-emerald-950/20 border border-emerald-500/20">
              <div class="flex items-center gap-2 text-xs font-bold text-emerald-400 uppercase tracking-wider mb-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span>O Que Dr. Luizinho Entregou (Solução Concreta)</span>
              </div>
              <p class="font-sans text-sm sm:text-base text-white font-medium leading-relaxed">
                {item.oQueFez}
              </p>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>
