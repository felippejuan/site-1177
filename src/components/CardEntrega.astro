---
// src/components/CardEntrega.astro
import type { Entrega } from '../data/entregas';
import Carimbo from './Carimbo.astro';

interface Props {
  entrega: Entrega;
}

const { entrega } = Astro.props;
const numeroPrincipal = entrega.numeros[0];
---

<article class="flex flex-col justify-between h-full bg-[#0D1424]/95 border border-white/[0.08] shadow-2xl shadow-black/80 hover:shadow-black hover:border-[#F15A29]/40 rounded-3xl p-7 transition-all duration-300 relative overflow-hidden group">
  <!-- Tarja superior de iluminação perimetral -->
  <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-blue-600 via-[#F15A29] to-orange-400 opacity-60 group-hover:opacity-100 transition-opacity"></div>

  <div>
    <!-- Top Header: Município & Badge -->
    <div class="flex items-center justify-between gap-2 mb-5 flex-wrap">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/[0.06] text-slate-300 border border-white/[0.08]">
        {entrega.municipioPrincipal}
      </span>
      {entrega.badge && (
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-[#F15A29]/15 text-[#F15A29] border border-[#F15A29]/30 uppercase tracking-wide">
          ★ {entrega.badge}
        </span>
      )}
    </div>

    <!-- Métrica Principal em Destaque Monumental -->
    <div class="mb-4">
      <span class="font-display text-4xl sm:text-5xl font-black italic text-[#F15A29] leading-none tracking-tight block">
        {numeroPrincipal.valor}
      </span>
      <span class="font-sans text-xs text-slate-400 font-medium uppercase tracking-wider">
        {numeroPrincipal.rotulo}
      </span>
    </div>

    <!-- Título da Entrega -->
    <h3 class="font-display text-2xl sm:text-3xl font-black italic tracking-tight text-white leading-tight mb-2 group-hover:text-orange-300 transition-colors">
      {entrega.nome}
    </h3>
    <p class="font-sans text-xs font-medium text-slate-400 mb-5">
      {entrega.subtitulo}
    </p>

    <!-- As 3 Frases Canônicas: Fato -> Dado -> Impacto Humano -->
    <div class="space-y-3 font-sans text-sm text-slate-300 leading-relaxed mb-6">
      <p class="font-normal text-slate-300 leading-snug">
        {entrega.fraseOQueE}
      </p>

      <div class="p-3.5 rounded-xl bg-white/[0.03] border-l-2 border-[#F15A29] text-slate-200 font-medium text-xs">
        {entrega.fraseNumero}
      </div>

      <p class="text-xs text-slate-400 italic bg-blue-500/[0.05] p-2.5 rounded-xl border border-blue-500/10">
        💬 "{entrega.fraseImpacto}"
      </p>
    </div>
  </div>

  <!-- Rodapé com Carimbo Auditado -->
  <div class="pt-4 border-t border-white/[0.06] mt-auto">
    <Carimbo
      mes={numeroPrincipal.mes}
      ano={numeroPrincipal.ano}
      fonte={numeroPrincipal.fonte}
      linkFonte={numeroPrincipal.linkFonte}
    />
  </div>
</article>
