---
// src/components/CardEntrega.astro
// Card de Entrega — Design Editorial Compacto com Mídia Integrada (Foto & Vídeo)
import type { Entrega } from '../data/entregas';

interface Props {
  entrega: Entrega;
}

const { entrega } = Astro.props;
const numeroPrincipal = entrega.numeros[0];
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const fullImgUrl = entrega.imagem ? `${baseUrl}${entrega.imagem}` : null;
const fullVideoUrl = entrega.videoUrl ? `${baseUrl}${entrega.videoUrl}` : null;
---

<article class="flex flex-col justify-between h-full bg-white border border-slate-200/90 shadow-lg shadow-slate-200/50 hover:shadow-xl hover:border-[#F15A29]/40 rounded-2xl p-4 sm:p-5 transition-all duration-300 relative overflow-hidden group">
  <!-- Tarja superior de cor institucional -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#123F8F] via-[#1A54BD] to-[#F15A29]"></div>

  <div>
    <!-- Top Header: Município & Badge -->
    <div class="flex items-center justify-between gap-2 mb-2.5 flex-wrap">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
        {entrega.municipioPrincipal}
      </span>
      {entrega.badge && (
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-orange-50 text-[#F15A29] border border-orange-200/60 uppercase tracking-wide">
          ★ {entrega.badge}
        </span>
      )}
    </div>

    <!-- Título da Entrega (em destaque principal no topo) -->
    <div class="mb-3">
      <h3 class="font-display text-2xl sm:text-3xl font-black italic tracking-tight text-[#123F8F] leading-tight mb-1 group-hover:text-[#F15A29] transition-colors">
        {entrega.nome}
      </h3>
      <p class="font-sans text-sm font-semibold text-slate-600 leading-snug">
        {entrega.subtitulo}
      </p>
    </div>

    <!-- Foto / Mídia Compacta Integrada (quando disponível) -->
    {fullImgUrl && (
      <div
        class="relative w-full h-28 rounded-xl overflow-hidden mb-3 bg-slate-900 border border-slate-200/80 shadow-xs group/thumb cursor-pointer"
        data-open-video={fullVideoUrl || ''}
        data-video-title={`${entrega.nome} — Dr. Luizinho`}
      >
        <img
          src={fullImgUrl}
          alt={`Registro de Dr. Luizinho em ${entrega.nome}`}
          class="w-full h-full object-cover group-hover/thumb:scale-105 transition-transform duration-500"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>

        {fullVideoUrl && (
          <div class="absolute inset-0 bg-black/15 group-hover/thumb:bg-black/25 transition-colors flex items-center justify-center">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#F15A29] text-white text-xs font-bold shadow-lg group-hover/thumb:scale-105 active:scale-95 transition-all">
              <svg class="w-3.5 h-3.5 fill-current translate-x-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <span>Assistir Visita</span>
              {entrega.videoDuracao && (
                <span class="opacity-80 text-xs font-normal border-l border-white/30 pl-1.5">{entrega.videoDuracao}</span>
              )}
            </span>
          </div>
        )}
      </div>
    )}

    <!-- Métrica Complementar (informação complementar com menor destaque abaixo do nome) -->
    <div class="mb-3.5 flex items-baseline gap-2 flex-wrap">
      <span class="font-display text-xl sm:text-2xl font-black italic text-[#F15A29] leading-none">
        {numeroPrincipal.valor}
      </span>
      <span class="font-sans text-xs text-slate-600 font-bold uppercase tracking-wider">
        {numeroPrincipal.rotulo}
      </span>
    </div>

    <!-- Conteúdo Editorial -->
    <div class="space-y-3 font-sans text-[15px] sm:text-base text-slate-700 font-medium leading-relaxed">
      <p class="leading-relaxed">
        {entrega.fraseOQueE}
      </p>

      <div class="flex items-start gap-2.5 p-3 rounded-xl bg-orange-50/70 border border-orange-200/80 text-slate-900 text-sm font-semibold leading-snug">
        <span class="text-[#F15A29] font-bold text-sm shrink-0 mt-0.5">✓</span>
        <span>{entrega.fraseNumero}</span>
      </div>
    </div>
  </div>
</article>
