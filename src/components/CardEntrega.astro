---
// src/components/CardEntrega.astro
import type { Entrega } from '../data/entregas';
import Carimbo from './Carimbo.astro';

interface Props {
  entrega: Entrega;
}

const { entrega } = Astro.props;
const numeroPrincipal = entrega.numeros[0];
---

<article class="flex flex-col justify-between h-full bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-xl transition-all duration-300 p-6 md:p-7 relative overflow-hidden group">
  <!-- Tarja superior colorida -->
  <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#123F8F] via-[#1A54BD] to-[#F15A29]"></div>

  <div>
    <!-- Top Header: Badges & Território -->
    <div class="flex items-center justify-between gap-2 mb-4 flex-wrap">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">
        {entrega.municipioPrincipal}
      </span>
      {entrega.badge && (
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-orange-100 text-[#F15A29] uppercase tracking-wide">
          ★ {entrega.badge}
        </span>
      )}
    </div>

    <!-- Título da Entrega -->
    <h3 class="font-display text-2xl sm:text-3xl font-black italic tracking-tight text-[#123F8F] leading-tight mb-2 group-hover:text-[#F15A29] transition-colors">
      {entrega.nome}
    </h3>
    <p class="font-sans text-xs font-semibold text-slate-500 mb-5">
      {entrega.subtitulo}
    </p>

    <!-- As 3 Frases Canônicas -->
    <div class="space-y-3 font-sans text-sm text-slate-700 leading-relaxed mb-6">
      <p class="font-medium text-slate-800">
        {entrega.fraseOQueE}
      </p>

      <div class="p-3.5 rounded-xl bg-[#F8FAFC] border-l-4 border-[#F15A29] text-slate-900 font-semibold text-sm">
        {entrega.fraseNumero}
      </div>

      <p class="text-xs text-slate-600 italic bg-amber-50/50 p-2.5 rounded-lg border border-amber-100/60">
        💬 "{entrega.fraseImpacto}"
      </p>
    </div>

    <!-- Pílulas de Números / Métricas -->
    <div class="grid grid-cols-2 gap-2 mb-6">
      {entrega.numeros.slice(0, 2).map((num) => (
        <div class="bg-slate-50 border border-slate-100 rounded-xl p-2.5">
          <p class="font-display text-xl font-extrabold text-[#123F8F] leading-none mb-1">
            {num.valor}
          </p>
          <p class="font-sans text-[11px] text-slate-500 leading-tight">
            {num.rotulo}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- Rodapé com Carimbo Auditado -->
  <div class="pt-4 border-t border-slate-100 mt-auto">
    <Carimbo
      mes={numeroPrincipal.mes}
      ano={numeroPrincipal.ano}
      fonte={numeroPrincipal.fonte}
      linkFonte={numeroPrincipal.linkFonte}
    />
  </div>
</article>
