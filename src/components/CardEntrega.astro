---
// src/components/CardEntrega.astro
// Card de Entrega — Design Editorial com Nome em Destaque Principal e Números Complementares
import type { Entrega } from '../data/entregas';

interface Props {
  entrega: Entrega;
}

const { entrega } = Astro.props;
const numeroPrincipal = entrega.numeros[0];
---

<article class="flex flex-col justify-between h-full bg-white border border-slate-200/90 shadow-lg shadow-slate-200/50 hover:shadow-xl hover:border-[#F15A29]/40 rounded-2xl p-5 sm:p-6 transition-all duration-300 relative overflow-hidden group">
  <!-- Tarja superior de cor institucional -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#123F8F] via-[#1A54BD] to-[#F15A29]"></div>

  <div>
    <!-- Top Header: Município & Badge -->
    <div class="flex items-center justify-between gap-2 mb-3.5 flex-wrap">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-700">
        {entrega.municipioPrincipal}
      </span>
      {entrega.badge && (
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-orange-50 text-[#F15A29] border border-orange-200/50 uppercase tracking-wide">
          ★ {entrega.badge}
        </span>
      )}
    </div>

    <!-- Título da Entrega (em destaque principal no topo) -->
    <div class="mb-2.5">
      <h3 class="font-display text-2xl sm:text-3xl font-black italic tracking-tight text-[#123F8F] leading-tight mb-1 group-hover:text-[#F15A29] transition-colors">
        {entrega.nome}
      </h3>
      <p class="font-sans text-xs font-medium text-slate-400 line-clamp-1">
        {entrega.subtitulo}
      </p>
    </div>

    <!-- Métrica Complementar (informação complementar com menor destaque abaixo do nome) -->
    <div class="mb-4 flex items-baseline gap-2 flex-wrap">
      <span class="font-display text-lg sm:text-xl font-black italic text-[#F15A29] leading-none">
        {numeroPrincipal.valor}
      </span>
      <span class="font-sans text-[11px] text-slate-500 font-bold uppercase tracking-wider">
        {numeroPrincipal.rotulo}
      </span>
    </div>

    <!-- Conteúdo Editorial -->
    <div class="space-y-2.5 font-sans text-xs sm:text-sm text-slate-600 leading-relaxed">
      <p class="leading-relaxed">
        {entrega.fraseOQueE}
      </p>

      <div class="flex items-start gap-2 p-2.5 rounded-xl bg-orange-50/50 border border-orange-100/70 text-slate-800 text-xs font-medium leading-snug">
        <span class="text-[#F15A29] font-bold text-xs shrink-0 mt-0.5">✓</span>
        <span>{entrega.fraseNumero}</span>
      </div>
    </div>
  </div>
</article>
