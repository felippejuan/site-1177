---
// src/components/GaleriaBiografia.astro
// Galeria Editorial Rotativa de Fotos Reais de Dr. Luizinho em Execução (Limpa e Elegante)
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

interface FotoItem {
  id: number;
  src: string;
  alt: string;
  titulo: string;
  descricao: string;
  contexto: string;
}

const fotos: FotoItem[] = [
  {
    id: 1,
    src: `${baseUrl}/biografia/1.png`,
    alt: "Crachá histórico do Ministério da Saúde de Dr. Luizinho no Hospital Geral de Nova Iguaçu (Posse)",
    titulo: "Crachá de Interno no Hospital da Posse",
    descricao: "Registro oficial no HGNI / Ministério da Saúde. A vocação nasceu na emergência mais movimentada da Baixada Fluminense.",
    contexto: "HGNI · Ministério da Saúde"
  },
  {
    id: 2,
    src: `${baseUrl}/biografia/2.png`,
    alt: "Dr. Luizinho realizando exame clínico direto em paciente na unidade de saúde pública",
    titulo: "Atendimento Clínico Humanizado",
    descricao: "Examinando pessoalmente cada paciente. A medicina exercida com escuta sensível, cuidado e respeito às famílias.",
    contexto: "Nova Iguaçu · Atendimento SUS"
  },
  {
    id: 3,
    src: `${baseUrl}/biografia/3.png`,
    alt: "Dr. Luizinho em consulta médica orientando paciente idosa com receituário e carimbo",
    titulo: "Atenção e Escuta Olho no Olho",
    descricao: "Receituário na mão e carimbo na mesa: ouvindo as famílias para orientar o diagnóstico e garantir o tratamento digno.",
    contexto: "Consulta Médica · Saúde Pública"
  },
  {
    id: 4,
    src: `${baseUrl}/biografia/4.png`,
    alt: "Dr. Luizinho abraçando cidadão na campanha de vacinação contra febre amarela",
    titulo: "Ao Lado da População nas Ruas",
    descricao: "Presença direta nos bairros e acolhimento humano durante a grande mobilização preventiva contra a febre amarela.",
    contexto: "Campanha em Campo · Nova Iguaçu"
  },
  {
    id: 5,
    src: `${baseUrl}/biografia/5.png`,
    alt: "Dr. Luizinho aplicando vacina contra a Covid-19 em profissional de saúde com colete da OPAS",
    titulo: "Liderança Ativa na Vacinação",
    descricao: "Aplicando doses na linha de frente e coordenando os postos de vacinação para salvar vidas na pandemia de Covid-19.",
    contexto: "Imunização Covid-19 · OPAS / SUS"
  }
];
---

<div id="bio-gallery" class="bg-white rounded-3xl p-3 sm:p-4 border border-slate-200/90 shadow-xl shadow-slate-200/60 mb-8 overflow-hidden relative" data-total={fotos.length}>
  
  <!-- Moldura Limpa da Foto (Sem badges sobrepostas, sem setas e sem modal de ampliação) -->
  <div id="bio-image-stage" class="relative aspect-[5/4] sm:aspect-[4/3] rounded-2xl overflow-hidden bg-slate-100 select-none">
    
    {fotos.map((foto, index) => (
      <div
        class={`bio-slide absolute inset-0 transition-all duration-700 ease-out ${
          index === 0 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-105 z-0 pointer-events-none'
        }`}
        data-index={index}
        data-title={foto.titulo}
        data-desc={foto.descricao}
        data-ctx={foto.contexto}
      >
        <img
          src={foto.src}
          alt={foto.alt}
          loading={index === 0 ? 'eager' : 'lazy'}
          class="w-full h-full object-cover object-center"
        />
      </div>
    ))}

  </div>

  <!-- Bloco de Legenda Editorial & Indicadores -->
  <div class="pt-4 pb-1 px-1">
    <div class="flex items-center justify-between gap-2 mb-1.5">
      <span id="bio-ctx-display" class="font-sans text-xs font-semibold text-slate-400 uppercase tracking-wider">
        {fotos[0].contexto}
      </span>
      <span class="text-[11px] font-medium text-emerald-600 flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
        Registro Real
      </span>
    </div>

    <h4 id="bio-title-display" class="font-display text-lg sm:text-xl font-black italic text-[#123F8F] leading-snug">
      {fotos[0].titulo}
    </h4>

    <p id="bio-desc-display" class="font-sans text-xs sm:text-sm text-slate-600 leading-relaxed mt-1 min-h-[40px]">
      {fotos[0].descricao}
    </p>

    <!-- Barra Inferior de Controles: Pontos de Paginação e Play/Pause -->
    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
      
      <!-- Pontos de Paginação Clicáveis -->
      <div class="flex items-center gap-2" id="bio-dots-container">
        {fotos.map((_, index) => (
          <button
            type="button"
            class={`bio-dot h-2 rounded-full transition-all duration-300 ${
              index === 0 ? 'w-7 bg-[#F15A29]' : 'w-2 bg-slate-200 hover:bg-slate-300'
            }`}
            data-index={index}
            aria-label={`Ir para foto ${index + 1}`}
          />
        ))}
      </div>

      <!-- Botão Play / Pausa da Rotação Automática -->
      <button
        id="bio-btn-toggle-play"
        type="button"
        class="inline-flex items-center gap-1.5 text-[11px] font-medium text-slate-500 hover:text-slate-800 transition-colors"
        title="Pausar ou retomar rotação automática"
      >
        <svg id="bio-icon-pause" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
        <svg id="bio-icon-play" class="w-3.5 h-3.5 hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <span id="bio-play-label" class="hidden sm:inline">Pausar</span>
      </button>

    </div>
  </div>

</div>

<script>
  function setupGaleriaBio() {
    const container = document.getElementById('bio-gallery');
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('.bio-slide');
    const dots = container.querySelectorAll<HTMLElement>('.bio-dot');
    const total = slides.length;
    if (total === 0) return;

    const ctxDisplay = document.getElementById('bio-ctx-display');
    const titleDisplay = document.getElementById('bio-title-display');
    const descDisplay = document.getElementById('bio-desc-display');

    const btnTogglePlay = document.getElementById('bio-btn-toggle-play');
    const iconPause = document.getElementById('bio-icon-pause');
    const iconPlay = document.getElementById('bio-icon-play');
    const playLabel = document.getElementById('bio-play-label');
    const stage = document.getElementById('bio-image-stage');

    let currentIndex = 0;
    let isPlaying = true;
    let timer: number | undefined;

    function renderSlide(index: number) {
      currentIndex = (index + total) % total;

      // Update slide elements
      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.remove('opacity-0', 'scale-105', 'z-0', 'pointer-events-none');
          slide.classList.add('opacity-100', 'scale-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'scale-100', 'z-10');
          slide.classList.add('opacity-0', 'scale-105', 'z-0', 'pointer-events-none');
        }
      });

      // Update dots
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.remove('w-2', 'bg-slate-200', 'hover:bg-slate-300');
          dot.classList.add('w-7', 'bg-[#F15A29]');
        } else {
          dot.classList.remove('w-7', 'bg-[#F15A29]');
          dot.classList.add('w-2', 'bg-slate-200', 'hover:bg-slate-300');
        }
      });

      // Update text with soft animation
      const activeSlide = slides[currentIndex];
      const title = activeSlide.getAttribute('data-title') || '';
      const desc = activeSlide.getAttribute('data-desc') || '';
      const ctx = activeSlide.getAttribute('data-ctx') || '';

      if (ctxDisplay) ctxDisplay.textContent = ctx;
      if (titleDisplay) titleDisplay.textContent = title;
      if (descDisplay) descDisplay.textContent = desc;
    }

    function nextSlide() {
      renderSlide(currentIndex + 1);
    }

    function prevSlide() {
      renderSlide(currentIndex - 1);
    }

    function startAutoPlay() {
      stopAutoPlay();
      if (isPlaying) {
        timer = window.setInterval(nextSlide, 4500);
      }
    }

    function stopAutoPlay() {
      if (timer) {
        clearInterval(timer);
        timer = undefined;
      }
    }

    function setPlayState(playing: boolean) {
      isPlaying = playing;
      if (isPlaying) {
        iconPause?.classList.remove('hidden');
        iconPlay?.classList.add('hidden');
        if (playLabel) playLabel.textContent = 'Pausar';
        startAutoPlay();
      } else {
        iconPause?.classList.add('hidden');
        iconPlay?.classList.remove('hidden');
        if (playLabel) playLabel.textContent = 'Retomar';
        stopAutoPlay();
      }
    }

    // Dots click listeners
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetIndex = Number(dot.getAttribute('data-index'));
        renderSlide(targetIndex);
        startAutoPlay();
      });
    });

    btnTogglePlay?.addEventListener('click', (e) => {
      e.stopPropagation();
      setPlayState(!isPlaying);
    });

    // Pause on hover
    container.addEventListener('mouseenter', () => {
      stopAutoPlay();
    });

    container.addEventListener('mouseleave', () => {
      if (isPlaying) startAutoPlay();
    });

    // Touch swipe support
    let touchStartX = 0;
    let touchEndX = 0;

    stage?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    stage?.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) {
          nextSlide();
        } else {
          prevSlide();
        }
        startAutoPlay();
      }
    }, { passive: true });

    // Start auto rotation
    startAutoPlay();
  }

  setupGaleriaBio();
  document.addEventListener('astro:page-load', setupGaleriaBio);
</script>
