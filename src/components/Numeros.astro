---
// src/components/Numeros.astro
// Seção O Trabalho em Números — Fundo Branco com Métricas Monumentais
import { MACRO_NUMEROS } from '../data/trajetoria';
---

<section id="numeros" class="py-20 sm:py-28 bg-white text-slate-900 relative border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Cabeçalho -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 border border-blue-200 text-[#123F8F] font-sans text-xs font-bold uppercase tracking-wider mb-4">
        Resultados Concretos
      </span>
      <h2 class="font-display text-3xl sm:text-5xl font-black italic tracking-tight text-[#123F8F] leading-tight mb-4">
        O TRABALHO EM <span class="text-[#F15A29]">NÚMEROS REAIS</span>
      </h2>
      <p class="font-sans text-base sm:text-lg text-slate-600">
        Equipamentos públicos em pleno funcionamento salvando vidas todos os dias no Estado do Rio de Janeiro.
      </p>
    </div>

    <!-- Grade 4x1 no Desktop / 2x2 no Mobile -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {MACRO_NUMEROS.map((item) => (
        <div class="p-8 rounded-3xl bg-[#F8FAFC] border border-slate-200/80 hover:border-[#123F8F]/40 transition-all duration-300 flex flex-col justify-between shadow-sm hover:shadow-lg group">
          <div>
            <p class="font-display text-4xl sm:text-5xl lg:text-5xl font-black italic text-[#F15A29] leading-none mb-4 group-hover:scale-105 transition-transform origin-left">
              {item.numero}
            </p>
            <h3 class="font-sans text-base font-bold text-slate-900 mb-2 leading-snug">
              {item.rotulo}
            </h3>
          </div>
          <p class="font-sans text-xs text-slate-500 leading-relaxed pt-4 border-t border-slate-200/80 mt-4">
            {item.detalhe}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
