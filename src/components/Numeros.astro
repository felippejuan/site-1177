---
// src/components/Numeros.astro
// Seção O Trabalho em Números — Contadores macro em grade 2x2 (mobile) / 4x1 (desktop)
import { MACRO_NUMEROS } from '../data/trajetoria';
---

<section id="numeros" class="py-16 sm:py-24 bg-slate-900 text-white relative overflow-hidden">
  <!-- Efeito de brilho de fundo -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-blue-600/15 blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Cabeçalho -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="inline-block px-3.5 py-1 rounded-full bg-white/10 border border-white/20 text-orange-400 font-sans text-xs font-bold uppercase tracking-wider mb-3">
        Resultados Concretos
      </span>
      <h2 class="font-display text-3xl sm:text-5xl font-black italic tracking-tight text-white leading-tight mb-4">
        O TRABALHO EM <span class="text-[#F15A29]">NÚMEROS</span>
      </h2>
      <p class="font-sans text-base sm:text-lg text-slate-300">
        Métricas auditadas e comprovadas de equipamentos públicos salvando vidas todos os dias no Rio de Janeiro.
      </p>
    </div>

    <!-- Grade 2x2 no Mobile / 4x1 no Desktop -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
      {MACRO_NUMEROS.map((item) => (
        <div class="p-6 sm:p-8 rounded-2xl bg-slate-800/80 border border-slate-700/80 hover:border-orange-500/50 transition-all flex flex-col justify-between group">
          <div>
            <p class="font-display text-3xl sm:text-5xl lg:text-5xl font-black italic text-[#F15A29] leading-none mb-3 group-hover:scale-105 transition-transform origin-left">
              {item.numero}
            </p>
            <h3 class="font-sans text-sm sm:text-base font-bold text-white mb-2 leading-snug">
              {item.rotulo}
            </h3>
          </div>
          <p class="font-sans text-xs text-slate-400 leading-relaxed pt-4 border-t border-slate-700/60">
            {item.detalhe}
          </p>
        </div>
      ))}
    </div>

    <!-- Rodapé de Conformidade Documental -->
    <div class="mt-12 text-center text-xs text-slate-500 font-sans">
      <span>* Todos os dados extraídos de relatórios anuais de gestão (RAG), RDQA e Diário Oficial do Estado do Rio de Janeiro (DOERJ).</span>
    </div>
  </div>
</section>
