---
// src/components/MarcosNacionais.astro
// Leis e Marcos Nacionais — Design Editorial Limpo, Sofisticado e sem Poluição Visual
const MARCOS = [
  {
    titulo: 'Estratégia Nacional de Saúde',
    area: 'DESENVOLVIMENTO ECONÔMICO E SOBERANIA NACIONAL',
    badge: 'LEI SANCIONADA ✔️',
    isLei: true,
    referencia: 'Lei Federal n° 15471/2026',
    impactoCurto: 'Autonomia do SUS',
    descricao: 'Autor da lei histórica que estimula a produção nacional de medicamentos, vacinas, equipamentos e tecnologias de saúde. Um marco que entrega resultados imediatos:',
    itens: [
      'Fortalecimento do SUS',
      'Ampliação do acesso da população à saúde',
      'Redução da dependência de insumos importados',
      'Captação de investimentos e fomento à pesquisa',
      'Geração de emprego e renda'
    ],
    iconeSvg: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`
  },
  {
    titulo: 'Renegociação da Dívida dos Estados — PROPAG',
    area: 'RECUPERAÇÃO ECONÔMICA E EQUILÍBRIO FISCAL',
    badge: 'LEI SANCIONADA ✔️',
    isLei: true,
    referencia: 'Lei Complementar n° 212/2025',
    impactoCurto: 'R$ 41 Bi para o RJ',
    descricao: 'Relator da lei que criou o Programa de Pleno Pagamento de Dívidas dos Estados. Um marco histórico que une responsabilidade fiscal ao destravamento de recursos para investir na população.',
    itens: [
      'Renegociação das dívidas dos estados com a União',
      'Metas rigorosas de transparência e prestação de contas',
      'Redução de R$ 41 bilhões na dívida do Rio',
      'Liberação de R$ 320 milhões/mês para investimentos em educação, segurança, saneamento e infraestrutura'
    ],
    iconeSvg: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
  },
  {
    titulo: 'Aposentadoria Especial dos Agentes de Saúde',
    area: 'VALORIZAÇÃO E DIGNIDADE PROFISSIONAL',
    badge: 'PEC APROVADA ✔️',
    isLei: false,
    referencia: 'PEC n° 14/2021',
    impactoCurto: 'Previdência Justa',
    descricao: 'Presidente da Comissão Especial que aprovou a aposentadoria especial dos Agentes Comunitários de Saúde (ACS) e de Combate às Endemias (ACE). Um marco de respeito e dignidade para quem dedica a vida a cuidar da nossa gente:',
    itens: [
      'Reconhecimento do trabalho diário em condições de risco',
      'Salário integral garantido no momento de se aposentar',
      'Reajustes salariais iguais aos dos profissionais da ativa',
      'Valorização de quem atua na linha de frente nas ruas',
      'Fortalecimento da atenção básica e preventiva do SUS'
    ],
    iconeSvg: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`
  },
  {
    titulo: 'Carteira Nacional de Vacinação Digital',
    area: 'TECNOLOGIA E INOVAÇÃO NO SUS',
    badge: 'PROJETO APROVADO ✔️',
    isLei: false,
    referencia: 'PL nº 468/2019 — Câmara dos Deputados',
    impactoCurto: 'Histórico no Celular',
    descricao: 'Autor do projeto pioneiro que modernizou a saúde pública brasileira ao substituir o antigo papel pela Carteira Nacional de Vacinação Digital vinculada ao CPF:',
    itens: [
      'Histórico completo de vacinação acessível na palma da mão',
      'Integração nacional pelo CPF para evitar perdas do cartão físico',
      'Alertas automáticos para doses de reforço e vacinas em atraso',
      'Planejamento eficiente de compra e distribuição de doses pelo SUS',
      'Conexão de dados entre postos públicos e clínicas privadas'
    ],
    iconeSvg: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 9l2 2 4-4" /></svg>`
  },
  {
    titulo: 'Avaliação de Proficiência Médica',
    area: 'Qualidade da Medicina',
    badge: 'Medida Provisória',
    isLei: false,
    referencia: 'MP nº 1.370 / PL 785',
    impactoCurto: 'Padrão de Excelência',
    descricao: 'Autor do projeto na Câmara que mobilizou o país por uma avaliação nacional periódica de proficiência médica, articulando a edição da Medida Provisória nº 1.370 para garantir segurança no atendimento aos pacientes.',
    iconeSvg: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`
  },
  {
    titulo: 'Programa Pró-Leitos',
    area: 'EMERGÊNCIA SANITÁRIA E UTIS NO SUS',
    badge: 'LEI SANCIONADA ✔️',
    isLei: true,
    referencia: 'Lei Federal nº 14.147 — Congresso Nacional',
    impactoCurto: 'UTIs 100% SUS',
    descricao: 'Autor da Lei Federal nº 14.147, marco legislativo pioneiro que instituiu o Programa Pró-Leitos para autorizar e mobilizar a contratação de leitos privados de UTI para pacientes do SUS durante a pandemia:',
    itens: [
      'Marco legal para requisição e contratação de leitos privados de UTI',
      'Atendimento 100% gratuito para pacientes graves da rede pública',
      'Mobilização emergencial para desafogar as filas de terapia intensiva',
      'Incentivo à integração e solidariedade entre redes pública e privada',
      'Defesa incansável do acesso imediato a leitos no colapso sanitário'
    ],
    iconeSvg: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>`
  },
  {
    titulo: 'Comissão Externa de Enfrentamento à Covid-19',
    area: 'DEFESA DA VIDA E DA CIÊNCIA',
    badge: 'COMBATE À PANDEMIA ✔️',
    isLei: false,
    referencia: 'Câmara dos Deputados',
    impactoCurto: 'Vacinas Aceleradas',
    descricao: 'Presidente da comissão especial criada para enfrentar a pandemia de Covid-19, a maior emergência sanitária da nossa história. Atuou na linha de frente em Brasília, liderando a força-tarefa que garantiu o acesso à vacina e viabilizou soluções logísticas e orçamentárias:',
    itens: [
      'Liberação e aceleração de marcos legais para a compra de vacinas',
      'Viabilização de insumos emergenciais para hospitais em todo o país',
      'Atuação direta no planejamento estratégico de leitos e respiradores',
      'Aprovação de medidas que garantiram o financiamento contínuo do SUS',
      'Articulação direta com Fiocruz, Instituto Butantan e OPAS',
      'Defesa inegociável da vida e da ciência'
    ],
    iconeSvg: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`
