---
// src/components/MarcosNacionais.astro
// Leis e Marcos Nacionais — Design Editorial Limpo, Sofisticado e sem Poluição Visual
const MARCOS = [
  {
    titulo: 'Estratégia Nacional de Saúde',
    area: 'Soberania Farmacêutica',
    badge: 'Lei Sancionada',
    isLei: true,
    referencia: 'Lei Federal nº 15.471',
    impactoCurto: 'Autonomia do SUS',
    descricao: 'Primeiro signatário da legislação histórica criada para reduzir a dependência externa do Brasil de medicamentos, vacinas e insumos, garantindo abastecimento contínuo ao SUS e estimulando a indústria nacional.',
    iconeSvg: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`
  },
  {
    titulo: 'Renegociação da Dívida dos Estados',
    area: 'Alívio Fiscal para o RJ',
    badge: 'Lei Complementar',
    isLei: true,
    referencia: 'LC nº 212/2025',
    impactoCurto: 'R$ 41 Bi para o RJ',
    descricao: 'Relator em Plenário do Programa de Pleno Pagamento de Dívidas dos Estados, conquistando o corte de R$ 41 bilhões da dívida fluminense e liberando R$ 320 milhões por mês para novos investimentos na saúde e obras.',
    iconeSvg: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
  },
  {
    titulo: 'Aposentadoria Especial dos Agentes de Saúde',
    area: 'Valorização Profissional',
    badge: 'Comissão Especial',
    isLei: false,
    referencia: 'PEC 14/2021',
    impactoCurto: 'Previdência Justa',
    descricao: 'Presidente da Comissão Especial que debate a aposentadoria especial e os direitos previdenciários dos Agentes Comunitários de Saúde e de Combate às Endemias, valorizando quem cuida de perto das famílias brasileiras.',
    iconeSvg: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`
  },
  {
    titulo: 'Avaliação de Proficiência Médica',
    area: 'Qualidade da Medicina',
    badge: 'Medida Provisória',
    isLei: false,
    referencia: 'MP nº 1.370 / PL 785',
    impactoCurto: 'Padrão de Excelência',
    descricao: 'Autor do projeto na Câmara que mobilizou o país por uma avaliação nacional periódica de proficiência médica, articulando a edição da Medida Provisória nº 1.370 para garantir segurança no atendimento aos pacientes.',
    iconeSvg: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`
  },
  {
    titulo: 'Programa Pró-Leitos',
    area: 'Emergência e UTIs',
    badge: 'Lei Sancionada',
    isLei: true,
    referencia: 'Lei Federal nº 14.147',
    impactoCurto: 'UTIs 100% SUS',
    descricao: 'Autor da lei que viabilizou a utilização de leitos privados de UTI para atendimento 100% gratuito de pacientes graves do SUS durante a fase mais crítica da pandemia, salvando milhares de vidas.',
    iconeSvg: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>`
  },
  {
    titulo: 'Enfrentamento da Covid-19',
    area: 'Saúde Pública',
    badge: 'Comissão Especial',
    isLei: false,
    referencia: 'Câmara dos Deputados',
    impactoCurto: 'Vacinas Aceleradas',
    descricao: 'Presidiu a comissão especial da Câmara durante a pandemia, atuando em parceria direta com Fiocruz, Instituto Butantan e OPAS para agilizar a chegada de vacinas, leitos e insumos emergenciais no país.',
    iconeSvg: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`
  }
];
---

<section id="brasil" class="py-12 sm:py-16 md:py-20 bg-slate-50 relative border-b border-slate-200 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Cabeçalho Editorial: Tag + Título Grande Porte + Subtítulo -->
    <div class="max-w-3xl mb-6 sm:mb-8">
      <div class="flex items-center gap-2 mb-2.5">
        <span class="w-4 h-[2px] bg-[#F15A29]"></span>
        <span class="text-xs font-bold text-[#123F8F] uppercase tracking-[0.2em]">POR TODO O BRASIL</span>
      </div>
      <h2 class="font-display text-3xl sm:text-5xl font-black italic tracking-tight leading-tight mb-3">
        <span class="text-[#123F8F]">LEIS E MARCOS QUE</span> <br />
        <span class="text-[#F15A29]">TRANSFORMARAM O BRASIL</span>
      </h2>
      <p class="font-sans text-base sm:text-lg text-slate-600 leading-relaxed">
        Projetos e leis federais relatados e aprovados que fortalecem a autonomia do país, expandem o SUS e salvam vidas.
      </p>
    </div>

    <!-- Controles Desktop & Dica no Mobile (Visível logo acima dos cards) -->
    <div class="flex items-center justify-between gap-4 mb-3 sm:mb-4">
      <!-- Dica de Deslize no Celular -->
      <div class="sm:hidden flex items-center gap-1.5 text-xs font-semibold text-slate-400">
        <svg class="w-4 h-4 text-[#F15A29]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
        <span>Arraste para o lado</span>
      </div>

      <!-- Botões de Navegação Desktop -->
      <div class="hidden sm:flex items-center gap-2.5 ml-auto">
        <button
          id="marcos-prev"
          aria-label="Voltar marco anterior"
          class="p-2.5 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white hover:border-[#123F8F] shadow-xs hover:shadow-md transition-all active:scale-95 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="marcos-next"
          aria-label="Avançar próximo marco"
          class="p-2.5 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white hover:border-[#123F8F] shadow-xs hover:shadow-md transition-all active:scale-95 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Trilho do Carrossel com Efeito Peek (próximo card visível cortado na lateral) -->
    <div class="relative">
      <div class="pointer-events-none absolute right-0 top-0 bottom-2 w-20 sm:w-28 bg-gradient-to-l from-slate-50 to-transparent z-10 hidden md:block"></div>

      <div
        id="marcos-track"
        class="flex gap-6 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory scroll-smooth hide-scrollbar -mx-4 sm:mx-0 px-4 sm:px-0"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {MARCOS.map((marco) => (
          <div class="snap-start shrink-0 w-[84vw] sm:w-[340px] lg:w-[370px]">
            <article class="flex flex-col justify-between h-full bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-[0_4px_20px_rgba(0,0,0,0.05)] hover:shadow-[0_12px_32px_rgba(18,63,143,0.12)] hover:border-[#123F8F]/40 hover:-translate-y-1.5 transition-all duration-300 relative group">
              <div>
                <!-- Topo: Ícone Institucional + Badge de Status -->
                <div class="flex items-center justify-between gap-3 mb-5">
                  <div class="w-12 h-12 rounded-2xl bg-blue-50 text-[#123F8F] flex items-center justify-center border border-blue-100/80 shadow-xs group-hover:scale-105 group-hover:bg-[#123F8F] group-hover:text-white transition-all duration-300">
                    <div class="w-5 h-5 flex items-center justify-center" set:html={marco.iconeSvg} />
                  </div>

                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200/80">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    {marco.badge}
                  </span>
                </div>

                <!-- Categoria / Eixo -->
                <span class="block text-xs font-bold text-[#F15A29] uppercase tracking-wider mb-1.5">
                  {marco.area}
                </span>

                <!-- Título do Marco -->
                <h3 class="font-display text-2xl font-black italic tracking-tight text-[#123F8F] group-hover:text-[#F15A29] transition-colors leading-tight mb-3">
                  {marco.titulo}
                </h3>

                <!-- Descrição Fluida e Direta -->
                <p class="font-sans text-[14px] sm:text-[15px] text-slate-600 leading-relaxed font-normal mb-6">
                  {marco.descricao}
                </p>
              </div>

              <!-- Rodapé Institucional: Referência Legal + Conquista Prática -->
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-2 flex-wrap">
                <span class="font-mono text-xs font-bold text-slate-400 uppercase tracking-wide">
                  {marco.referencia}
                </span>

                <span class="inline-flex items-center gap-1 text-xs font-bold text-[#123F8F] bg-slate-50 border border-slate-200/60 px-2.5 py-1 rounded-lg">
                  <svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{marco.impactoCurto}</span>
                </span>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  function setupMarcosCarrossel() {
    const track = document.getElementById('marcos-track');
    const btnPrev = document.getElementById('marcos-prev');
    const btnNext = document.getElementById('marcos-next');

    if (!track || !btnPrev || !btnNext) return;

    btnPrev.addEventListener('click', () => {
      track.scrollBy({ left: -360, behavior: 'smooth' });
    });

    btnNext.addEventListener('click', () => {
      track.scrollBy({ left: 360, behavior: 'smooth' });
    });
  }

  setupMarcosCarrossel();
  document.addEventListener('astro:page-load', setupMarcosCarrossel);
</script>
