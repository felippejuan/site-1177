---

<section id="brasil" class="py-12 sm:py-16 md:py-20 bg-slate-50 relative border-b border-slate-200 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Cabeçalho Editorial: Tag + Título Grande Porte + Subtítulo -->
    <div class="max-w-3xl mb-6 sm:mb-8">
      <div class="flex items-center gap-2 mb-2.5">
        <span class="w-4 h-[2px] bg-[#F15A29]"></span>
        <span class="text-xs font-bold text-[#123F8F] uppercase tracking-[0.2em]">PELO BRASIL</span>
      </div>
      <h2 class="font-display text-3xl sm:text-5xl font-black italic tracking-tight leading-tight mb-3">
        <span class="text-[#123F8F]">LEIS E MARCOS QUE</span> <br />
        <span class="text-[#F15A29]">TRANSFORMARAM O PAÍS</span>
      </h2>
      <p class="font-sans text-base sm:text-lg text-slate-600 leading-relaxed">
        A experiência da linha de frente convertida em resultados no Congresso Nacional. Como autor e relator de projetos e presidente de comissões estratégicas, liderou pautas históricas: das vitórias em defesa do SUS e dos profissionais da saúde à recuperação da economia dos estados.
      </p>
    </div>

    <!-- Controles Desktop & Dica no Mobile (Visível logo acima dos cards) -->
    <div class="flex items-center justify-between gap-4 mb-3 sm:mb-4">
      <!-- Dica de Deslize no Celular -->
      <div class="sm:hidden flex items-center gap-1.5 text-xs font-semibold text-slate-400">
        <svg class="w-4 h-4 text-[#F15A29]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
        <span>Arraste para o lado</span>
      </div>

      <!-- Botões de Navegação Desktop -->
      <div class="hidden sm:flex items-center gap-2.5 ml-auto">
        <button
          id="marcos-prev"
          aria-label="Voltar marco anterior"
          class="p-2.5 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white hover:border-[#123F8F] shadow-xs hover:shadow-md transition-all active:scale-95 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="marcos-next"
          aria-label="Avançar próximo marco"
          class="p-2.5 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white hover:border-[#123F8F] shadow-xs hover:shadow-md transition-all active:scale-95 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Trilho do Carrossel com Efeito Peek (próximo card visível cortado na lateral) -->
    <div class="relative">
      <div class="pointer-events-none absolute right-0 top-0 bottom-2 w-20 sm:w-28 bg-gradient-to-l from-slate-50 to-transparent z-10 hidden md:block"></div>

      <div
        id="marcos-track"
        class="flex gap-6 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory scroll-smooth hide-scrollbar -mx-4 sm:mx-0 px-4 sm:px-0"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {MARCOS.map((marco) => (
          <div class="snap-start shrink-0 w-[88vw] sm:w-[380px] lg:w-[420px] flex">
            <article class="flex flex-col justify-between w-full h-full bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-[0_4px_20px_rgba(0,0,0,0.05)] hover:shadow-[0_12px_32px_rgba(18,63,143,0.12)] hover:border-[#123F8F]/40 hover:-translate-y-1.5 transition-all duration-300 relative group">
              <div>
                <!-- Topo: Ícone Institucional + Badge de Status -->
                <div class="flex items-center justify-between gap-3 mb-5">
                  <div class="w-12 h-12 rounded-2xl bg-blue-50 text-[#123F8F] flex items-center justify-center border border-blue-100/80 shadow-xs group-hover:scale-105 group-hover:bg-[#123F8F] group-hover:text-white transition-all duration-300">
                    <div class="w-5 h-5 flex items-center justify-center" set:html={marco.iconeSvg} />
                  </div>

                  <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs sm:text-[13px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200/80">
                    {!marco.badge.includes('✔') && <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>}
                    {marco.badge}
                  </span>
                </div>

                <!-- Categoria / Eixo -->
                <span class="block text-xs sm:text-[13px] font-bold text-[#F15A29] uppercase tracking-wider mb-2">
                  {marco.area}
                </span>

                <!-- Título do Marco -->
                <h3 class="font-display text-2xl sm:text-[26px] lg:text-[28px] font-black italic tracking-tight text-[#123F8F] group-hover:text-[#F15A29] transition-colors leading-tight mb-3.5">
                  {marco.titulo}
                </h3>

                <!-- Descrição Fluida e Direta -->
                <p class={`font-sans text-[15px] sm:text-base lg:text-[16.5px] text-slate-600 leading-relaxed font-normal ${marco.itens && marco.itens.length > 0 ? 'mb-4' : 'mb-6'}`}>
                  {marco.descricao}
                </p>

                {marco.itens && marco.itens.length > 0 && (
                  <ul class="space-y-3 mb-6">
                    {marco.itens.map((item) => (
                      <li class="font-sans text-[14.5px] sm:text-[15.5px] lg:text-base font-bold text-slate-800 leading-snug flex items-start gap-2.5">
                        <span class="text-emerald-600 font-black text-base shrink-0 mt-0.5">✔</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <!-- Rodapé Institucional: Apenas Referência Legal Limpa -->
              <div class="pt-4 border-t border-slate-100 flex items-center">
                <span class="font-mono text-xs sm:text-[13px] font-bold text-slate-400 uppercase tracking-wide">
                  {marco.referencia}
                </span>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  function setupMarcosCarrossel() {
    const track = document.getElementById('marcos-track');
    const btnPrev = document.getElementById('marcos-prev');
    const btnNext = document.getElementById('marcos-next');

    if (!track || !btnPrev || !btnNext) return;

    btnPrev.addEventListener('click', () => {
      track.scrollBy({ left: -360, behavior: 'smooth' });
    });

    btnNext.addEventListener('click', () => {
      track.scrollBy({ left: 360, behavior: 'smooth' });
    });
  }

  setupMarcosCarrossel();
  document.addEventListener('astro:page-load', setupMarcosCarrossel);
</script>
