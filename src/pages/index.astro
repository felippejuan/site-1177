---
// src/pages/index.astro
// Home Page Oficial de Campanha — Dr. Luizinho 1177 (Design Editorial Fundo Branco)
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import QuemE from '../components/QuemE.astro';
import Carrossel from '../components/Carrossel.astro';
import BuscaMunicipal from '../components/BuscaMunicipal.astro';
import SerieCuidandoDeGente from '../components/SerieCuidandoDeGente.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout>
  <!-- 1. Hero Section com Vídeo Nítido em Coluna Única -->
  <Hero />

  <!-- 2. Quem é Dr. Luizinho (Apresentação Humana do Médico e Gestor) -->
  <QuemE />

  <!-- 3. Vitrine de Entregas (Carrossel Horizontal com Cards Acetinados e Efeito Peek) -->
  <section id="entregas" class="py-20 sm:py-28 bg-white relative border-b border-slate-200/80 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mb-12">
        <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-[#123F8F] font-sans text-xs font-bold uppercase tracking-wider mb-4">
          Vitrine de Entregas
        </span>
        <h2 class="font-display text-3xl sm:text-5xl font-black italic tracking-tight text-[#123F8F] leading-tight mb-4">
          OBRAS QUE DESATARAM <span class="text-[#F15A29]">GARGALOS HISTÓRICOS</span>
        </h2>
        <p class="font-sans text-base sm:text-lg text-slate-600 leading-relaxed">
          Hospitais de alta complexidade, centros de diagnóstico e unidades especializadas que saíram do papel para transformar a saúde pública em todo o Rio de Janeiro.
        </p>
      </div>

      <!-- Carrossel Deslizante -->
      <Carrossel apenasDestaques={true} />
    </div>
  </section>

  <!-- 4. O que ele fez pela sua cidade (Busca Inteligente dos 92 Municípios) -->
  <BuscaMunicipal />

  <!-- 5. Série Documental no YouTube: Cuidando de Gente -->
  <SerieCuidandoDeGente />

  <!-- 6. Seção de Chamada para Ação Final: Mobilização pelo Rio -->
  <section class="py-20 sm:py-28 bg-gradient-to-br from-[#0c2a63] via-[#123F8F] to-[#0a2352] text-white relative overflow-hidden">
    <!-- Efeito sutil de iluminação de fundo -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-[#F15A29]/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Coluna Esquerda: Texto + Botões Oficiais -->
        <div class="lg:col-span-6 text-center lg:text-left">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-orange-300 text-xs font-semibold uppercase tracking-wider mb-5">
            Mobilização pelo Rio
          </span>
          <h2 class="font-display text-3xl sm:text-5xl lg:text-5xl font-black italic tracking-tight mb-5 leading-tight">
            A SAÚDE DO RIO <br class="hidden sm:inline" />
            <span class="text-[#F15A29]">NÃO PODE RETROCEDER.</span>
          </h2>
          <p class="font-sans text-base sm:text-lg text-blue-100 mb-8 leading-relaxed font-normal max-w-xl mx-auto lg:mx-0">
            Compartilhe este site com seus amigos, familiares e vizinhos para que mais pessoas conheçam quem realmente transformou a saúde pública do nosso Estado. Juntos pelo Rio!
          </p>

          <!-- Botões de Redes e Compartilhamento -->
          <div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center justify-center lg:justify-start gap-3">
            <!-- WhatsApp -->
            <a
              href="https://api.whatsapp.com/send?text=%F0%9F%8F%A5%20*Conhe%C3%A7a%20o%20site%20oficial%20do%20Dr.%20Luizinho%201177!*%20Veja%20as%20principais%20entregas%20e%20investimentos%20pela%20sa%C3%BAde%20do%20Estado%20do%20Rio%3A%0Ahttps%3A%2F%2Ffelippejuan.github.io%2Fsite-1177%2F"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl bg-[#25D366] hover:bg-[#20bd5a] text-white font-sans text-sm font-bold shadow-xl shadow-emerald-950/30 hover:scale-105 active:scale-95 transition-all"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
              </svg>
              <span>Compartilhar no WhatsApp</span>
            </a>

            <!-- Instagram -->
            <a
              href="https://www.instagram.com/doutorluizinho/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 px-5 py-3.5 rounded-2xl bg-gradient-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] hover:opacity-95 text-white font-sans text-sm font-bold shadow-xl shadow-purple-950/30 hover:scale-105 active:scale-95 transition-all"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Instagram @doutorluizinho</span>
            </a>

            <!-- Facebook -->
            <a
              href="https://www.facebook.com/doutorluizinho/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 px-5 py-3.5 rounded-2xl bg-[#1877F2] hover:bg-[#166fe5] text-white font-sans text-sm font-bold shadow-xl shadow-blue-950/30 hover:scale-105 active:scale-95 transition-all"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span>Facebook /doutorluizinho</span>
            </a>

            <!-- Twitter / X -->
            <a
              href="https://x.com/Doutorluizinhot"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 px-5 py-3.5 rounded-2xl bg-black hover:bg-slate-900 text-white font-sans text-sm font-bold border border-white/20 shadow-xl shadow-black/30 hover:scale-105 active:scale-95 transition-all"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              <span>X @Doutorluizinhot</span>
            </a>
          </div>
        </div>

        <!-- Coluna Direita: Imagem de Mobilização em Moldura Premium -->
        <div class="lg:col-span-6 relative">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl shadow-blue-950/80 border-2 border-white/20 group">
            <img
              src={`${baseUrl}/mobilizacao-rio.jpg`}
              alt="Mobilização popular com Dr. Luizinho no Rio de Janeiro"
              loading="lazy"
              decoding="async"
              class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700"
            />
            <!-- Gradiente de acabamento na base da foto -->
            <div class="absolute inset-0 bg-gradient-to-t from-blue-950/80 via-transparent to-transparent pointer-events-none"></div>
            
            <!-- Badge Flutuante sobre a foto -->
            <div class="absolute bottom-4 left-4 right-4 sm:bottom-6 sm:left-6 sm:right-6 flex items-center justify-between pointer-events-none">
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-950/60 backdrop-blur-md border border-white/20 text-white text-xs font-semibold shadow-lg">
                <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
                <span>Dr. Luizinho com lideranças e famílias fluminenses</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
