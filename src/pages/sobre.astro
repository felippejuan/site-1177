---
// src/pages/sobre.astro
// Trajetória Completa e Linha do Tempo — Dr. Luizinho 1177
import Layout from '../layouts/Layout.astro';
import Barra1177 from '../components/Barra1177.astro';
import { JANELAS_HISTORICAS } from '../data/trajetoria';
import { ENTREGAS } from '../data/entregas';
---

<Layout
  title="Trajetória e História — Dr. Luizinho 1177"
  description="Conheça a cronologia de realizações de Dr. Luizinho como médico, secretário municipal de Nova Iguaçu, duas vezes Secretário de Estado e Deputado Federal."
>
  <!-- Hero da Página Sobre -->
  <section class="bg-gradient-to-b from-blue-900 via-[#123F8F] to-[#0D3577] text-white py-16 sm:py-24 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center max-w-3xl">
      <span class="inline-block px-3.5 py-1 rounded-full bg-white/10 text-orange-300 text-xs font-bold uppercase tracking-wider mb-4">
        História de Dedicação ao Rio
      </span>
      <h1 class="font-display text-4xl sm:text-6xl font-black italic tracking-tight mb-6">
        A TRAJETÓRIA DO <span class="text-[#F15A29]">DR. LUIZINHO</span>
      </h1>
      <p class="font-sans text-base sm:text-lg text-blue-100 leading-relaxed">
        Mais de 15 anos transformando a saúde pública fluminense. Da linha de frente nos hospitais da Baixada até a liderança dos grandes orçamentos do SUS em Brasília.
      </p>
    </div>
  </section>

  <!-- Linha do Tempo Cronológica das 4 Janelas -->
  <section class="py-16 sm:py-24 bg-white relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-12 relative before:absolute before:inset-0 before:left-8 sm:before:left-1/2 before:-translate-x-px before:w-0.5 before:bg-slate-200">
        
        {JANELAS_HISTORICAS.map((janela, idx) => (
          <div class={`relative flex flex-col sm:flex-row gap-8 items-start ${idx % 2 === 1 ? 'sm:flex-row-reverse' : ''}`}>
            
            <!-- Marcador Circular Central -->
            <div class="absolute left-8 sm:left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-[#F15A29] text-white flex items-center justify-center font-display font-black text-sm shadow-md ring-4 ring-white z-10">
              {idx + 1}
            </div>

            <!-- Conteúdo da Janela -->
            <div class="ml-16 sm:ml-0 sm:w-1/2 p-6 sm:p-8 rounded-2xl bg-[#F8FAFC] border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
              <span class="inline-block px-2.5 py-0.5 rounded bg-blue-100 text-[#123F8F] text-xs font-bold uppercase tracking-wider mb-2">
                {janela.periodo} · {janela.codigo}
              </span>
              <h3 class="font-display text-2xl font-black italic text-[#123F8F] mb-3 leading-tight">
                {janela.cargo}
              </h3>
              <p class="font-sans text-sm text-slate-600 mb-5 leading-relaxed">
                {janela.descricao}
              </p>

              <div class="space-y-2 border-t border-slate-200 pt-4">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Principais Marcos:</h4>
                <ul class="space-y-2">
                  {janela.conquistas.map((conquista) => (
                    <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-800">
                      <span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span>
                      <span>{conquista}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

          </div>
        ))}

      </div>
    </div>
  </section>

  <!-- Todas as 16 Entregas Auditadas em Grade Temática -->
  <section class="py-16 sm:py-24 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="inline-block px-3 py-1 rounded-full bg-blue-100 text-[#123F8F] text-xs font-bold uppercase tracking-wider mb-3">
          Catálogo Completo
        </span>
        <h2 class="font-display text-3xl sm:text-5xl font-black italic tracking-tight text-[#123F8F]">
          TODAS AS ENTREGAS <span class="text-[#F15A29]">AUDITADAS</span>
        </h2>
        <p class="font-sans text-base text-slate-600 mt-2">
          Relação de hospitais, centros de diagnóstico e programas estruturados por Dr. Luizinho no Rio de Janeiro.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {ENTREGAS.map((entrega) => (
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs mb-2">
                <span class="font-bold text-[#123F8F]">{entrega.municipioPrincipal}</span>
                <span class="text-slate-400 font-semibold">{entrega.janela}</span>
              </div>
              <h3 class="font-display text-xl font-bold text-slate-900 mb-2 leading-snug">
                {entrega.nome}
              </h3>
              <p class="font-sans text-xs text-slate-600 leading-relaxed mb-4">
                {entrega.fraseOQueE}
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 text-xs font-semibold text-[#F15A29]">
              {entrega.fraseNumero}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Barra1177 />
</Layout>
