---
// src/pages/sobre.astro
// Catálogo Completo de Entregas Auditadas — Dr. Luizinho 1177 (Light Theme)
import Layout from '../layouts/Layout.astro';
import { ENTREGAS } from '../data/entregas';
---

<Layout
  title="Entregas e Realizações — Dr. Luizinho 1177"
  description="Conheça a relação documentada de hospitais, centros de diagnóstico e programas estruturados por Dr. Luizinho no Rio de Janeiro."
>
  <!-- Hero da Página -->
  <section class="bg-gradient-to-b from-[#123F8F] to-[#0D3577] text-white py-16 sm:py-24 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/15 border border-white/20 text-orange-300 text-xs font-semibold uppercase tracking-wider mb-4">
        Dossiê de Entregas
      </span>
      <h1 class="font-display text-4xl sm:text-6xl font-black italic tracking-tight mb-6">
        TODAS AS <span class="text-[#F15A29]">ENTREGAS</span>
      </h1>
      <p class="font-sans text-base sm:text-lg text-blue-100 leading-relaxed font-normal">
        Hospitais de alta complexidade, centros de diagnóstico, unidades de urgência e programas pioneiros que saíram do papel para transformar a saúde pública em todo o Rio de Janeiro.
      </p>
    </div>
  </section>

  <!-- Todas as Entregas Auditadas em Grade Temática -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-[#123F8F] text-xs font-bold uppercase tracking-wider mb-3">
          Catálogo Documentado
        </span>
        <h2 class="font-display text-3xl sm:text-5xl font-black italic tracking-tight text-[#123F8F]">
          OBRAS E PROGRAMAS <span class="text-[#F15A29]">AUDITADOS</span>
        </h2>
        <p class="font-sans text-base text-slate-600 mt-3">
          Relação de hospitais, centros de diagnóstico e programas estruturados por Dr. Luizinho no Estado do Rio de Janeiro.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {ENTREGAS.map((entrega) => (
          <div class="bg-white p-7 rounded-3xl border border-slate-200/90 shadow-lg shadow-slate-100 flex flex-col justify-between hover:border-[#F15A29]/40 hover:shadow-xl transition-all">
            <div>
              <div class="flex items-center justify-between text-xs mb-3">
                <span class="font-bold text-[#123F8F]">{entrega.municipioPrincipal}</span>
                <span class="text-orange-600 font-semibold bg-orange-50 px-2 py-0.5 rounded-full text-[11px] uppercase tracking-wide">
                  {entrega.badge || entrega.categoria}
                </span>
              </div>
              <h3 class="font-display text-2xl font-black italic text-slate-900 mb-2 leading-tight">
                {entrega.nome}
              </h3>
              <p class="font-sans text-xs text-slate-600 leading-relaxed mb-5 font-normal">
                {entrega.fraseOQueE}
              </p>
            </div>
            <div class="pt-4 border-t border-slate-100 text-xs font-semibold text-[#F15A29]">
              {entrega.fraseNumero}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
